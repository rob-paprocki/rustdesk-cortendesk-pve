 """
-Django settings for rdgen project.
+Django settings for rdgen.
 
-Generated by 'django-admin startproject' using Django 5.0.3.
+Hardened for a native (no Docker) install: every secret comes from the
+environment or from a root-provided env file, and the service refuses to
+start when a secret is missing or still set to a published default.
 
-For more information on this file, see
-https://docs.djangoproject.com/en/5.0/topics/settings/
+    RDGEN_ENV_FILE=/etc/rdgen/rdgen.env    (root:rdgen 0640, KEY=VALUE lines)
 
-For the full list of settings and their values, see
-https://docs.djangoproject.com/en/5.0/ref/settings/
+Values from the env file are kept in a private dict instead of os.environ,
+so they never show up in /proc/<pid>/environ. Real environment variables
+override the file (handy for tests).
 """
 import os
+import re
 from pathlib import Path
 
+from django.core.exceptions import ImproperlyConfigured
+
 # Build paths inside the project like this: BASE_DIR / 'subdir'.
 BASE_DIR = Path(__file__).resolve().parent.parent
 
 
-# Quick-start development settings - unsuitable for production
-# See https://docs.djangoproject.com/en/5.0/howto/deployment/checklist/
+def _load_env_file(path):
+    """Parse KEY=VALUE lines. No shell expansion, no command substitution."""
+    values = {}
+    with open(path, encoding='utf-8') as fh:
+        for raw in fh.read().splitlines():
+            line = raw.strip()
+            if not line or line.startswith('#'):
+                continue
+            if line.startswith('export '):
+                line = line[7:].lstrip()
+            key, sep, value = line.partition('=')
+            key = key.strip()
+            if not sep or not re.fullmatch(r'[A-Za-z_][A-Za-z0-9_]*', key):
+                continue
+            value = value.strip()
+            if len(value) >= 2 and value[0] == value[-1] and value[0] in '"\'':
+                value = value[1:-1]
+            values[key] = value
+    return values
+
+
+_ENV_FILE = os.environ.get('RDGEN_ENV_FILE', '')
+_FILE_ENV = _load_env_file(_ENV_FILE) if _ENV_FILE else {}
+
+
+def env(key, default=''):
+    if key in os.environ:
+        return os.environ[key]
+    return _FILE_ENV.get(key, default)
+
+
+def env_bool(key, default=False):
+    value = env(key, '')
+    if value == '':
+        return default
+    return value.strip().lower() in ('1', 'true', 't', 'yes', 'y', 'on')
+
+
+def env_int(key, default):
+    value = env(key, '')
+    if value == '':
+        return default
+    try:
+        return int(value)
+    except ValueError:
+        raise ImproperlyConfigured(f'{key} must be an integer')
+
+
+def env_list(key, default=()):
+    value = env(key, '')
+    if not value.strip():
+        return list(default)
+    return [item for item in re.split(r'[\s,]+', value.strip()) if item]
+
+
+# Values that were published in upstream's settings.py / docker-compose.yml
+# or are obvious placeholders. Starting with one of these is refused.
+_PUBLISHED_DEFAULTS = {
+    'django-insecure-!(t-!f#6g#sr%yfded9(xha)g+=!6craeez^cp+*&bz_7vdk61',
+    'insecure', 'secret', 'changeme', 'change-me', 'github_access_token',
+}
+
 
-# SECURITY WARNING: keep the secret key used in production secret!
-SECRET_KEY = os.environ.get('SECRET_KEY','django-insecure-!(t-!f#6g#sr%yfded9(xha)g+=!6craeez^cp+*&bz_7vdk61')
-GHUSER = os.environ.get("GHUSER", '')
-GHBEARER = os.environ.get("GHBEARER", '')
-GENURL = os.environ.get("GENURL", '')
-GHBRANCH = os.environ.get("GHBRANCH",'master')
-ZIP_PASSWORD = os.environ.get("ZIP_PASSWORD",'insecure')
-PROTOCOL = os.environ.get("PROTOCOL", 'https')
-REPONAME = os.environ.get("REPONAME", 'rdgen')
-SH_SECRET = os.environ.get('SH_SECRET', 'secret')
+def env_secret(key, min_len):
+    value = env(key, '')
+    if not value:
+        raise ImproperlyConfigured(
+            f'{key} is not set. Put it in the file named by RDGEN_ENV_FILE '
+            f'(normally /etc/rdgen/rdgen.env) or in the environment.')
+    if value in _PUBLISHED_DEFAULTS or value.startswith('django-insecure-'):
+        raise ImproperlyConfigured(f'{key} is set to a published default; generate a new one.')
+    if len(value) < min_len:
+        raise ImproperlyConfigured(f'{key} must be at least {min_len} characters long.')
+    return value
+
+
+# SECURITY: no fallbacks. Generate with
+#   python3 -c 'import secrets; print(secrets.token_urlsafe(64))'
+SECRET_KEY = env_secret('SECRET_KEY', 50)
+# AES password of the config zip. The same value is stored as the
+# ZIP_PASSWORD Actions secret of the build repository.
+ZIP_PASSWORD = env_secret('ZIP_PASSWORD', 32)
+
+# GitHub build repository (a PRIVATE mirror of this tree).
+GHUSER = env('GHUSER', '')
+REPONAME = env('REPONAME', '')
+GHBRANCH = env('GHBRANCH', 'master')
+# Runtime token: fine-grained PAT, this repository only, Actions RW +
+# Metadata R. Never logged, never passed on a command line.
+GHBEARER = env('GHBEARER', '')
+GITHUB_API_URL = env('RDGEN_GITHUB_API', 'https://api.github.com').rstrip('/')
+if not re.match(r'^(https://|http://(127\.0\.0\.1|localhost|\[::1\])(:\d+)?(/|$))', GITHUB_API_URL + '/'):
+    raise ImproperlyConfigured('RDGEN_GITHUB_API must be an https:// URL (plain http only for localhost stubs)')
+GITHUB_API_VERSION = env('RDGEN_GITHUB_API_VERSION', '2026-03-10')
+
+# Legacy push-model settings. Kept (empty) until the pull model replaces them.
+GENURL = ''
+PROTOCOL = 'https'
+SH_SECRET = None
+
+# Data lives outside the (root-owned, read-only) code tree.
+DATA_DIR = Path(env('RDGEN_DATA_DIR', str(BASE_DIR / 'data')))
 
 MEDIA_URL = '/media/'
 MEDIA_ROOT = os.path.join(BASE_DIR, 'media')
 
 
 # SECURITY WARNING: don't run with debug turned on in production!
-DEBUG_ENV = os.environ.get("DEBUG", "False")
-DEBUG = DEBUG_ENV.lower() in ['true', '1', 't']
-
-ALLOWED_HOSTS = ['*']
-#CSRF_TRUSTED_ORIGINS = os.getenv('CSRF_TRUSTED_ORIGINS', '').split()
+DEBUG = env_bool('DEBUG', False)
+
+ALLOWED_HOSTS = env_list('ALLOWED_HOSTS', ['127.0.0.1', 'localhost', '[::1]'])
+# Needed when the browser-facing origin differs from what reaches Django,
+# e.g. https://rdgen.lan through a TLS proxy: "https://rdgen.lan".
+CSRF_TRUSTED_ORIGINS = env_list('CSRF_TRUSTED_ORIGINS')
+
+# Optional sub-path mount (e.g. /rdgen behind the CortenDesk nginx). The
+# proxy must strip the prefix before passing the request on.
+_prefix = env('RDGEN_URL_PREFIX', '').strip().rstrip('/')
+if _prefix and not re.fullmatch(r'(/[A-Za-z0-9._~-]+)+', _prefix):
+    raise ImproperlyConfigured('RDGEN_URL_PREFIX must look like /rdgen')
+FORCE_SCRIPT_NAME = _prefix or None
+URL_PREFIX = _prefix
+
+# Behind a TLS-terminating proxy that sets X-Forwarded-Proto.
+if env_bool('RDGEN_BEHIND_TLS_PROXY', False):
+    SECURE_PROXY_SSL_HEADER = ('HTTP_X_FORWARDED_PROTO', 'https')
+
+# Cookies: own names and path so they never collide with the console's
+# cookies when both are served from the same host.
+SESSION_COOKIE_NAME = 'rdgen_sessionid'
+CSRF_COOKIE_NAME = 'rdgen_csrftoken'
+SESSION_COOKIE_PATH = (_prefix or '') + '/'
+CSRF_COOKIE_PATH = SESSION_COOKIE_PATH
+SESSION_COOKIE_HTTPONLY = True
+CSRF_COOKIE_HTTPONLY = True
+SESSION_COOKIE_SAMESITE = 'Lax'
+CSRF_COOKIE_SAMESITE = 'Lax'
+SESSION_COOKIE_AGE = env_int('RDGEN_SESSION_HOURS', 12) * 3600
+SESSION_COOKIE_SECURE = env_bool('RDGEN_SECURE_COOKIES', False)
+CSRF_COOKIE_SECURE = SESSION_COOKIE_SECURE
+X_FRAME_OPTIONS = 'DENY'
+SECURE_CONTENT_TYPE_NOSNIFF = True
+SECURE_REFERRER_POLICY = 'same-origin'
 
 # Application definition
 
@@ -90,15 +214,8 @@ WSGI_APPLICATION = 'rdgen.wsgi.application'
 DATABASES = {
     'default': {
         'ENGINE': 'django.db.backends.sqlite3',
-        'NAME': BASE_DIR / 'db.sqlite3',
-        'OPTIONS': {
-            # WAL mode allows concurrent readers plus one writer without
-            # blocking readers, which is important when multiple GitHub
-            # Action runners hit save_custom_client / updategh at once.
-            # busy_timeout makes writers wait instead of failing immediately
-            # when the DB file is briefly locked.
-            'init_command': "PRAGMA journal_mode=WAL; PRAGMA busy_timeout=30000; PRAGMA synchronous=NORMAL;",
-        },
+        'NAME': DATA_DIR / 'db.sqlite3',
+        'OPTIONS': {'timeout': 20},
     }
 }
 
@@ -112,6 +229,7 @@ AUTH_PASSWORD_VALIDATORS = [
     },
     {
         'NAME': 'django.contrib.auth.password_validation.MinimumLengthValidator',
+        'OPTIONS': {'min_length': 12},
     },
     {
         'NAME': 'django.contrib.auth.password_validation.CommonPasswordValidator',
@@ -144,4 +262,23 @@ STATIC_URL = 'static/'
 
 DEFAULT_AUTO_FIELD = 'django.db.models.BigAutoField'
 
