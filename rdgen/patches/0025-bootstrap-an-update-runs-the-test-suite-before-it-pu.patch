From 025508672c9408fa2979647a5839375825fab88f Mon Sep 17 00:00:00 2001
From: Rob Paprocki <hi@rpaprocki.com>
Date: Sun, 18 Oct 2026 16:17:48 -0400
Subject: [PATCH 25/28] bootstrap: an update runs the test suite before it
 pushes

verify_tree (init and the daily update) ran compileall, pullify --check,
manage.py check and the migrations check. Upstream's update_public_key
(2026-10-17) showed that a clean git am can still break every build:
the server sent a config key the runner refuses. Had upstream added it in
a commit the patches still applied to, the daily update would have pushed
and deployed that tree.

- verify_tree also runs `manage.py test rdgenerator.tests` (about a
  minute) with throwaway secrets; a failure keeps the current version
  ("update NOT applied") and names the failing tests.
- The suite itself runs with RDGEN_VERIFY_TESTS=0: test_bootstrap calls
  init, whose verify_tree must not start the suite again.
---
 rdgenerator/tests/test_bootstrap.py | 35 +++++++++++++++++++++++++++++
 tools/rdgen-github-bootstrap        | 19 ++++++++++++----
 2 files changed, 50 insertions(+), 4 deletions(-)

diff --git a/rdgenerator/tests/test_bootstrap.py b/rdgenerator/tests/test_bootstrap.py
index c8d4c9b..42fce3f 100644
--- a/rdgenerator/tests/test_bootstrap.py
+++ b/rdgenerator/tests/test_bootstrap.py
@@ -176,3 +176,38 @@ class InitTests(SimpleTestCase):
         code, err = self.init('--runtime-token-stdin', stdin=RUNTIME + '\n')
         self.assertEqual(code, 4, err)
         self.assertIn('lacks generator-macos.yml', err)
+
+
+class VerifyTreeTests(SimpleTestCase):
+    """The update gate runs the test suite (a clean git am is not enough), but not inside its own test run."""
+
+    def commands(self, env):
+        seen = []
+
+        def fake_run(cmd, *args, **kwargs):
+            seen.append((cmd, kwargs.get('env') or {}))
+            return subprocess.CompletedProcess(cmd, 0, '', '')
+        with mock.patch.dict(os.environ, env), mock.patch.object(boot.subprocess, 'run', fake_run):
+            boot.verify_tree('/nonexistent', 'python3')
+        return seen
+
+    def test_suite_runs_and_cannot_recurse(self):
+        seen = self.commands({'RDGEN_VERIFY_TESTS': '1'})
+        tests = [(cmd, env) for cmd, env in seen if cmd[1:3] == ['manage.py', 'test']]
+        self.assertEqual(len(tests), 1)
+        self.assertEqual(tests[0][1]['RDGEN_VERIFY_TESTS'], '0')
+
+    def test_nested_run_skips_the_suite(self):
+        seen = self.commands({'RDGEN_VERIFY_TESTS': '0'})
+        self.assertFalse([cmd for cmd, _ in seen if cmd[1:3] == ['manage.py', 'test']])
+
+    def test_failing_tests_are_named(self):
+        def fake_run(cmd, *args, **kwargs):
+            if cmd[1:3] == ['manage.py', 'test']:
+                return subprocess.CompletedProcess(cmd, 1, '', 'FAIL: test_x (a.B.test_x)\nTraceback ...\nFAILED (failures=1)\n')
+            return subprocess.CompletedProcess(cmd, 0, '', '')
+        with mock.patch.dict(os.environ, {'RDGEN_VERIFY_TESTS': '1'}), mock.patch.object(boot.subprocess, 'run', fake_run):
+            with self.assertRaises(boot.Fail) as cm:
+                boot.verify_tree('/nonexistent', 'python3')
+        self.assertIn('FAIL: test_x', str(cm.exception))
+        self.assertNotIn('Traceback', str(cm.exception))
diff --git a/tools/rdgen-github-bootstrap b/tools/rdgen-github-bootstrap
index 4c5ee98..0b0a21a 100755
--- a/tools/rdgen-github-bootstrap
+++ b/tools/rdgen-github-bootstrap
@@ -489,14 +489,25 @@ def verify_tree(src, python):
     probe = subprocess.run([python, '-c', 'import django'], capture_output=True)
     if probe.returncode == 0:
         tmp = tempfile.mkdtemp(prefix='rdgen-verify-')
+        # RDGEN_VERIFY_TESTS=0 inside the test run: test_bootstrap calls init, which verifies its own tree
         env = dict(os.environ, SECRET_KEY=secrets.token_urlsafe(64), ZIP_PASSWORD=secrets.token_hex(40),
-                   RDGEN_DATA_DIR=tmp, RDGEN_ENV_FILE='', PYTHONDONTWRITEBYTECODE='1')
+                   RDGEN_DATA_DIR=tmp, RDGEN_ENV_FILE='', PYTHONDONTWRITEBYTECODE='1', RDGEN_VERIFY_TESTS='0')
+        cmds = [[python, 'manage.py', 'check'],
+                [python, 'manage.py', 'makemigrations', '--check', '--dry-run']]
+        if os.environ.get('RDGEN_VERIFY_TESTS', '1') != '0':
+            # a clean git am is not enough: the suite also runs the dispatched config through the runner's check
+            cmds.append([python, 'manage.py', 'test', 'rdgenerator.tests', '--noinput'])
         try:
-            for cmd in ([python, 'manage.py', 'check'],
-                        [python, 'manage.py', 'makemigrations', '--check', '--dry-run']):
+            for cmd in cmds:
                 r = subprocess.run(cmd, cwd=src, env=env, text=True, capture_output=True)
                 if r.returncode != 0:
-                    raise Fail(f'check failed ({" ".join(cmd[2:])}): {(r.stdout + r.stderr).strip()[-500:]}', 4)
+                    out = (r.stdout + r.stderr).strip()
+                    if cmd[2] == 'test':   # the failing tests' names (from the first), not just the summary line
+                        names = [ln for ln in out.splitlines() if ln.startswith(('FAIL:', 'ERROR:', 'FAILED'))]
+                        out = '\n'.join(names)[:700] if names else out[-500:]
+                    else:
+                        out = out[-500:]
+                    raise Fail(f'check failed ({" ".join(cmd[2:4])}): {out}', 4)
         finally:
             shutil.rmtree(tmp, ignore_errors=True)
 
