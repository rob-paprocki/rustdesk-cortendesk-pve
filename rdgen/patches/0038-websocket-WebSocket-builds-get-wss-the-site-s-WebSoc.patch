diff --git a/rdgenerator/tests/test_websocket.py b/rdgenerator/tests/test_websocket.py
new file mode 100644
index 0000000..b5bba26
--- /dev/null
+++ b/rdgenerator/tests/test_websocket.py
@@ -0,0 +1,304 @@
+"""WebSocket builds: their API server, and a site whose server has two names (rdgenerator/websocket.py).
+
+rd.example.com forwards the raw ports (RDGEN_DEFAULT_SERVER); console.example.com bridges only /ws/id and /ws/relay
+(RDGEN_DEFAULT_WS_SERVER). A client with allow-websocket=Y must use the second, every other client the first.
+A WebSocket client uses wss:// only with an https api-server option.
+"""
+import base64
+import json
+import os
+import subprocess
+import sys
+
+from django.conf import settings
+from django.contrib.auth import get_user_model
+from django.test import Client, TestCase, override_settings
+
+from rdgen import settings as rdgen_settings
+from rdgenerator import views, websocket
+from rdgenerator.tests.test_pull import StubTestCase, decrypt_cfg
+from rdgenerator.tests.test_workflows import load_validate
+
+RAW, WS = 'rd.example.com', 'console.example.com'
+API = 'https://console.example.com'
+WS_ON = 'allow-websocket=Y'
+
+
+def two_names(**over):
+    # like CortenDesk's: the API server is the console URL
+    return override_settings(RDGEN_DEFAULTS=dict(rdgen_settings.RDGEN_DEFAULTS,
+                                                 **dict({'server': RAW, 'ws_server': WS, 'api_server': API}, **over)))
+
+
+class SiteNamesTests(TestCase):
+    def test_read_from_the_env(self):
+        env = {k: v for k, v in os.environ.items() if k not in ('RDGEN_ENV_FILE',)}
+        env.update(SECRET_KEY='s' * 60, ZIP_PASSWORD='z' * 40, DJANGO_SETTINGS_MODULE='rdgen.settings',
+                   RDGEN_DEFAULT_SERVER=RAW, RDGEN_DEFAULT_WS_SERVER=WS)
+        code = ('import django; django.setup(); from django.conf import settings; '
+                'print(settings.RDGEN_DEFAULTS["server"], settings.RDGEN_DEFAULTS["ws_server"])')
+        r = subprocess.run([sys.executable, '-c', code], cwd=settings.BASE_DIR, env=env, capture_output=True, text=True)
+        self.assertEqual(r.stdout.split(), [RAW, WS], r.stderr)
+
+    def test_off_unless_a_valid_different_name(self):
+        with two_names():
+            self.assertEqual(websocket.site_names(), (RAW, WS))
+        for ws in ('', RAW, RAW.upper(), 'console.example.com; id', 'https://console.example.com'):
+            with two_names(ws_server=ws):
+                self.assertEqual(websocket.site_names(), (RAW, ''), ws)
+
+    def test_websocket_section_follows_rustdesks_order(self):
+        sec = websocket.websocket_section
+        self.assertEqual(sec({'default-settings': {'allow-websocket': 'Y'}}), 'default-settings')
+        self.assertEqual(sec({'override-settings': {'allow-websocket': 'Y'}, 'default-settings': {}}), 'override-settings')
+        # override-settings wins over default-settings, and only "Y" turns an allow-* option on
+        self.assertEqual(sec({'override-settings': {'allow-websocket': 'N'},
+                              'default-settings': {'allow-websocket': 'Y'}}), '')
+        self.assertEqual(sec({'default-settings': {'allow-websocket': 'y'}}), '')
+        self.assertEqual(websocket.manual_settings(' allow-websocket = Y \nfoo\nallow-websocket=N=x'),
+                         {'allow-websocket': 'N=x'})
+        for value, host in (('rd.example.com', RAW), ('rd.example.com:21117', RAW), ('wss://rd.example.com/ws/relay', RAW),
+                            ('[2001:db8::1]:21117', '[2001:db8::1]'), ('2001:db8::1', '2001:db8::1')):
+            self.assertEqual(websocket.host_of(value), host, value)
+
+
+class WebSocketBuildTests(StubTestCase):
+    def setUp(self):
+        super().setUp()
+        self.names = two_names()
+        self.names.enable()
+
+    def tearDown(self):
+        self.names.disable()
+        super().tearDown()
+
+    def secrets(self, **body):
+        r = self.generate(**body)
+        self.assertEqual(r.status_code, 200, r.content)
+        req = [x for x in self.stub.requests if x['path'].endswith('/dispatches')][-1]
+        s = json.loads(decrypt_cfg(req['body']['inputs']['cfg'])['secrets.json'])
+        return s, json.loads(base64.b64decode(s['custom']))
+
+    def refused(self, field, **body):
+        before = len([x for x in self.stub.requests if x['path'].endswith('/dispatches')])
+        r = self.generate(**body)
+        self.assertEqual(r.status_code, 400, r.content)
+        self.assertEqual(len([x for x in self.stub.requests if x['path'].endswith('/dispatches')]), before)
+        return r.json()['details'][field]
+
+    def test_empty_host_means_the_websocket_name(self):
+        s, custom = self.secrets(defaultManual=WS_ON)
+        self.assertEqual(s['server'], WS)
+        # hbbs names the raw relay: the build relays through its Host, set in the map that turns WebSocket on
+        self.assertEqual(custom['default-settings']['relay-server'], WS)
+        self.assertNotIn('relay-server', custom['override-settings'])
+        s, custom = self.secrets(overrideManual='enable-audio=Y\n' + WS_ON)
+        self.assertEqual(s['server'], WS)
+        self.assertEqual(custom['override-settings']['relay-server'], WS)
+        self.assertNotIn('relay-server', custom['default-settings'])
+
+    def test_websocket_build_with_another_name_relays_through_it(self):
+        s, custom = self.secrets(serverIP='ws.example.org', overrideManual=WS_ON)
+        self.assertEqual((s['server'], custom['override-settings']['relay-server']), ('ws.example.org', 'ws.example.org'))
+        # a relay-server the build sets itself stays, in either map
+        s, custom = self.secrets(defaultManual='relay-server=relay.example.org', overrideManual=WS_ON)
+        self.assertEqual(custom['default-settings']['relay-server'], 'relay.example.org')
+        self.assertNotIn('relay-server', custom['override-settings'])
+        # an empty one means "the relay hbbs names": replaced
+        s, custom = self.secrets(defaultManual=WS_ON, overrideManual='relay-server=')
+        self.assertEqual(custom['default-settings']['relay-server'], WS)
+        self.assertNotIn('relay-server', custom['override-settings'])
+
+    def test_websocket_build_with_the_raw_name_is_refused(self):
+        for host in (RAW, RAW.upper()):
+            for box in ('defaultManual', 'overrideManual'):
+                msg = self.refused('serverIP', serverIP=host, **{box: WS_ON})
+                self.assertIn(f'WebSocket clients (allow-websocket=Y under Other) reach the server only through {WS}', msg)
+                self.assertIn(f'Use {WS} as Host', msg)
+
+    def test_the_build_itself_checks_too(self):
+        # generate_custom_client, behind the form and the API, refuses the same builds
+        r = views.generate_custom_client({'serverIP': RAW, 'defaultManual': WS_ON})
+        self.assertEqual((r['success'], r['status_code']), (False, 400))
+        self.assertIn(f'only through {WS}', r['error'])
+        self.assertFalse([x for x in self.stub.requests if x['path'].endswith('/dispatches')])
+
+    def test_websocket_build_with_a_raw_server_option_is_refused(self):
+        for opt in ('relay-server=rd.example.com', 'relay-server=rd.example.com:21117',
+                    'custom-rendezvous-server=rd.example.com'):
+            msg = self.refused('overrideManual', serverIP=WS, overrideManual=f'{WS_ON}\n{opt}')
+            self.assertIn(f'reach the server only through {WS}', msg)
+            self.assertIn(f'Set it to {WS} or remove the line', msg)
+            msg = self.refused('defaultManual', defaultManual=opt, overrideManual=WS_ON)
+            self.assertIn(opt, msg)
+
+    def test_normal_build_with_the_websocket_name_is_refused(self):
+        for body in ({'serverIP': WS}, {'serverIP': WS.upper(), 'defaultManual': 'allow-websocket=N'},
+                     # override-settings wins: this client does not use WebSocket
+                     {'serverIP': WS, 'defaultManual': WS_ON, 'overrideManual': 'allow-websocket=N'}):
+            msg = self.refused('serverIP', **body)
+            self.assertIn(f'{WS} reaches the server only over WebSocket', msg)
+            self.assertIn(f'Use {RAW} as Host', msg)
+        msg = self.refused('defaultManual', defaultManual=f'relay-server={WS}')
+        self.assertIn(f'Set it to {RAW} or remove the line', msg)
+
+    def test_normal_builds_keep_the_raw_name(self):
+        for body in ({}, {'serverIP': RAW}, {'overrideManual': 'allow-websocket=N'}):
+            s, custom = self.secrets(**body)
+            self.assertEqual(s['server'], RAW, body)
+            self.assertFalse({'relay-server'} & (set(custom['default-settings']) | set(custom['override-settings'])))
+
+    def test_websocket_config_passes_the_runner_check(self):
+        v = load_validate()
+        for body in ({'defaultManual': WS_ON}, {'overrideManual': WS_ON, 'platform': 'linux', 'appname': 'acme-rescue'},
+                     {'serverIP': WS, 'overrideManual': WS_ON, 'direction': 'incoming', 'platform': 'macos'}):
+            s, custom = self.secrets(**body)
+            self.assertEqual(v.validate_secrets(s), [], body)
+        self.assertEqual(custom['override-settings']['custom-rendezvous-server'], WS)
+
+    def test_the_form_says_which_name_to_use(self):
+        self.c.force_login(get_user_model().objects.create_user('tester', password='x' * 16))
+        page = self.c.get('/').content.decode()
+        self.assertRegex(page, r'name="serverIP"[^>]*value="rd\.example\.com"')
+        self.assertIn('<div class="rd-hint" id="rd-ws-names">This server has two names. Normal clients use '
+                      f'<b>{RAW}</b>. WebSocket clients (allow-websocket=Y under Other) reach it only through <b>{WS}</b>', page)
+        # the pre-filled Host with allow-websocket=Y: the Host field says which name to use
+        form = {'platform': 'linux', 'version': '1.5.3', 'exename': 'acme', 'serverIP': RAW, 'defaultManual': WS_ON,
+                'direction': 'both', 'installation': 'installationY', 'settings': 'settingsY', 'theme': 'system',
+                'themeDorO': 'default', 'passApproveMode': 'password-click', 'permissionsType': 'custom'}
+        r = self.c.post('/', form)
+        self.assertEqual(r.status_code, 200)
+        self.assertEqual(r.context['form'].errors['serverIP'],
+                         [f'WebSocket clients (allow-websocket=Y under Other) reach the server only through {WS}, '
+                          f'not {RAW}, which is for normal clients. Use {WS} as Host, or leave Host empty.'])
+        self.assertFalse([x for x in self.stub.requests if x['path'].endswith('/dispatches')])
+        r = self.c.post('/', dict(form, serverIP=''))
+        self.assertTemplateUsed(r, 'waiting.html')
+        r = self.c.post('/', dict(form, defaultManual=''))
+        self.assertTemplateUsed(r, 'waiting.html')
+        r = self.c.post('/', dict(form, defaultManual='', serverIP=WS))
+        self.assertIn('reaches the server only over WebSocket', r.context['form'].errors['serverIP'][0])
+
+
+class OneNameTests(StubTestCase):
+    """Without a separate WebSocket name the name rules are off: Host and relay as before, for WebSocket builds too
+    (their api-server option: ApiServerTests)."""
+
+    def secrets(self, **body):
+        r = self.generate(**body)
+        self.assertEqual(r.status_code, 200, r.content)
+        req = [x for x in self.stub.requests if x['path'].endswith('/dispatches')][-1]
+        s = json.loads(decrypt_cfg(req['body']['inputs']['cfg'])['secrets.json'])
+        return s, json.loads(base64.b64decode(s['custom']))
+
+    def test_unset_same_or_invalid_websocket_name(self):
+        for ws in ('', RAW, 'console.example.com/ws'):
+            with two_names(ws_server=ws):
+                for body, server in (({'defaultManual': WS_ON}, RAW), ({'serverIP': RAW, 'overrideManual': WS_ON}, RAW),
+                                     ({'serverIP': WS}, WS), ({'serverIP': WS, 'defaultManual': WS_ON}, WS)):
+                    s, custom = self.secrets(**body)
+                    self.assertEqual(s['server'], server, (ws, body))
+                    self.assertFalse({'relay-server'} & (set(custom['default-settings']) |
+                                                         set(custom['override-settings'])), (ws, body))
+        # no server defaults at all: RustDesk's public server, as upstream
+        with two_names(server='', ws_server=''):
+            s, _ = self.secrets(defaultManual=WS_ON)
+        self.assertEqual(s['server'], 'rs-ny.rustdesk.com')
+
+    def test_no_hint_without_a_websocket_name(self):
+        c = Client()
+        c.force_login(get_user_model().objects.create_user('tester', password='x' * 16))
+        with two_names(ws_server=''):
+            self.assertNotIn('rd-ws-names', c.get('/').content.decode())
+
+
+class ApiServerTests(StubTestCase):
+    """hbb_common check_ws uses wss:// only when the api-server OPTION starts with https; rdgen sets that option
+    itself only for Incoming Only builds. These rules hold for every WebSocket build, two names or one."""
+
+    def setUp(self):
+        super().setUp()
+        self.names = two_names(ws_server='')   # one name: only the API rules apply
+        self.names.enable()
+
+    def tearDown(self):
+        self.names.disable()
+        super().tearDown()
+
+    def custom(self, **body):
+        r = self.generate(**body)
+        self.assertEqual(r.status_code, 200, r.content)
+        req = [x for x in self.stub.requests if x['path'].endswith('/dispatches')][-1]
+        s = json.loads(decrypt_cfg(req['body']['inputs']['cfg'])['secrets.json'])
+        self.assertEqual(load_validate().validate_secrets(s), [], body)   # still passes the runner's check
+        return json.loads(base64.b64decode(s['custom']))
+
+    def refused(self, field, **body):
+        r = self.generate(**body)
+        self.assertEqual(r.status_code, 400, r.content)
+        self.assertFalse([x for x in self.stub.requests if x['path'].endswith('/dispatches')])
+        return r.json()['details'][field]
+
+    def test_websocket_build_gets_an_https_api_server_option(self):
+        custom = self.custom(defaultManual=WS_ON)
+        self.assertEqual(custom['default-settings']['api-server'], API)
+        self.assertNotIn('api-server', custom['override-settings'])
+        custom = self.custom(serverIP=RAW, apiServer='https://console.example.com/sub', overrideManual=WS_ON)
+        self.assertEqual(custom['override-settings']['api-server'], 'https://console.example.com/sub')
+        self.assertNotIn('api-server', custom['default-settings'])
+        # one name: no relay-server pin
+        self.assertNotIn('relay-server', custom['override-settings'])
+
+    def test_incoming_only_keeps_its_own_and_one_set_by_hand_stays(self):
+        custom = self.custom(direction='incoming', defaultManual=WS_ON)
+        self.assertEqual(custom['override-settings']['api-server'], API)
+        self.assertNotIn('api-server', custom['default-settings'])
+        custom = self.custom(defaultManual=f'{WS_ON}\napi-server=https://api.example.org')
+        self.assertEqual(custom['default-settings']['api-server'], 'https://api.example.org')
+        self.assertNotIn('api-server', custom['override-settings'])
+        # empty means "the client's default", and in override-settings it would hide the pinned one
+        custom = self.custom(defaultManual=WS_ON, overrideManual='api-server=')
+        self.assertEqual(custom['default-settings']['api-server'], API)
+        self.assertNotIn('api-server', custom['override-settings'])
+
+    def test_websocket_build_without_https_is_refused(self):
+        for body in ({'apiServer': 'http://console.example.com'}, {'apiServer': 'console.example.com'},
+                     {'direction': 'incoming', 'apiServer': 'http://console.example.com'}):
+            msg = self.refused('apiServer', defaultManual=WS_ON, **body)
+            self.assertIn('connect with wss:// only when their API server starts with https://', msg)
+            self.assertIn(f'ws://{RAW}/ws/id', msg)
+            self.assertIn('as API server', msg)
+        with two_names(ws_server='', api_server=''):   # no API server anywhere: rdgen would use <host>:21114
+            msg = self.refused('apiServer', overrideManual=WS_ON)
+            self.assertIn(f'ws://{RAW}/ws/id', msg)
+        msg = self.refused('overrideManual', overrideManual=f'{WS_ON}\napi-server=http://console.example.com')
+        self.assertTrue(msg.startswith('api-server=http://console.example.com: WebSocket clients'), msg)
+        self.assertIn('or remove the line', msg)
+        msg = self.refused('defaultManual', defaultManual=f'{WS_ON}\napi-server=http://console.example.com')
+        self.assertIn('or remove the line', msg)
+
+    def test_the_form_refuses_it_on_the_api_field(self):
+        self.c.force_login(get_user_model().objects.create_user('tester', password='x' * 16))
+        r = self.c.post('/', {'platform': 'macos', 'version': '1.5.3', 'exename': 'acme', 'serverIP': WS,
+                              'apiServer': 'http://console.example.com', 'overrideManual': WS_ON,
+                              'direction': 'both', 'installation': 'installationY', 'settings': 'settingsY',
+                              'theme': 'system', 'themeDorO': 'default', 'passApproveMode': 'password-click',
+                              'permissionsType': 'custom'})
+        self.assertIn('never registers', r.context['form'].errors['apiServer'][0])
+        self.assertFalse([x for x in self.stub.requests if x['path'].endswith('/dispatches')])
+
+    def test_direct_and_normal_builds_are_left_alone(self):
+        # an IP is reached as ws://<ip>:21118, a LAN name without a proxy: plain http is fine there, no option
+        for host in ('192.0.2.10', 'rustdesk', 'rustdesk.lan', 'rd.home.arpa'):
+            custom = self.custom(serverIP=host, apiServer='http://192.0.2.10:8080', defaultManual=WS_ON)
+            self.assertNotIn('api-server', custom['default-settings'], host)
+        # normal builds: no option, and http:// stays allowed as before
+        for body in ({}, {'apiServer': 'http://console.example.com'}, {'overrideManual': 'allow-websocket=N'}):
+            custom = self.custom(**body)
+            self.assertFalse({'api-server'} & (set(custom['default-settings']) | set(custom['override-settings'])))
+
+    def test_two_name_site_pins_both(self):
+        with two_names():
+            custom = self.custom(overrideManual=WS_ON)
+        self.assertEqual((custom['override-settings']['api-server'], custom['override-settings']['relay-server']),
+                         (API, WS))
