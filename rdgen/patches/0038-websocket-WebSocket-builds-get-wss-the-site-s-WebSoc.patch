index 0000000..aec571b
--- /dev/null
+++ b/rdgenerator/websocket.py
@@ -0,0 +1,172 @@
+"""WebSocket builds: their API server, and a site whose server has two names.
+
+A client with allow-websocket=Y (an option under Other) reaches hbbs and hbbr as wss://<host>/ws/id and
+wss://<host>/ws/relay, so its host must be the name whose web server bridges those paths (a console behind a
+tunnel, for example), while a normal client needs the name that forwards the raw ports (21116/21117). The site
+names the first RDGEN_DEFAULT_WS_SERVER and the second RDGEN_DEFAULT_SERVER. A client's own relay-server option
+wins over the relay hbbs names, which is the raw name, so a WebSocket build relays through its Host unless it sets
+relay-server itself. A WebSocket client and a normal one can't connect to each other. These name rules are off
+while RDGEN_DEFAULT_WS_SERVER is unset, invalid or the same name as RDGEN_DEFAULT_SERVER.
+
+The client picks wss:// only when its api-server OPTION starts with https (hbb_common check_ws reads the option,
+not the API server built into the client), and generate_custom_client sets that option only for Incoming Only
+builds. With ws:// a tunnel or an https-only proxy answers with a redirect the client can't follow, so it never
+registers. So every WebSocket build with an https:// API server gets api-server=<it> unless it sets one, and one
+whose API server is not https:// is refused when its Host is a public name (one that goes through a web server).
+"""
+import re
+
+from django.conf import settings as _settings
+
+from .validation import RULES
+
+SECTIONS = ('default-settings', 'override-settings')
+FIELDS = {'default-settings': 'defaultManual', 'override-settings': 'overrideManual'}
+# options that take the place of Host (the ID server) and of the relay hbbs names
+SERVER_OPTIONS = ('custom-rendezvous-server', 'relay-server')
+_IPV4 = re.compile(r'[0-9]{1,3}(?:\.[0-9]{1,3}){3}')
+# the form's http:// API warning (_api_server.html) treats the same names as reached directly, without a proxy
+_LAN = re.compile(r'localhost|[^.]+|.+\.(?:lan|local|home\.arpa|internal|localdomain)', re.I)
+
+
+def same_host(a, b):
+    return bool(a) and a.lower() == (b or '').lower()
+
+
+def host_of(value):
+    """The host of an option value such as host, host:port or wss://host/ws/relay."""
+    value = (value or '').strip().split('://', 1)[-1].split('/', 1)[0]
+    if value.startswith('['):
+        return value[:value.find(']') + 1] if ']' in value else value
+    return value.split(':', 1)[0] if value.count(':') == 1 else value
+
+
+def public_name(host):
+    """A name a WebSocket client reaches through a web server (wss://<name>/ws/id): not an IP address (ws://<ip>:21118,
+    straight to hbbs) and not a LAN-only name."""
+    return bool(host) and not host.startswith('[') and not _IPV4.fullmatch(host) and not _LAN.fullmatch(host)
+
+
+def site_names():
+    """(raw, ws): the site's default Host and its WebSocket name, invalid values dropped like the other site
+    defaults. ws is '' when the name rules are off."""
+    rx = RULES['serverIP'][0]
+    raw, ws = (v if isinstance(v, str) and rx.fullmatch(v) else ''
+               for v in (_settings.RDGEN_DEFAULTS.get('server', ''), _settings.RDGEN_DEFAULTS.get('ws_server', '')))
+    return raw, ('' if same_host(ws, raw) else ws)
+
+
+def manual_settings(text):
+    """The options an Other box puts into its settings map, as generate_custom_client's apply_manual_settings
+    reads them: the key is the text before the first '=', both sides stripped, and the last line wins."""
+    out = {}
+    for line in text.splitlines() if isinstance(text, str) else ():
+        key, sep, value = line.partition('=')
+        if sep:
+            out[key.strip()] = value.strip()
+    return out
+
+
+def websocket_section(maps):
+    """The settings map whose allow-websocket=Y makes the client use WebSocket, or ''. maps: {section: options}.
+    RustDesk reads override-settings first and default-settings last, and an allow-* option is on only as "Y"."""
+    override, default = maps.get('override-settings') or {}, maps.get('default-settings') or {}
+    if 'allow-websocket' in override:
+        return 'override-settings' if override['allow-websocket'] == 'Y' else ''
+    return 'default-settings' if default.get('allow-websocket') == 'Y' else ''
+
+
+def _boxes(data):
+    return {s: manual_settings(data.get(FIELDS[s])) for s in SECTIONS}
+
+
+def _build_servers(data):
+    """(Host, API server) as generate_custom_client fills them in."""
+    host = (data.get('serverIP') or '').strip() or default_host(data) or site_names()[0] or 'rs-ny.rustdesk.com'
+    api = (data.get('apiServer') or '').strip()
+    if not api:
+        api = _settings.RDGEN_DEFAULTS.get('api_server', '')
+        if not (isinstance(api, str) and api and RULES['apiServer'][0].fullmatch(api)):
+            api = host + ':21114'
+    return host, api
+
+
+def _api_option(data, boxes, api):
+    """(field, value): the client's api-server option and the form field it comes from."""
+    if boxes['override-settings'].get('api-server'):
+        return FIELDS['override-settings'], boxes['override-settings']['api-server']
+    if data.get('direction') != 'incoming' and boxes['default-settings'].get('api-server'):
+        return FIELDS['default-settings'], boxes['default-settings']['api-server']
+    # Incoming Only: generate_custom_client writes the API server into override-settings; otherwise pin_options does
+    # when it is https
+    return 'apiServer', api
+
+
+def problems(data):
+    """{field: message} for a Host, API server or server option a WebSocket or normal build cannot reach the server
+    through (form field names: serverIP, apiServer, defaultManual, overrideManual)."""
+    boxes = _boxes(data)
+    errors = {}
+    if websocket_section(boxes):
+        host, api = _build_servers(data)
+        field, value = _api_option(data, boxes, api)
+        if not value.startswith('https://') and public_name(host):
+            line = f'api-server={value[:80]}: ' if field != 'apiServer' else ''
+            errors[field] = (f'{line}WebSocket clients (allow-websocket=Y under Other) connect with wss:// only when '
+                             f'their API server starts with https://. This one would use ws://{host}/ws/id, which a '
+                             'tunnel or an https-only proxy answers with a redirect the client cannot follow, so it '
+                             'never registers. Use the console\'s https:// URL'
+                             + (' or remove the line.' if line else ' as API server.'))
+    raw, ws = site_names()
+    if not ws:
+        return errors
+    host = (data.get('serverIP') or '').strip()
+    if websocket_section(boxes):
+        wrong, right = raw, ws
+        why = (f'WebSocket clients (allow-websocket=Y under Other) reach the server only through {ws}, '
+               f'not {raw}, which is for normal clients.')
+        if same_host(host, raw):
+            errors['serverIP'] = f'{why} Use {ws} as Host, or leave Host empty.'
+    else:
+        wrong, right = ws, raw or "the ID server's own name"
+        why = (f'{ws} reaches the server only over WebSocket, so a normal client (TCP/UDP, no allow-websocket=Y '
+               'under Other) cannot connect through it.')
+        if same_host(host, ws):
+            errors['serverIP'] = (f'{why} Use {right} as Host, or add allow-websocket=Y under Other to build a '
+                                  'WebSocket client.')
+    for section, options in boxes.items():
+        for key in SERVER_OPTIONS:
+            if same_host(host_of(options.get(key)), wrong):
+                errors.setdefault(FIELDS[section], f'{key}={options[key][:80]}: {why} Set it to {right} or remove the line.')
+    return errors
+
+
+def default_host(data):
+    """The Host a build with an empty Host field gets here: the WebSocket name for a WebSocket build, else ''
+    (the usual defaults)."""
+    ws = site_names()[1]
+    return ws if ws and websocket_section(_boxes(data)) else ''
+
+
+def _pin(custom, key, value):
+    """Put key=value into the map that turns WebSocket on, unless either map sets the key. An empty value counts as
+    unset: it means the client's default, and in override-settings it would hide ours."""
+    maps = {s: custom.get(s) for s in SECTIONS}
+    if not all(isinstance(m, dict) for m in maps.values()):
+        return
+    section = websocket_section(maps)
+    if not section or any(m.get(key) for m in maps.values()):
+        return
+    for m in maps.values():
+        m.pop(key, None)
+    maps[section][key] = value
+
+
+def pin_options(custom, host, api):
+    """A WebSocket build's own options: api-server=<API server> when it is https (wss:// instead of ws://; an
+    Incoming Only build has it in override-settings already) and, on a two-name site, relay-server=<Host> (else
+    it relays through the raw name hbbs sends)."""
+    if api.startswith('https://'):
+        _pin(custom, 'api-server', api)
+    if site_names()[1]:
+        _pin(custom, 'relay-server', host)
