+    'r0adkll/sign-android-release@v1': ('349ebdef58775b1e0d8099458af0816dc79b6407', 'v1'),
+    'rustdesk-org/arch-makepkg-action@master': ('04200739ed1d0bf6f2188b6736b26a767c57a7f9', 'master @ 2026-09-30'),
+    'subosito/flutter-action@v2': ('1a449444c387b1966244ae4d4f8c696479add0b2', 'v2'),
+    'subosito/flutter-action@v2.12.0': ('2783a3f08e1baf891508463f8c6653c258246225', 'v2.12.0'),
+    'Swatinem/rust-cache@v2': ('6323deb102c322ba6fcbdcafc7e3dddab59af2b6', 'v2'),
+}
+UPLOAD_ACTION = 'actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4'
+
+NEW_INPUTS = """{i}cfg:
+{i}  description: 'rdgen pull model: base64 of the AES-encrypted config zip'
+{i}  required: true
+{i}  type: string
+{i}build_uuid:
