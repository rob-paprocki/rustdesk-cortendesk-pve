+  actions: write
+
+"""
+
+FORBIDDEN = [
+    ('get_png', 'image download from rdgen'),
+    ('save_custom_client', 'build upload to rdgen/api server'),
+    ('cleanzip', 'cleanup callback'),
+    ('updategh', 'status callback'),
+    ('STATUS_URL', 'status callback'),
