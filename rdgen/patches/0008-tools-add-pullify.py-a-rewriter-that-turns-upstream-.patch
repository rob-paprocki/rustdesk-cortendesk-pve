+#!/usr/bin/env python3
+"""Rewrite upstream rdgen generator workflows for the pull model.
+
+Usage:  python3 tools/pullify.py [--check] [REPO_ROOT]
+
+Idempotent, text-based (keeps upstream formatting and comments, so the
+result stays diffable against upstream). Run it again after merging a new
+upstream master; with --check it only reports whether anything would
+change. It exits non-zero when a post-condition fails (for example a new
+upstream step still calls back to rdgen, or an action this script has no
+pin for), so an automatic update can stop and keep the last good tree.
+
+What it does, per generator-*.yml (plus the reusable workflows it calls):
+  * workflow_dispatch inputs: zip_url -> cfg, build_uuid, proto
+  * run-name carries the build uuid (the poller can find runs by it)
+  * top-level permissions: contents: read, actions: write
+  * the setup job passes build_uuid instead of zip_url_json
+  * steps that POST to /cleanzip, /updategh (STATUS_URL) or to an API
+    server's /api/save_custom_client are removed
+  * steps that POST builds to <GENURL>/save_custom_client become
+    actions/upload-artifact steps named rdgen-<build_uuid>-<job>-<index>
+    with retention-days: 1
+  * image downloads from /get_png become copies from
+    $RUNNER_TEMP/rdgen-assets (staged by the decrypt-secrets action)
+  * patch downloads from raw.githubusercontent.com/bryangerlach/rdgen
+    master become copies from $RUNNER_TEMP/rdgen-patches (this commit)
+  * the printer-adapter checkout of bryangerlach/rdgen@master becomes
+    this repository at this commit
+  * every remote action is pinned to a full commit SHA
+  * uploads without retention-days get retention-days: 1
+  * workflows the pull model does not use are deleted (UNUSED); any other
+    new workflow_dispatch workflow makes the check fail
+  * Linux: custom_.txt is staged in /usr/share/<app name>/ next to the
+    renamed program (upstream left it in /usr/share/rustdesk/, where a
+    custom-named client never reads it); the Flatpak ID keeps only letters
+    and digits of the app name (IDs reject spaces, brackets and hyphens in
+    inner parts), and the metainfo launchable names <ID>.desktop
+  * macOS: custom_.txt goes into Contents/Resources, where RustDesk reads
+    it on macOS (upstream wrote it into Contents/MacOS, so Mac clients never
+    loaded their settings, and signing treated it as a program)
+  * self-hosted runners: in the workflows listed in ROUTED every runs-on lets
+    a repository variable (RDGEN_RUNNER_LINUX, RDGEN_RUNNER_LINUX_ARM,
+    RDGEN_RUNNER_WINDOWS) name a runner label; on a self-hosted runner the
+    GitHub-image cleanup (sudo rm -rf /opt/ghc ...) is skipped and the Linux
+    and Windows build jobs check their prerequisites first
+  * Linux: inputs linux_arch (both, x86_64, aarch64) and linux_formats (all,
+    or deb for .deb and .rpm only, skipping AppImage and Flatpak)
+  * macOS: an input mac_arch (both, x86_64 or aarch64) picks which of the two
+    Mac jobs run (the matrix comes from fromJSON); repository variables
+    RDGEN_RUNNER_MACOS_X86_64 / RDGEN_RUNNER_MACOS_AARCH64 send a job to a
+    self-hosted runner with that label; on a self-hosted Mac a prepare step
+    checks Xcode and the tools tools/runner-mac.sh installs, the brew install
+    steps run on GitHub's Macs only (Homebrew no longer has prebuilt packages
+    for Intel Macs), and tools go to a per-job directory instead of sudo into
+    /usr/local; Create
+    DMG uses $GITHUB_WORKSPACE instead of /Users/runner/work and skips the
+    Finder layout there; the signing keychain is always removed
+  * macOS, with a Developer ID .p12 (MACOS_P12_BASE64, MACOS_P12_PASSWORD):
+    the rcodesign download is checked against a pinned sha256; upstream's
+    "Sign macOS app bundle" step (rcodesign on every file, secrets pasted
+    into the script) is dropped, and before "Create DMG" the app is signed
+    with Apple's codesign the way RustDesk signs its releases (hardened
+    runtime, timestamp, --deep); after it the DMG is signed, and with an App
+    Store Connect API key (APPLE_API_ISSUER_ID, APPLE_API_KEY_ID,
+    APPLE_API_KEY_P8, or rcodesign's MACOS_NOTARIZE_JSON) Apple notarizes it
+    and the ticket is stapled
+"""
+import json
+import os
+import re
+import sys
+
+GENERATORS = ['generator-windows.yml', 'generator-windows-x86.yml', 'generator-linux.yml',
+              'generator-android.yml', 'generator-macos.yml']
