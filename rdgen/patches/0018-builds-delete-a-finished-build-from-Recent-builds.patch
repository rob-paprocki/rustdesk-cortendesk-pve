diff --git a/rdgenerator/tests/test_delete.py b/rdgenerator/tests/test_delete.py
new file mode 100644
index 0000000..26eda3f
--- /dev/null
+++ b/rdgenerator/tests/test_delete.py
@@ -0,0 +1,145 @@
+"""Deleting a build from Recent builds (/builds, action delete_build)."""
+import hashlib
+import json
+import tempfile
+import uuid
+from datetime import timedelta
+from pathlib import Path
+
+from django.contrib.auth import get_user_model
+from django.test import Client, TestCase, override_settings
+from django.utils import timezone
+
+from rdgenerator.management.commands.rdgen_publish import pending_builds
+from rdgenerator.models import GithubRun, ShareLink
+from rdgenerator.poller import discard_build, prune_local
+
+EXE = b'MZ' + b'\0' * 200
+API_TOKEN = 'd' * 40
+
+
+class DeleteBuildTests(TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.override = override_settings(ARTIFACT_ROOT=self.tmp.name, DATA_DIR=Path(self.tmp.name),
+                                          RDGEN_RETENTION_DAYS=30, RDGEN_SHARE_BASE='', RDGEN_API_TOKEN=API_TOKEN,
+                                          RDGEN_PUBLISH_DEFAULT='hidden', RDGEN_PUBLISH_TARGET='CortenDesk')
+        self.override.enable()
+        self.c = Client()
+        self.c.force_login(get_user_model().objects.create_user('tester', password='x' * 16))
+        self.anon = Client()
+
+    def tearDown(self):
+        self.override.disable()
+        self.tmp.cleanup()
+
+    def run_with_file(self, status='success', **kw):
+        u = str(uuid.uuid4())
+        d = Path(self.tmp.name) / u
+        d.mkdir()
+        (d / 'acme_client.exe').write_bytes(EXE)
+        kw.setdefault('label', 'Acme Support')
+        return GithubRun.objects.create(
+            uuid=u, status=status, platform='windows', filename='acme_client', version='1.4.9', github_run_id=42,
+            files=[{'name': 'acme_client.exe', 'size': len(EXE), 'sha256': hashlib.sha256(EXE).hexdigest()}], **kw)
+
+    def delete(self, run):
+        return self.c.post('/builds', {'action': 'delete_build', 'uuid': run.uuid})
+
+    def test_delete_removes_files_links_and_every_way_in(self):
+        run = self.run_with_file(publish='hidden', publish_state='done')
+        self.c.post('/builds', {'action': 'share', 'uuid': run.uuid, 'days': '7'})
+        token = ShareLink.objects.get().token
+        page = self.c.get('/builds').content.decode()
+        self.assertIn('name="action" value="delete_build"', page)
+        self.assertIn("The copy in CortenDesk's Client Downloads stays", page)
+        r = self.delete(run)
+        self.assertEqual(r.status_code, 302)
+        self.assertFalse((Path(self.tmp.name) / run.uuid).exists())
+        self.assertFalse(ShareLink.objects.exists())
+        run.refresh_from_db()
+        self.assertIsNotNone(run.deleted_at)   # the row stays for prune_remote
+        self.assertEqual(run.files, [])
+        self.assertNotIn('Acme Support', self.c.get('/builds').content.decode())
+        for path in (f'/check_for_file?uuid={run.uuid}', f'/download?uuid={run.uuid}&filename=acme_client.exe'):
+            self.assertEqual(self.c.get(path).status_code, 404, path)
+        self.assertEqual(self.anon.get(f'/share/{token}').status_code, 404)
+        h = {'HTTP_AUTHORIZATION': f'Bearer {API_TOKEN}'}
+        self.assertEqual(self.c.get(f'/api/status?uuid={run.uuid}', **h).status_code, 404)
+        self.assertEqual(self.c.get(f'/api/download?uuid={run.uuid}&filename=acme_client.exe', **h).status_code, 404)
+        self.assertEqual(self.delete(run).status_code, 404)   # twice: already gone
+
+    def test_failed_builds_can_be_deleted_running_ones_cannot(self):
+        failed = self.run_with_file(status='failure', label='Broken')
+        busy = self.run_with_file(status='in_progress', label='Busy')
+        page = self.c.get('/builds').content.decode()
+        self.assertEqual(page.count('name="action" value="delete_build"'), 1)
+        self.assertEqual(self.delete(busy).status_code, 404)
+        self.assertTrue((Path(self.tmp.name) / busy.uuid).exists())
+        self.assertEqual(self.delete(failed).status_code, 302)
+        self.assertFalse((Path(self.tmp.name) / failed.uuid).exists())
+        with self.assertRaises(ValueError):
+            discard_build(GithubRun.objects.get(pk=busy.pk))
+        self.assertEqual(self.c.post('/builds', {'action': 'delete_build', 'uuid': 'nope'}).status_code, 404)
+
+    def test_a_waiting_hand_off_is_skipped(self):
+        run = self.run_with_file(publish='hidden', publish_state='')
+        self.assertEqual([b['uuid'] for b in pending_builds()], [run.uuid])
+        self.delete(run)
+        self.assertEqual(pending_builds(), [])
+        run.refresh_from_db()
+        self.assertEqual(run.publish_state, 'skipped')
+        # a build whose hand-off already ran keeps its record
+        done = self.run_with_file(publish='published', publish_state='done', publish_note='Added.')
+        self.delete(done)
+        done.refresh_from_db()
+        self.assertEqual((done.publish_state, done.publish_note), ('done', 'Added.'))
+
+    def test_a_hand_off_that_was_already_running_cannot_undo_the_delete(self):
+        # the job listed the build, then the user deleted it before the import finished
+        import io
+        from django.core.management import call_command
+        run = self.run_with_file(publish='hidden', publish_state='')
+        self.assertEqual(len(pending_builds()), 1)
+        self.delete(run)
+        for state in ('failed', 'done', 'pending'):
+            out = io.StringIO()
+            call_command('rdgen_publish', 'mark', run.uuid, state, '--note', 'x', stdout=out)
+            self.assertEqual(out.getvalue().strip(), 'deleted', state)
+        run.refresh_from_db()
+        self.assertEqual(run.publish_state, 'skipped')
+        self.assertEqual(pending_builds(), [])
+
+    def test_deleted_rows_go_at_the_usual_retention(self):
+        run = self.run_with_file(status='failure')
+        self.delete(run)
+        prune_local()
+        self.assertTrue(GithubRun.objects.filter(pk=run.pk).exists())   # prune_remote still needs github_run_id
+        GithubRun.objects.filter(pk=run.pk).update(created_at=timezone.now() - timedelta(days=31))
+        prune_local()
+        self.assertFalse(GithubRun.objects.filter(pk=run.pk).exists())
+
+    def test_prune_remote_still_deletes_a_deleted_failed_run(self):
+        from rdgenerator import poller
+        run = self.run_with_file(status='failure')
+        GithubRun.objects.filter(pk=run.pk).update(completed_at=timezone.now() - timedelta(days=3))
+        self.delete(run)
+        calls = []
+        orig = (poller.list_artifacts, poller.delete_run)
+        poller.list_artifacts = lambda gh, rid: []
+        poller.delete_run = lambda gh, rid: calls.append(rid)
+        try:
+            self.assertEqual(poller.prune_remote(gh=object()), 1)
+        finally:
+            poller.list_artifacts, poller.delete_run = orig
+        self.assertEqual(calls, [42])
+        self.assertTrue(GithubRun.objects.get(pk=run.pk).run_deleted)
+
+    def test_status_json_api_hides_deleted_builds(self):
+        run = self.run_with_file()
+        h = {'HTTP_AUTHORIZATION': f'Bearer {API_TOKEN}'}
+        r = self.c.get(f'/api/status?uuid={run.uuid}', **h)
+        self.assertEqual(r.status_code, 200, r.content)
+        self.assertEqual(json.loads(r.content)['status'], 'success')
+        discard_build(run)
+        self.assertEqual(self.c.get(f'/api/status?uuid={run.uuid}', **h).status_code, 404)
