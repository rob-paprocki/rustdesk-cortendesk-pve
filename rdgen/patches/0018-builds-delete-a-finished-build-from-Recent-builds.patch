diff --git a/rdgenerator/poller.py b/rdgenerator/poller.py
index ccdb97b..1e2e1b4 100644
--- a/rdgenerator/poller.py
+++ b/rdgenerator/poller.py
@@ -293,6 +293,25 @@ def sync_build(gh, build, now=None):
             log.warning('build %s: could not delete run yet: %s', build.uuid, exc)
 
 
+def discard_build(build, now=None):
+    """Delete a finished build from rdgen (Recent builds): hide it, then remove its share links and files.
+
+    Only for terminal builds: the poller never touches those again, so nothing can write the files back. A hand-off
+    that has not run yet is skipped; copies already in the console stay there. The row is kept (deleted_at) until
+    prune_local, so prune_remote still deletes a failed run on GitHub.
+    """
+    if not build.is_terminal:
+        raise ValueError('only finished builds can be deleted')
+    update = {'deleted_at': now or timezone.now(), 'files': []}
+    if build.publish in ('hidden', 'published') and build.publish_state == '':
+        update.update(publish_state='skipped', publish_note='Deleted in rdgen before it was added.')
+    if not GithubRun.objects.filter(pk=build.pk, deleted_at__isnull=True).update(**update):
+        return False   # already deleted
+    ShareLink.objects.filter(build_id=build.pk).delete()
+    shutil.rmtree(build_dir(build), ignore_errors=True)
+    return True
+
+
 def flag_publish():
     """Tell the hand-off job (rdgen_publish) that a finished build is waiting.
 
