diff --git a/rdgenerator/templates/_linux_name.html b/rdgenerator/templates/_linux_name.html
new file mode 100644
index 0000000..25ba407
--- /dev/null
+++ b/rdgenerator/templates/_linux_name.html
@@ -0,0 +1,30 @@
+<div class="rd-hint" id="rd-linux-name" hidden></div>
+<script>
+(function () {
+    // mirrors validation.linux_app_name / linux_app_name_problem
+    const field = document.getElementById('id_appname');
+    const platform = document.getElementById('id_platform');
+    const note = document.getElementById('rd-linux-name');
+    function slug(name) {
+        const s = name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
+        return s.length >= 2 ? s : 'rustdesk';
+    }
+    function show(text, bad) { note.hidden = false; note.style.color = bad ? '#ff7b72' : ''; note.textContent = text; }
+    function update() {
+        const name = (field.value || '').trim();
+        const raw = name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
+        if (platform.value !== 'linux' || !name || raw === 'rustdesk') { note.hidden = true; return; }
+        if (raw.length < 2) return show('For Linux builds the app name needs at least two letters or digits.', true);
+        if (/^[0-9]/.test(raw)) return show('For Linux builds the app name becomes "' + raw + '", which has to start with a letter.', true);
+        if (raw.includes('rustdesk')) return show('For Linux builds the app name becomes "' + raw + '", and a name containing "rustdesk" is renamed twice by the build. Choose one without "rustdesk".', true);
+        const installs = 'On Linux the client installs /usr/bin/' + raw + ' and the ' + raw + ' service, so the name must ' +
+            'not belong to an existing Linux command or package (rdgen refuses those).';
+        show(raw === name ? installs : 'Linux builds use "' + raw + '" as the app name: RustDesk on Linux names its ' +
+            'package, folders and service after it, which allow only lowercase letters, digits and hyphens. ' + installs +
+            ' CortenDesk\'s Client Downloads still show the full name.');
+    }
+    field.addEventListener('input', update);
+    setInterval(update, 500);   // the platform icons change the select without events
+    update();
+})();
+</script>
