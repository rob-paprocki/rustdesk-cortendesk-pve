+class LinuxAppNameTests(StubTestCase):
+    def secrets(self, **body):
+        r = self.generate(**body)
+        self.assertEqual(r.status_code, 200, r.content)
+        req = [x for x in self.stub.requests if x['path'].endswith('/dispatches')][-1]
+        return json.loads(decrypt_cfg(req['body']['inputs']['cfg'])['secrets.json'])
+
+    def test_linux_build_gets_a_linux_safe_name(self):
+        s = self.secrets(platform='linux', appname='Rescue Client (Rob Paprocki)')
+        self.assertEqual(s['appname'], 'rescue-client-rob-paprocki')
+        custom = json.loads(base64.b64decode(s['custom']))
+        self.assertEqual(custom['app-name'], 'rescue-client-rob-paprocki')
+        from rdgenerator.models import GithubRun
+        self.assertEqual(GithubRun.objects.latest('id').label, 'Rescue Client (Rob Paprocki)')
+
+    def test_other_platforms_keep_the_name(self):
+        s = self.secrets(platform='windows', appname='Rescue Client (Rob Paprocki)')
+        self.assertEqual(s['appname'], 'Rescue Client (Rob Paprocki)')
+
+    def test_default_and_already_safe_names_unchanged(self):
+        self.assertEqual(self.secrets(platform='linux')['appname'], 'rustdesk')
+        self.assertEqual(self.secrets(platform='linux', appname='acme-remote')['appname'], 'acme-remote')
+        self.assertEqual(self.secrets(platform='linux', appname='RustDesk')['appname'], 'rustdesk')
