 rdgenerator/templates/_linux_name.html |   30 +
 rdgenerator/templates/generator.html   |   13 +-
 rdgenerator/tests/test_ui.py           |   49 +
 rdgenerator/tests/test_workflows.py    |    7 +
 rdgenerator/validation.py              |   41 +
 rdgenerator/views.py                   |    8 +-
 7 files changed, 8205 insertions(+), 8 deletions(-)
 create mode 100644 rdgenerator/linux_reserved_names.txt
 create mode 100644 rdgenerator/templates/_linux_name.html

diff --git a/rdgenerator/linux_reserved_names.txt b/rdgenerator/linux_reserved_names.txt
new file mode 100644
index 0000000..2db8edd
--- /dev/null
+++ b/rdgenerator/linux_reserved_names.txt
@@ -0,0 +1,8065 @@
