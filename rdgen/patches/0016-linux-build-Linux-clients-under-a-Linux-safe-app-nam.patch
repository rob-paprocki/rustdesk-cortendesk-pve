+def linux_app_name(name):
+    """The app name a Linux build gets: lowercase letters, digits and hyphens.
+
+    RustDesk on Linux names its package, /usr/share and /etc folders, systemd
+    unit and process after the lowercased app name, and the build's shell
+    commands and dpkg/rpm reject spaces, brackets and underscores, so
+    "Rescue Client (Rob Paprocki)" becomes "rescue-client-rob-paprocki".
+    """
+    slug = re.sub(r'[^a-z0-9]+', '-', (name or '').lower()).strip('-')
+    return slug if len(slug) >= 2 else 'rustdesk'
+
+
+@functools.lru_cache(maxsize=1)
+def linux_reserved_names():
+    path = os.path.join(os.path.dirname(__file__), 'linux_reserved_names.txt')
+    with open(path, encoding='utf-8') as fh:
+        return frozenset(line.strip() for line in fh if line.strip() and not line.startswith('#'))
+
+
+def linux_app_name_problem(name):
+    """Why a Linux build cannot use this app name, or ''. A blank name means the default (rustdesk)."""
+    if not (name or '').strip():
+        return ''
+    slug = re.sub(r'[^a-z0-9]+', '-', name.lower()).strip('-')
+    head = f'For Linux builds the app name becomes "{slug}", '
+    if slug == 'rustdesk':
+        return ''
+    if len(slug) < 2:
+        return 'For Linux builds the app name needs at least two letters or digits.'
+    if slug[0].isdigit():
+        return head + 'and it has to start with a letter (it also names the link scheme the client registers).'
+    if 'rustdesk' in slug:
+        return head + 'and a name containing "rustdesk" is renamed twice by the build. Choose one without "rustdesk".'
+    if slug in linux_reserved_names():
+        return (head + 'which is already the name of a Linux command, package or service: installing the client '
+                f'would replace it. Choose a more distinctive name, for example "{slug}-remote".')
+    return ''
+
+
 def sanitize_filename(value):
