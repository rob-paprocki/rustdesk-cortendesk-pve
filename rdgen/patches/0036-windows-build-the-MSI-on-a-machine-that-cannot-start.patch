From fa314392c1ead4a05043ced47c85123c4c837c35 Mon Sep 17 00:00:00 2001
From: rustdesk-cortendesk-pve release <rustdesk-cortendesk-pve release>
Date: Wed, 18 Nov 2026 15:02:21 +0000
Subject: [PATCH 36/38] windows: build the MSI on a machine that cannot start
 the client

RustDesk's res/msi/preprocess.py starts the client it packages
(<app>.exe --version and --build-date). On a Windows Server Core runner
the client cannot start, because librustdesk.dll and flutter_windows.dll
link desktop DLLs that Server Core leaves out (sas, dxva2, xpsprint,
opengl32). preprocess.py failed, Includes.wxi stayed empty, WiX stopped
with WIX0150, and "Build msi" continued on error, so every build since the
Server Core runner finished with the .exe only.

.github/patches/msiPreprocessFallback.py edits preprocess.py before the
build: a version that does not look like one comes from Cargo.toml, a
build date that does not stays the clock time preprocess.py starts with.
It stops when preprocess.py no longer has the lines it edits. pullify
(0008) runs it in a new step before "Build msi" and takes
continue-on-error off that step.

Tests run the helper against upstream's init_global_vars (1.5.3).
SETUP-PULL.md says why.
---
 .github/patches/msiPreprocessFallback.py | 37 +++++++++++
 SETUP-PULL.md                            |  2 +
 rdgenerator/tests/test_workflows.py      | 83 ++++++++++++++++++++++++
 3 files changed, 122 insertions(+)
 create mode 100644 .github/patches/msiPreprocessFallback.py

diff --git a/.github/patches/msiPreprocessFallback.py b/.github/patches/msiPreprocessFallback.py
new file mode 100644
index 0000000..ecfb23e
--- /dev/null
+++ b/.github/patches/msiPreprocessFallback.py
@@ -0,0 +1,37 @@
+"""rdgen: let RustDesk's res/msi/preprocess.py build the MSI without starting the client it packages.
+
+preprocess.py runs <app>.exe --version and --build-date. A build machine without the desktop DLLs that RustDesk
+links (Windows Server Core has no sas, dxva2, xpsprint or opengl32) cannot start the client, and the MSI failed.
+After this, a version that does not look like one comes from the Cargo.toml the client was built from, and a
+build date that does not look like one stays the clock time preprocess.py sets when it starts. Run from the
+RustDesk checkout (generator-windows.yml, "Let the MSI build without starting the client").
+"""
+import pathlib
+
+p = pathlib.Path('res/msi/preprocess.py')
+s = p.read_text(encoding='utf-8')
+old_v = '        g_version = read_process_output("--version")\n'
+new_v = old_v + (
+    '        if not version_pattern_ok(g_version):  # rdgen: this build machine cannot start the client\n'
+    '            g_version = cargo_version()\n')
+old_d = '    g_build_date = read_process_output("--build-date")\n'
+new_d = (
+    '    _date = read_process_output("--build-date")\n'
+    '    if re.match(r"\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}", _date):  # rdgen: else the clock time set above\n'
+    '        g_build_date = _date\n')
+old_f = 'def init_global_vars(dist_dir, app_name, args):\n'
+new_f = (
+    'def version_pattern_ok(v):\n'
+    '    return re.match(r"\\d+\\.\\d+\\.\\d+", v) is not None\n'
+    '\n\n'
+    'def cargo_version():\n'
+    '    # rdgen: the version the client was built with, from the Cargo.toml it was built from\n'
+    '    text = (Path(__file__).resolve().parents[2] / "Cargo.toml").read_text(encoding="utf-8")\n'
+    '    m = re.search(r\'(?m)^version\\s*=\\s*"([^"]+)"\', text)\n'
+    '    return m.group(1).replace("-", ".") if m else ""\n'
+    '\n\n' + old_f)
+for old in (old_v, old_d, old_f):
+    assert s.count(old) == 1, f'preprocess.py changed upstream: {old.strip()}'
+s = s.replace(old_v, new_v).replace(old_d, new_d).replace(old_f, new_f)
+p.write_text(s, encoding='utf-8')
+print('preprocess.py: version and build date no longer need the client to run')
