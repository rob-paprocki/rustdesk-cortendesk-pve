+    def test_windows_msi_builds_without_starting_the_client(self):
+        import pathlib
+        import runpy
+        import types
+        with open(os.path.join(WORKFLOWS, 'generator-windows.yml'), encoding='utf-8') as fh:
+            text = fh.read()
+        names = re.findall(r'^\s*- name: (.+?)\s*$', text, re.M)
+        self.assertEqual(names[names.index('Build msi') - 1], 'Let the MSI build without starting the client')
+        msi = text.split('- name: Build msi', 1)[1].split('\n      - name:', 1)[0]
+        self.assertNotIn('continue-on-error', msi)   # a build without its MSI fails
+        prep = text.split('- name: Let the MSI build without starting the client', 1)[1].split('\n      - name:', 1)[0]
+        self.assertIn('python "$RUNNER_TEMP/rdgen-patches/msiPreprocessFallback.py"', prep)
+        helper = os.path.join(ROOT, '.github', 'patches', 'msiPreprocessFallback.py')
+        with tempfile.TemporaryDirectory() as tmp:
+            os.makedirs(os.path.join(tmp, 'res', 'msi'))
+            with open(os.path.join(tmp, 'Cargo.toml'), 'w', encoding='utf-8') as fh:
+                fh.write('[package]\nname = "rustdesk"\nversion = "1.5.3"\n')
+            with open(os.path.join(tmp, 'res', 'msi', 'preprocess.py'), 'w', encoding='utf-8') as fh:
+                fh.write(PREPROCESS_FIXTURE)
+            r = subprocess.run([sys.executable, helper], cwd=tmp, capture_output=True, text=True)
+            self.assertEqual(r.returncode, 0, r.stderr)
+            init = runpy.run_path(os.path.join(tmp, 'res', 'msi', 'preprocess.py'), run_name='fixture')['init_global_vars']
+            # no client that starts: the version comes from Cargo.toml, the build date from the clock
+            self.assertTrue(init(pathlib.Path(tmp), 'not-startable', types.SimpleNamespace(version='', revision_version=7)))
+            self.assertEqual(init.__globals__['g_version'].split('.'), ['1', '5', '3', '7'])
+            self.assertRegex(init.__globals__['g_build_date'], r'^\d{4}-\d{2}-\d{2} \d{2}:\d{2}$')
+            # a version given on the command line still wins
+            self.assertTrue(init(pathlib.Path(tmp), 'not-startable', types.SimpleNamespace(version='1.6.0', revision_version=0)))
+            self.assertEqual(init.__globals__['g_version'].split('.'), ['1', '6', '0', '0'])
+            # preprocess.py changed upstream: the helper stops instead of building a wrong MSI
+            with open(os.path.join(tmp, 'res', 'msi', 'preprocess.py'), 'w', encoding='utf-8') as fh:
+                fh.write('def init_global_vars(dist_dir, app_name, args):\n    return True\n')
+            r = subprocess.run([sys.executable, helper], cwd=tmp, capture_output=True, text=True)
+            self.assertNotEqual(r.returncode, 0)
+
