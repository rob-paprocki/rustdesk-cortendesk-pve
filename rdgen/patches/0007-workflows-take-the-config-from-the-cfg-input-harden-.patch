diff --git a/.github/actions/decrypt-secrets/validate.py b/.github/actions/decrypt-secrets/validate.py
new file mode 100644
index 0000000..4dd5852
--- /dev/null
+++ b/.github/actions/decrypt-secrets/validate.py
@@ -0,0 +1,63 @@
+"""Allowlist for the values in secrets.json (mirrors rdgenerator/validation.py).
+
+The generator workflows paste these values into bash, pwsh, sed and perl
+(`${{ env.appname }}` ...). The rdgen server validates them before it
+encrypts the config; this second check keeps a compromised or outdated
+server from reaching the runner's shell (and the signing secrets there).
+"""
+import re
+
+_LABEL = r'[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?'
+HOST = rf'(?:{_LABEL}(?:\.{_LABEL})*|\[[0-9A-Fa-f:.]{{2,45}}\])'
+_PORT = r'(?::[0-9]{1,5})?'
+_PATH = r'(?:/[A-Za-z0-9._~/-]*)?'
+_BOOL = r'(?:true|false)'
+
+RULES = {
+    'server': HOST,
+    'serverPort': r'[0-9]{1,5}',
+    'key': r'[A-Za-z0-9+/]{43}=',
+    'apiServer': rf'(?:https?://)?{HOST}{_PORT}{_PATH}',
+    'custom': r'[A-Za-z0-9+/]{0,16384}={0,2}',
+    'uuid': r'[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}',
+    'iconlink_url': r'(?:embedded|false)',
+    'logolink_url': r'(?:embedded|false)',
+    'privacylink_url': r'(?:embedded|false)',
+    'appname': r'[A-Za-z0-9][A-Za-z0-9 ._()+,-]{0,63}',
+    'urlLink': rf'https?://{HOST}{_PORT}{_PATH}',
+    'downloadLink': rf'https?://{HOST}{_PORT}{_PATH}',
+    'delayFix': _BOOL,
+    'rdgen': _BOOL,
+    'xOffline': _BOOL,
+    'removeNewVersionNotif': _BOOL,
+    'compname': r'[A-Za-z0-9 ._()+,-]{1,64}',
+    'androidappid': r'[A-Za-z][A-Za-z0-9_]{0,40}(?:\.[A-Za-z][A-Za-z0-9_]{0,40}){1,6}',
+    'filename': r'[A-Za-z0-9_-]{1,64}',
+}
+_COMPILED = {k: re.compile(v) for k, v in RULES.items()}
+
+# Not secret, and masking them would blank out common words ("true") or
+# the build id in every log line.
+NOT_SECRET = {'uuid', 'rdgen', 'delayFix', 'xOffline', 'removeNewVersionNotif',
+              'iconlink_url', 'logolink_url', 'privacylink_url'}
+
+
+def validate_secrets(data):
+    """Return a list of problems. Messages name keys only, never values."""
+    if not isinstance(data, dict):
+        return ['secrets.json is not a JSON object']
+    problems = []
+    unknown = sorted(set(data) - set(RULES))
+    missing = sorted(set(RULES) - set(data))
+    if unknown:
+        problems.append('unknown keys: ' + ', '.join(k[:40] for k in unknown))
+    if missing:
+        problems.append('missing keys: ' + ', '.join(missing))
+    for key, rx in _COMPILED.items():
+        value = data.get(key)
+        if key in data and (not isinstance(value, str) or not rx.fullmatch(value)):
+            problems.append(f'{key}: value not allowed')
+    port = data.get('serverPort')
+    if isinstance(port, str) and port.isdigit() and not 1 <= int(port) <= 65532:
+        problems.append('serverPort: out of range')
+    return problems
