index 0000000..6fa2274
--- /dev/null
+++ b/.github/actions/decrypt-secrets/decrypt.py
@@ -0,0 +1,100 @@
+"""Decrypt the rdgen cfg zip, validate it, mask and export its values.
+
+Also stages, under $RUNNER_TEMP (the later checkout of rustdesk/rustdesk
+into the workspace root wipes the workspace):
+  rdgen-assets/{icon,logo,privacy}.png   images embedded in the cfg zip
+  rdgen-patches/                          .github/patches of THIS commit
+so no step has to download anything from rdgen or from raw.githubusercontent.
+"""
+import io
+import json
+import os
+import re
+import secrets
+import shutil
+import sys
+
+sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding='utf-8', errors='replace')
+sys.stderr = io.TextIOWrapper(sys.stderr.buffer, encoding='utf-8', errors='replace')
+
+import pyzipper  # noqa: E402
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, HERE)
+from validate import NOT_SECRET, validate_secrets  # noqa: E402
+
+ASSET_MEMBER = re.compile(r'assets/(icon|logo|privacy)\.png')
+PNG_MAGIC = b'\x89PNG\r\n\x1a\n'
+
+
+def fail(msg):
+    print(f'::error::{msg}')
+    sys.exit(1)
+
+
+def main():
+    password = os.environ.get('RDGEN_ZIP_PASSWORD', '')
+    zip_path = os.environ.get('RDGEN_ZIP_PATH', 'secrets.zip')
+    if not password:
+        fail('The ZIP_PASSWORD repository secret is not set.')
+    try:
+        with pyzipper.AESZipFile(zip_path) as zf:
+            zf.setpassword(password.encode('utf-8'))
+            names = zf.namelist()
+            for name in names:
+                if name != 'secrets.json' and not ASSET_MEMBER.fullmatch(name):
+                    fail('The config zip contains an unexpected member.')
+            data = json.loads(zf.read('secrets.json').decode('utf-8'))
+            assets = {name.split('/', 1)[1]: zf.read(name) for name in names if name.startswith('assets/')}
+    except (RuntimeError, KeyError, ValueError, OSError, pyzipper.BadZipFile) as exc:
+        fail(f'Could not decrypt the config ({type(exc).__name__}). Does ZIP_PASSWORD match the rdgen server?')
+
+    problems = validate_secrets(data)
+    if problems:
+        fail('Config rejected: ' + '; '.join(problems))
+
+    # Bind the encrypted config to this dispatch: a cfg captured from an
+    # earlier run cannot be replayed under another build id.
+    with open(os.environ['GITHUB_EVENT_PATH'], encoding='utf-8') as fh:
+        event = json.load(fh)
+    expected = (event.get('inputs') or {}).get('build_uuid')
+    if expected != data['uuid']:
+        fail('The config does not belong to this build (build_uuid mismatch).')
+
+    for flag, name in (('iconlink_url', 'icon.png'), ('logolink_url', 'logo.png'), ('privacylink_url', 'privacy.png')):
+        if (data[flag] == 'embedded') != (name in assets):
+            fail(f'{flag} does not match the embedded images.')
+        if name in assets and not assets[name].startswith(PNG_MAGIC):
+            fail(f'{name} is not a PNG.')
+
+    delimiter = 'RDGEN_EOF_' + secrets.token_hex(16)
+    with open(os.environ['GITHUB_ENV'], 'a', encoding='utf-8') as env_file:
+        for key, value in data.items():
+            if value and key not in NOT_SECRET:
+                # add-mask works per line; values are single-line here, but
+                # mask every line anyway in case a rule is ever loosened.
+                for line in value.splitlines() or [value]:
+                    if line.strip():
+                        print(f'::add-mask::{line}')
+            if delimiter in value or '\n' in value or '\r' in value:
+                fail(f'{key}: value not allowed')
+            env_file.write(f'{key}<<{delimiter}\n{value}\n{delimiter}\n')
+
+    temp = os.environ['RUNNER_TEMP']
+    asset_dir = os.path.join(temp, 'rdgen-assets')
+    os.makedirs(asset_dir, exist_ok=True)
+    for name, blob in assets.items():
+        with open(os.path.join(asset_dir, name), 'wb') as fh:
+            fh.write(blob)
+
+    repo_root = os.path.abspath(os.path.join(HERE, '..', '..', '..'))
+    patches = os.path.join(repo_root, '.github', 'patches')
+    if os.path.isdir(patches):
+        shutil.copytree(patches, os.path.join(temp, 'rdgen-patches'), dirs_exist_ok=True)
+
+    print(f'Exported {len(data)} values; staged images: {", ".join(sorted(assets)) or "none"}; '
+          f'patches: {"yes" if os.path.isdir(patches) else "no"}.')
+
+
+if __name__ == '__main__':
+    main()
