From e158cb550ee32efdc994422cac66248a06d93abc Mon Sep 17 00:00:00 2001
From: rustdesk-cortendesk-pve release <rustdesk-cortendesk-pve release>
Date: Wed, 18 Nov 2026 18:09:47 +0000
Subject: [PATCH 37/38] build repo: leave upstream's Dependabot config out

Upstream rdgen ships .github/dependabot.yml, so Dependabot opened
version-update pull requests in the build repository. They can only do
harm there: every rdgen update regenerates and force-pushes the
repository, so a merged bump is overwritten, and until then the workflows
differ from what pullify pinned and checked. pullify (0008) now deletes
the file like the upstream workflows the pull model does not use; action
updates keep arriving through upstream and the patch series, and
Dependabot alerts need no config file.

A test checks the build tree has no Dependabot config.
---
 rdgenerator/tests/test_workflows.py | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/rdgenerator/tests/test_workflows.py b/rdgenerator/tests/test_workflows.py
index ab38a92..67af524 100644
--- a/rdgenerator/tests/test_workflows.py
+++ b/rdgenerator/tests/test_workflows.py
@@ -147,6 +147,11 @@ class PullifyTests(SimpleTestCase):
             'generator-macos.yml', 'generator-windows-x86.yml', 'generator-windows.yml',
             'third-party-RustDeskTempTopMostWindow.yml']))
 
+    def test_no_dependabot_version_updates_in_the_build_repo(self):
+        # the build repository is regenerated by every update: Dependabot pull requests there would be overwritten
+        for name in ('dependabot.yml', 'dependabot.yaml'):
+            self.assertFalse(os.path.exists(os.path.join(ROOT, '.github', name)), name)
+
     def test_every_remote_action_pinned(self):
