@@ -0,0 +1,92 @@
+"""Builder form: site defaults, the Other section reference, and the LAN/auto-close settings."""
+import base64
+import json
+import re
+
+from django.contrib.auth import get_user_model
+from django.test import Client, TestCase, override_settings
+
+from rdgen import settings as rdgen_settings
+from rdgenerator import views
+from rdgenerator.tests.test_pull import StubTestCase, decrypt_cfg
+from rdgenerator.validation import MANUAL_KEY
+
+KEY = 'OeVuKk5nlHiXp+APNn0Y3pC1Iwpwn44JGqrQCsWqmBw='
+
+
+class FormPageTests(TestCase):
+    def setUp(self):
+        self.c = Client()
+        self.c.force_login(get_user_model().objects.create_user('tester', password='x' * 16))
+
+    def test_site_defaults_prefill_the_server_fields(self):
+        defaults = dict(rdgen_settings.RDGEN_DEFAULTS, server='rd.example.com', port='21116', key=KEY,
+                        api_server='https://rustdesk.example.com', company='Example Ltd')
+        with override_settings(RDGEN_DEFAULTS=defaults):
+            page = self.c.get('/').content.decode()
+        self.assertRegex(page, r'name="serverPort"[^>]*value="21116"')
+        self.assertRegex(page, r'name="compname"[^>]*value="Example Ltd"')
+        self.assertIn('direct link to an installer', ' '.join(page.split()))
+
+    def test_update_link_suggested_only_with_a_base(self):
+        with override_settings(RDGEN_UPDATE_BASE='https://rustdesk.example.com/clients'):
+            page = self.c.get('/').content.decode()
+        self.assertIn('<script id="rd-update-base" type="application/json">"https://rustdesk.example.com/clients"</script>', page)
+        self.assertIn('allow-auto-update=Y', page)
+        with override_settings(RDGEN_UPDATE_BASE=''):
+            page = self.c.get('/').content.decode()
+        self.assertNotIn('rd-update-base', page)
+
+    def test_invalid_site_default_is_dropped(self):
+        with override_settings(RDGEN_DEFAULTS=dict(rdgen_settings.RDGEN_DEFAULTS, port='21116; rm -rf /')):
+            page = self.c.get('/').content.decode()
+        self.assertNotRegex(page, r'name="serverPort"[^>]*value=')
+
+    def test_other_section_has_the_reference(self):
+        page = self.c.get('/').content.decode()
+        self.assertIn('Browse client options', page)
+        self.assertIn('<dialog id="rd-ref-dialog"', page)
+        self.assertIn('target="_blank"', page)
+        m = re.search(r'<script id="rd-client-settings" type="application/json">(.*?)</script>', page, re.S)
+        data = json.loads(m.group(1))
+        self.assertEqual(len(data['keys']), 140)
+
+
+class ReferenceDataTests(TestCase):
+    def test_reference_data_is_consistent(self):
+        data = views.client_settings()
+        keys = [k['key'] for k in data['keys']]
+        self.assertEqual(len(keys), len(set(keys)))
+        for k in data['keys']:
+            self.assertTrue(MANUAL_KEY.fullmatch(k['key']), k['key'])
+            self.assertIn(k['kind'], ('settings', 'local', 'display', 'builtin'))
+            self.assertTrue(k['description'])
+            self.assertNotIn('—', k['description'])
+            if k['choices'] and k['insert']:
+                self.assertIn(k['insert'], k['choices'], k['key'])
+        for key in list(data['controls']) + list(data['hard']):
+            self.assertTrue(MANUAL_KEY.fullmatch(key), key)
+        self.assertFalse(set(data['hard']) & set(keys))
+
+
+class LanAndAutoCloseTests(StubTestCase):
+    def custom(self, **body):
+        r = self.generate(**body)
+        self.assertEqual(r.status_code, 200, r.content)
+        req = [x for x in self.stub.requests if x['path'].endswith('/dispatches')][-1]
+        secrets_json = json.loads(decrypt_cfg(req['body']['inputs']['cfg'])['secrets.json'])
+        return json.loads(base64.b64decode(secrets_json['custom']))
+
+    def test_ticked_boxes_reach_the_settings_maps(self):
+        custom = self.custom(denyLan=True, autoClose=True, permissionsDorO='override')
+        self.assertEqual(custom['override-settings']['enable-lan-discovery'], 'N')
+        self.assertEqual(custom['override-settings']['allow-auto-disconnect'], 'Y')
+        custom = self.custom(denyLan=True, autoClose=True)
+        self.assertEqual(custom['default-settings']['enable-lan-discovery'], 'N')
+        self.assertEqual(custom['default-settings']['allow-auto-disconnect'], 'Y')
+
+    def test_unticked_boxes_leave_rustdesk_defaults(self):
+        custom = self.custom()
+        for section in ('default-settings', 'override-settings'):
+            self.assertNotIn('enable-lan-discovery', custom[section])
+            self.assertNotIn('allow-auto-disconnect', custom[section])
