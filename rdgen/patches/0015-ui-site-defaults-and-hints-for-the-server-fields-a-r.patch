+RDGEN_DEFAULT_PORT=21116
+# Homepage/privacy links, the update download (a direct installer URL), and the copyright holder
+RDGEN_DEFAULT_URL_LINK=
+RDGEN_DEFAULT_DOWNLOAD_LINK=
+RDGEN_DEFAULT_COMPANY=
+# Base of the self-update links the form suggests for Windows builds, e.g. https://console.example.com/clients.
+# The console must answer /clients/<windows-x86_64|windows-x86>/<version>/<name>.exe (the RustDesk LXC does).
+RDGEN_UPDATE_BASE=
 
