@@ -0,0 +1,96 @@
+<div class="rd-hint">
+    Installed Windows clients with Auto update on download this URL and run it to update themselves, so it must be a
+    direct link to an installer, not a web page. Empty keeps https://rustdesk.com/download, which installs stock
+    RustDesk without your settings. Nightly builds only update from RustDesk's GitHub releases.
+</div>
+{% if update_base %}
+<div class="rd-note" id="rd-update-note">
+    <div class="rd-note-title">Automatic updates from your console (Windows, RustDesk 1.4 and later)</div>
+    <div id="rd-update-status" class="rd-note-status" aria-live="polite"></div>
+    <ul>
+        <li>The link hands out the newest build of this configuration that you <b>published</b>, once its RustDesk
+            version is newer than the client's. A client never reinstalls the build it runs.</li>
+        <li>Clients check once a day, and only after RustDesk has released a newer version. Then rebuild here with that
+            version and publish it. Rebuilding with the same version does not reach clients.</li>
+        <li>Auto update is off on clients until a build turns it on:
+            <button type="button" id="rd-add-autoupdate">Add <code>allow-auto-update=Y</code> to Default settings</button></li>
+    </ul>
+    <div id="rd-update-http" class="rd-note-warn" hidden>
+        Your console URL starts with <code>http://</code>. Clients would download an installer and run it with
+        administrator rights over an unencrypted connection, where anyone on the path could replace it. Set an
+        <code>https://</code> console URL with <code>rustdesk-config</code> in the LXC before you rely on this.
+    </div>
+</div>
+<style>
+    .rd-note { border:1px solid #3d5a80; border-left:4px solid #4a90d9; background:#0f1722; border-radius:6px;
+        padding:10px 12px; margin:-2px 0 10px; font-size:.86em; line-height:1.45; color:#cfd8e3; }
+    .rd-note-title { font-weight:700; color:#fff; margin-bottom:4px; }
+    .rd-note ul { margin:6px 0 0; padding-left:18px; }
+    .rd-note li { margin:3px 0; }
+    .rd-note code { background:#222; padding:0 3px; border-radius:3px; }
+    .rd-note button { padding:2px 8px; font-size:.95em; margin-left:2px; }
+    .rd-note-status { padding:4px 8px; border-radius:4px; background:#16202c; margin:4px 0; }
+    .rd-note-status.ok { color:#7ee787; }
+    .rd-note-status.wait { color:#e3b341; }
+    .rd-note-warn { margin-top:8px; padding:6px 8px; border-radius:4px; background:#2a1515; color:#ffb4ac;
+        border:1px solid #6e2b26; }
+    #id_downloadLink.rd-auto { border-color:#4a90d9; }
+</style>
+{{ update_base|json_script:"rd-update-base" }}
+<script>
+(function () {
+    const base = JSON.parse(document.getElementById('rd-update-base').textContent);
+    const link = document.getElementById('id_downloadLink');
+    const name = document.getElementById('id_exename');
+    const version = document.getElementById('id_version');
+    const platform = document.getElementById('id_platform');
+    const status = document.getElementById('rd-update-status');
+    const arch = {'windows': 'windows-x86_64', 'windows-x86': 'windows-x86'};
+    document.getElementById('rd-update-http').hidden = !base.startsWith('http://');
+    function cleanName() {   // the file name the build gets (validation.sanitize_filename)
+        const n = (name.value || '').trim();
+        return /^[\x00-\x7f]*$/.test(n) ? n.replace(/[^A-Za-z0-9_-]/g, '_').slice(0, 64) : 'rustdesk';
+    }
+    function eligible() { return arch[platform.value] && /^\d+\.\d+\.\d+$/.test(version.value); }
+    function suggestion(n) {
+        return eligible() ? base + '/' + arch[platform.value] + '/' + version.value + '/' + n + '.exe' : '';
+    }
+    let auto = link.value === '';   // fill the field only while it is empty or still holds our own suggestion
+    const edited = () => { auto = link.value === '' || link.value === suggestion(cleanName()); };
+    link.addEventListener('input', edited);
+    link.addEventListener('change', edited);
+    function say(cls, text) { status.className = 'rd-note-status ' + cls; status.textContent = text; }
+    function update() {
+        const n = cleanName();
+        const s = n ? suggestion(n) : '';
+        link.placeholder = eligible() ? suggestion('<configuration name>') : 'https://rustdesk.com/download';
+        if (auto && link.value !== s) link.value = s;
+        link.classList.toggle('rd-auto', auto && s !== '');
+        if (!eligible()) {
+            say('wait', version.value === 'master'
+                ? 'Not filled in: nightly builds only update from RustDesk\'s GitHub releases.'
+                : 'Not filled in: only Windows clients update themselves.');
+        } else if (!auto) {
+            say('wait', 'Using the link you entered. Clear the field to use the console link again.');
+        } else if (!n) {
+            say('wait', 'Fills in when you enter the configuration name under General.');
+        } else if ((document.getElementById('id_removeNewVersionNotif') || {}).checked) {   // further down the page
+            say('wait', 'Filled in, but "Remove notification for new versions" is ticked: it also turns off the update check, so clients never update.');
+        } else {
+            say('ok', 'Filled in automatically from the configuration name, platform and version.');
+        }
+    }
+    document.getElementById('rd-add-autoupdate').addEventListener('click', e => {
+        const box = document.getElementById('id_defaultManual');
+        if (!/^\s*allow-auto-update\s*=/m.test(box.value)) {
+            box.value = box.value.replace(/\s*$/, '') + (box.value.trim() ? '\n' : '') + 'allow-auto-update=Y';
+            box.dispatchEvent(new Event('input'));
+        }
+        e.target.closest('button').textContent = 'Added to Default settings';
+    });
+    // the platform icons and "Load Configuration" change values without firing events
+    setInterval(update, 500);
+    update();
+})();
+</script>
+{% endif %}
