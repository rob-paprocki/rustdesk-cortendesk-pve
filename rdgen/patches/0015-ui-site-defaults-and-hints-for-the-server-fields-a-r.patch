+<div class="rd-hint" style="margin:10px 0 12px;">
+    Any other client option, one <code>key=value</code> per line, for example <code>enable-udp-punch=N</code>
+    (on/off options take Y or N).<br>
+    <b>Default settings</b> are starting values: users can still change them in the client.<br>
+    <b>Override settings</b> are enforced: users cannot change them.<br>
+    A line in Override settings replaces what a control above sets for the same key. A line in Default settings
+    does too, unless that control is set to Override, because an override always wins.
+</div>
+<label for="{{ form.defaultManual.id_for_label }}">Default settings</label>
+{{ form.defaultManual }}
+<div class="rd-lint" id="rd-lint-defaultManual" aria-live="polite"></div>
+<label for="{{ form.overrideManual.id_for_label }}">Override settings</label>
+{{ form.overrideManual }}
+<div class="rd-lint" id="rd-lint-overrideManual" aria-live="polite"></div>
+<button type="button" id="rd-ref-open" class="rd-ref-open">Browse client options&hellip;</button>
+<div class="rd-hint" id="rd-ref-summary"></div>
+<dialog id="rd-ref-dialog" class="rd-ref" aria-labelledby="rd-ref-title">
+    <div class="rd-ref-head">
+        <h3 id="rd-ref-title">Client options</h3>
+        <button type="button" id="rd-ref-close" aria-label="Close">&times;</button>
+    </div>
+    <input type="search" id="rd-ref-filter" placeholder="Filter by key, group or description" autocomplete="off">
+    <label class="rd-ref-all"><input type="checkbox" id="rd-ref-all"> Also show the <span id="rd-ref-set-count"></span>
+        options the form already sets with its own controls</label>
+    <div class="rd-ref-scroll">
+        <table>
+            <thead><tr><th>Option</th><th>Values</th><th>What it does</th><th>Add to</th></tr></thead>
+            <tbody id="rd-ref-body"></tbody>
+        </table>
+    </div>
+    <div class="rd-hint" style="margin-top:8px;">
+        Summarised from RustDesk's
+        <a href="https://rustdesk.com/docs/en/self-host/client-configuration/advanced-settings/" target="_blank"
+           rel="noopener noreferrer">advanced settings documentation</a>, where each option has more detail.
+        "Session" options are the defaults for each remote device, applied when you first connect to it.
+    </div>
+</dialog>
+{{ client_settings|json_script:"rd-client-settings" }}
+<style>
+    .rd-hint code, .rd-lint code, .rd-ref code { background:#222; padding:0 3px; border-radius:3px; }
+    #id_defaultManual, #id_overrideManual { font-family: ui-monospace, Menlo, Consolas, monospace; min-height: 6em; }
+    .rd-lint { font-size:.85em; margin:-4px 0 12px; line-height:1.4; }
+    .rd-lint div { padding:1px 0; }
+    .rd-lint .err { color:#ff7b72; }
+    .rd-lint .warn { color:#e3b341; }
+    .rd-lint .info { color:#8ab4f8; }
+    .rd-ref-open { margin:2px 0 4px; }
+    dialog.rd-ref { width:min(1100px, 92vw); max-height:88vh; padding:16px 18px; background:#111; color:#e0e0e0;
+        border:1px solid #444; border-radius:8px; box-sizing:border-box; }
+    dialog.rd-ref[open] { display:flex; flex-direction:column; }
+    dialog.rd-ref::backdrop { background:rgba(0,0,0,.65); }
+    .rd-ref-head { display:flex; justify-content:space-between; align-items:center; margin-bottom:8px; }
+    .rd-ref-head h3 { margin:0; color:#fff; }
+    #rd-ref-close { font-size:1.4em; line-height:1; padding:2px 10px; }
+    .rd-ref-all { display:block; margin:0 0 8px; color:#bbb; font-size:.9em; }
+    #rd-ref-filter { width:100%; padding:8px; margin-bottom:8px; background:#222; border:1px solid #444; border-radius:4px; color:#fff; box-sizing:border-box; }
+    .rd-ref-scroll { flex:1; min-height:0; overflow:auto; border:1px solid #333; border-radius:4px; }
+    .rd-ref table { width:100%; border-collapse:collapse; font-size:.82em; }
+    .rd-ref th { position:sticky; top:0; background:#1a1a1a; text-align:left; padding:6px; }
+    .rd-ref td { border-top:1px solid #2a2a2a; padding:5px 6px; vertical-align:top; }
+    .rd-ref td:first-child { white-space:nowrap; }
+    .rd-ref button.done { background:#2e7d32; }
+    .rd-ref .tag { display:inline-block; font-size:.85em; color:#999; }
+    .rd-ref .set { color:#e3b341; }
+    .rd-ref button { padding:2px 6px; font-size:.85em; margin:0 2px 2px 0; }
+</style>
+<script>
+(function () {
+    const data = JSON.parse(document.getElementById('rd-client-settings').textContent);
+    const catalog = new Map(data.keys.map(k => [k.key, k]));
+    const own = (obj, key) => Object.prototype.hasOwnProperty.call(obj, key) ? obj[key] : undefined;
+    function controlWritesOverride(key) {   // where the matching form control puts its value right now
+        const mode = own(data.control_mode, key);
+        if (mode === 'incoming') {
+            const dir = document.querySelector('input[name="direction"]:checked');
+            return !!dir && dir.value === 'incoming';
+        }
+        const sel = mode && document.getElementById('id_' + mode);
+        return !!sel && sel.value === 'override';
+    }
+    const KEY_RE = /^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$/;
+    const boxes = {defaultManual: 'Default settings', overrideManual: 'Override settings'};
+    const kindLabel = {settings: '', local: 'client', display: 'session', builtin: 'built-in'};
+    const SECRETS = new Set(['default-connect-password', 'proxy-password', 'preset-address-book-password']);
+
+    function esc(s) {
+        return String(s).replace(/[&<>"']/g, c => ({'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'}[c]));
+    }
+    function parse(text) {
+        const out = [];
+        text.split(/\r\n|\r|\n/).forEach((line, i) => {
+            if (!line.trim()) return;
+            const eq = line.indexOf('=');
+            out.push(eq < 0 ? {n: i + 1, line} : {n: i + 1, line, key: line.slice(0, eq).trim(), value: line.slice(eq + 1).trim()});
+        });
+        return out;
+    }
+    function lint() {
+        const parsed = {};
+        for (const id in boxes) parsed[id] = parse(document.getElementById('id_' + id).value);
+        for (const id in boxes) {
+            const other = id === 'defaultManual' ? 'overrideManual' : 'defaultManual';
+            const otherKeys = new Set(parsed[other].filter(p => p.key).map(p => p.key));
+            const seen = new Map();
+            const msgs = [];
+            for (const p of parsed[id]) {
+                const at = 'Line ' + p.n + ': ';
+                if (p.key === undefined) { msgs.push(['warn', at + 'no "=", so this line is ignored.']); continue; }
+                if (!KEY_RE.test(p.key)) { msgs.push(['err', at + '"' + esc(p.key.slice(0, 40)) + '" is not a valid option name.']); continue; }
+                if (seen.has(p.key)) msgs.push(['warn', at + '<code>' + esc(p.key) + '</code> is also on line ' + seen.get(p.key) + '; the last line wins.']);
+                seen.set(p.key, p.n);
+                const hard = own(data.hard, p.key);
+                if (hard) { msgs.push(['err', at + '<code>' + esc(p.key) + '</code> has no effect here. ' + esc(hard)]); continue; }
+                const k = catalog.get(p.key);
+                const control = own(data.controls, p.key);
+                if (control && id === 'defaultManual' && controlWritesOverride(p.key))
+                    msgs.push(['warn', at + 'has no effect: "' + esc(control) + '" above sets this as an override. Put the line in Override settings, or set that control to Default.']);
+                else if (control) msgs.push(['info', at + 'replaces the value from "' + esc(control) + '" above.']);
+                if (!k) {
+                    if (!control) msgs.push(['warn', at + '<code>' + esc(p.key) + '</code> is not in RustDesk\'s documented options. Check the spelling.']);
+                    continue;
+                }
+                if ((SECRETS.has(p.key) || (p.key === 'proxy-url' && p.value.includes('@'))) && p.value)
+                    msgs.push(['warn', at + 'the client carries this password in readable form, so it cannot go on the public downloads page.']);
+                if (k.choices.length && !k.choices.includes(p.value)) msgs.push(['warn', at + '<code>' + esc(p.key) + '</code> expects ' + k.choices.map(esc).join(' or ') + '.']);
+                if (k.default_only && id === 'overrideManual') msgs.push(['warn', at + 'RustDesk says to put <code>' + esc(p.key) + '</code> in Default settings.']);
+                if (id === 'defaultManual' && otherKeys.has(p.key)) msgs.push(['info', at + '<code>' + esc(p.key) + '</code> is also in Override settings, which wins.']);
+            }
+            document.getElementById('rd-lint-' + id).innerHTML = msgs.map(m => '<div class="' + m[0] + '">' + m[1] + '</div>').join('');
+        }
+    }
+    function add(id, k, button) {   // the dialog stays open, so several options can be added in a row
+        const box = document.getElementById('id_' + id);
+        box.value = box.value.replace(/\s*$/, '') + (box.value.trim() ? '\n' : '') + k.key + '=' + k.insert;
+        lint();
+        const label = button.textContent;
+        button.textContent = 'Added';
+        button.classList.add('done');
+        setTimeout(() => { button.textContent = label; button.classList.remove('done'); }, 1200);
+    }
+    const setByForm = k => own(data.controls, k.key) !== undefined;
+    function render() {
+        const f = filter.value.toLowerCase();
+        const all = document.getElementById('rd-ref-all').checked;
+        const body = document.getElementById('rd-ref-body');
+        body.innerHTML = '';
+        for (const k of data.keys) {
+            const control = own(data.controls, k.key);
+            if (control && !all) continue;
+            const hay = (k.key + ' ' + k.group + ' ' + k.description + ' ' + (control || '')).toLowerCase();
+            if (f && !hay.includes(f)) continue;
+            const tr = document.createElement('tr');
+            const tag = kindLabel[k.kind] ? ' &middot; ' + kindLabel[k.kind] : '';
+            tr.innerHTML = '<td><code>' + esc(k.key) + '</code><br><span class="tag">' + esc(k.group) + tag + '</span></td>' +
+                '<td>' + esc(k.values) + (k.default ? '<br><span class="tag">default ' + esc(k.default) + '</span>' : '') + '</td>' +
+                '<td>' + esc(k.description) + (control ? '<br><span class="set">Set above by "' + esc(control) + '"</span>' : '') +
+                (k.default_only ? '<br><span class="tag">Use in Default settings only.</span>' : '') + '</td>' +
+                '<td></td>';
+            for (const id in boxes) {
+                if (id === 'overrideManual' && k.default_only) continue;
+                const b = document.createElement('button');
+                b.type = 'button';
+                b.textContent = id === 'defaultManual' ? 'Default' : 'Override';
+                b.title = 'Add ' + k.key + ' to ' + boxes[id];
+                b.addEventListener('click', () => add(id, k, b));
+                tr.lastChild.appendChild(b);
+            }
+            body.appendChild(tr);
+        }
+    }
+    const filter = document.getElementById('rd-ref-filter');
+    const dialog = document.getElementById('rd-ref-dialog');
+    const setCount = data.keys.filter(setByForm).length;
+    document.getElementById('rd-ref-set-count').textContent = setCount;
+    document.getElementById('rd-ref-summary').textContent = 'The ' + (data.keys.length - setCount) +
+        ' documented RustDesk options this form has no control for, with what they do; adds a line to either box.';
+    document.getElementById('rd-ref-open').addEventListener('click', () => {
+        if (typeof dialog.showModal === 'function') dialog.showModal(); else dialog.setAttribute('open', '');
+        filter.focus();
+    });
+    document.getElementById('rd-ref-close').addEventListener('click', () => dialog.close ? dialog.close() : dialog.removeAttribute('open'));
+    dialog.addEventListener('keydown', e => {   // Esc closes it, also from the search box (which would only clear)
+        if (e.key === 'Escape') { e.preventDefault(); dialog.close(); }
+    });
+    dialog.addEventListener('click', e => {   // a click on the backdrop closes it
+        const r = dialog.getBoundingClientRect();
+        if (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) dialog.close();
+    });
+    document.getElementById('rd-ref-all').addEventListener('change', render);
+    filter.addEventListener('input', render);
+    filter.addEventListener('keydown', e => { if (e.key === 'Enter') e.preventDefault(); });   // not "Generate"
+    for (const el of document.querySelectorAll('#id_permissionsDorO, #id_themeDorO, input[name="direction"]'))
+        el.addEventListener('change', lint);
+    for (const id in boxes) document.getElementById('id_' + id).addEventListener('input', lint);
+    // "Load Configuration" fills the boxes without firing input events
+    let last = '';
+    setInterval(() => {
+        const now = document.getElementById('id_defaultManual').value + '\0' + document.getElementById('id_overrideManual').value;
+        if (now !== last) { last = now; lint(); }
+    }, 1000);
+    render();
+    lint();
+})();
+</script>
