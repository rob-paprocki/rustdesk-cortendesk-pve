diff --git a/rdgen/settings.py b/rdgen/settings.py
index 2df970c..9cceab5 100644
--- a/rdgen/settings.py
+++ b/rdgen/settings.py
@@ -129,7 +129,16 @@ RDGEN_DEFAULTS = {
     'api_server': env('RDGEN_DEFAULT_API_SERVER', ''),
     'key': env('RDGEN_DEFAULT_KEY', ''),
     'key_file': env('RDGEN_DEFAULT_KEY_FILE', ''),
+    'port': env('RDGEN_DEFAULT_PORT', ''),
+    'url_link': env('RDGEN_DEFAULT_URL_LINK', ''),
+    'download_link': env('RDGEN_DEFAULT_DOWNLOAD_LINK', ''),
+    'company': env('RDGEN_DEFAULT_COMPANY', ''),
 }
+# Base of the self-update links for Windows builds, e.g. https://console.example.com/clients (the console answers
+# /clients/<arch>/<version>/<name>.exe). Empty: the form does not suggest an update URL.
+RDGEN_UPDATE_BASE = env('RDGEN_UPDATE_BASE', '').strip().rstrip('/')
+if RDGEN_UPDATE_BASE and not re.fullmatch(r'https?://[A-Za-z0-9.:\[\]-]+(?:/[A-Za-z0-9._~/-]*)?', RDGEN_UPDATE_BASE):
+    raise ImproperlyConfigured('RDGEN_UPDATE_BASE must be an http(s) URL without a query string')
 
