+
+
+# --- recent builds and share links ---------------------------------------------------------------
+
+PLATFORM_NAMES = {'windows': 'Windows 64-bit', 'windows-x86': 'Windows 32-bit', 'linux': 'Linux',
+                  'android': 'Android', 'macos': 'macOS'}
+SHARE_DAYS = (1, 7, 30)
+TOKEN_RE = re.compile(r'[A-Za-z0-9_-]{43}')
+ACTIVE_STATES = {'queued', 'in_progress', 'waiting', 'requested', 'pending'}
+
+
+def build_expires_at(gh_run):
+    """When the poller deletes the build and its files (prune_local)."""
+    return gh_run.created_at + timedelta(days=_settings.RDGEN_RETENTION_DAYS)
+
+
+def share_url(request, link):
+    if _settings.RDGEN_SHARE_BASE:
+        return f'{_settings.RDGEN_SHARE_BASE}/{link.token}'
+    return request.build_absolute_uri(reverse('share', args=[link.token]))
+
+
+def _builds_redirect(gh_run, new=None):
+    query = f'?new={new}' if new else ''
+    return redirect(reverse('builds') + query + (f'#b-{gh_run.uuid}' if gh_run else ''))
+
+
+@require_http_methods(['GET', 'POST'])
+def builds_view(request):
+    """The builds of the last RDGEN_RETENTION_DAYS, their files and their share links."""
+    now = timezone.now()
+    if request.method == 'POST':
+        action = request.POST.get('action', '')
+        if action == 'share':
+            uuid_val = request.POST.get('uuid', '')
+            gh_run = GithubRun.objects.filter(uuid=uuid_val).first() if valid_uuid(uuid_val) else None
+            if gh_run is None or gh_run.status != 'success' or not build_files(gh_run):
+                raise Http404("Not found")
+            try:
+                days = int(request.POST.get('days', '7'))
+            except ValueError:
+                days = 7
+            if days not in SHARE_DAYS:
+                days = 7
+            # a link never outlives the files it points at
+            expires = min(now + timedelta(days=days), build_expires_at(gh_run))
+            if expires <= now + timedelta(minutes=5):
+                raise Http404("Not found")
+            link = ShareLink.objects.create(build=gh_run, token=secrets.token_urlsafe(32), expires_at=expires,
+                                            created_by=request.user.get_username())
+            return _builds_redirect(gh_run, link.id)
+        if action == 'delete_link':
+            link_id = request.POST.get('link', '')
+            link = ShareLink.objects.select_related('build').filter(pk=int(link_id)).first() if link_id.isdigit() else None
+            if link is None:
+                raise Http404("Not found")
+            gh_run = link.build
+            link.delete()
+            return _builds_redirect(gh_run)
+        raise Http404("Not found")
+
+    try:
+        new = int(request.GET.get('new', ''))
+    except ValueError:
+        new = None
+    since = now - timedelta(days=_settings.RDGEN_RETENTION_DAYS)
+    rows = []
+    for gh_run in GithubRun.objects.filter(created_at__gte=since).order_by('-created_at')[:200]:
+        state = 'ready' if gh_run.status == 'success' else ('failed' if gh_run.is_terminal else 'building')
+        links = [{'id': link.id, 'url': share_url(request, link), 'expires_at': link.expires_at,
+                  'downloads': link.downloads, 'last_download_at': link.last_download_at,
+                  'created_by': link.created_by, 'new': link.id == new}
+                 for link in gh_run.share_links.filter(expires_at__gt=now).order_by('-created_at')]
+        rows.append({
+            'run': gh_run,
+            'name': gh_run.label or gh_run.filename,
+            'platform': PLATFORM_NAMES.get(gh_run.platform, gh_run.platform),
+            'state': state,
+            'files': build_files(gh_run) if state == 'ready' else [],
+            'status_url': reverse('check_for_file') + '?' + urlencode({'uuid': gh_run.uuid}),
+            'expires_at': build_expires_at(gh_run),
+            'links': links,
+            'can_share': state == 'ready' and build_expires_at(gh_run) > now + timedelta(minutes=5),
+        })
+    return render(request, 'builds.html', {
+        'rows': rows,
+        'share_days': SHARE_DAYS,
+        'retention_days': _settings.RDGEN_RETENTION_DAYS,
+        'share_base': _settings.RDGEN_SHARE_BASE,
+        'publish_target': _settings.RDGEN_PUBLISH_TARGET,
+        'publish_on': bool(_settings.RDGEN_PUBLISH_DEFAULT),
+    })
+
+
+def _active_link(token):
+    if not TOKEN_RE.fullmatch(token or ''):
+        return None
+    link = ShareLink.objects.select_related('build').filter(token=token).first()
+    if link is None or not link.is_active:
+        return None
+    return link
+
+
+def _private(response):
+    """Headers for the public share pages: not cached, not indexed, and the token never leaks as a referrer."""
+    response['Cache-Control'] = 'no-store, private'
+    response['X-Robots-Tag'] = 'noindex, nofollow'
+    response['Referrer-Policy'] = 'no-referrer'
+    response['X-Content-Type-Options'] = 'nosniff'
+    return response
+
+
+@login_not_required
+@require_safe
+def share_view(request, token):
+    """Public: the files of a shared build. Unknown, expired and deleted links all look the same."""
+    link = _active_link(token)
+    if link is None:
+        return _private(render(request, 'share.html', {'gone': True}, status=404))
+    files = [{'name': f['name'], 'size': f['size'], 'sha256': f['sha256'],
+              'url': reverse('share_file', args=[token, f['name']])}
+             for f in build_files(link.build) if stored_file(link.build, f['name'])]
+    return _private(render(request, 'share.html', {
+        'name': link.build.label or link.build.filename,
+        'platform': PLATFORM_NAMES.get(link.build.platform, link.build.platform),
+        'version': link.build.version,
+        'files': files,
+        'expires_at': link.expires_at,
+    }))
+
+
+@login_not_required
+@require_safe
+def share_file_view(request, token, filename):
+    link = _active_link(token)
+    path = stored_file(link.build, filename) if link else None
+    if path is None:
+        return _private(render(request, 'share.html', {'gone': True}, status=404))
+    if request.method == 'GET':
+        ShareLink.objects.filter(pk=link.pk).update(downloads=F('downloads') + 1, last_download_at=timezone.now())
+    return _private(FileResponse(open(path, 'rb'), as_attachment=True, filename=filename,
+                                 content_type='application/octet-stream'))
