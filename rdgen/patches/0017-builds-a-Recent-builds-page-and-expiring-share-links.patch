+                            {% for d in share_days %}<option value="{{ d }}"{% if d == 7 %} selected{% endif %}>{{ d }} day{{ d|pluralize }}</option>{% endfor %}
+                        </select>
+                    </form>
+                    <p class="note">Links end when the build is deleted (<time datetime="{{ row.expires_at|date:'c' }}" data-date>{{ row.expires_at|date:'Y-m-d' }}</time>) at the latest.</p>
+                    {% if row.run.has_password %}
+                        <p class="warn">Anyone who gets the link can download this client and read the password inside it, until the link expires or you delete it. Send it only to the person who installs it.</p>
+                    {% endif %}
+                {% endif %}
+            </div>
+        {% else %}
+            <p class="note">
+                {% if row.state == 'failed' %}The build ended with status "{{ row.run.status }}".{% else %}Still building.{% endif %}
+                <a href="{{ row.status_url }}">Status page</a>{% if row.run.html_url %} &middot; <a href="{{ row.run.html_url }}" target="_blank" rel="noopener">GitHub log</a>{% endif %}
+            </p>
