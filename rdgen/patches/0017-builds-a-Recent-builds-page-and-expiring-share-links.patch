@@ -0,0 +1,166 @@
+"""Recent builds page and private share links (/builds, /share/<token>)."""
+import hashlib
+import re
+import tempfile
+import uuid
+from datetime import timedelta
+from pathlib import Path
+
+from django.contrib.auth import get_user_model
+from django.test import Client, TestCase, override_settings
+from django.utils import timezone
+
+from rdgenerator.models import GithubRun, ShareLink
+from rdgenerator.poller import prune_local
+
+EXE = b'MZ' + b'\0' * 200
+
+
+class ShareTests(TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.override = override_settings(ARTIFACT_ROOT=self.tmp.name, DATA_DIR=Path(self.tmp.name),
+                                          RDGEN_RETENTION_DAYS=30, RDGEN_SHARE_BASE='')
+        self.override.enable()
+        self.c = Client()
+        self.c.force_login(get_user_model().objects.create_user('tester', password='x' * 16))
+        self.anon = Client()
+
+    def tearDown(self):
+        self.override.disable()
+        self.tmp.cleanup()
+
+    def run_with_file(self, status='success', **kw):
+        u = str(uuid.uuid4())
+        d = Path(self.tmp.name) / u
+        d.mkdir()
+        (d / 'acme_client.exe').write_bytes(EXE)
+        kw.setdefault('label', 'Acme Support')
+        return GithubRun.objects.create(
+            uuid=u, status=status, platform='windows', filename='acme_client', version='1.4.9',
+            files=[{'name': 'acme_client.exe', 'size': len(EXE), 'sha256': hashlib.sha256(EXE).hexdigest()}], **kw)
+
+    def share(self, run, days='7'):
+        r = self.c.post('/builds', {'action': 'share', 'uuid': run.uuid, 'days': days})
+        self.assertEqual(r.status_code, 302, r.content)
+        return ShareLink.objects.filter(build=run).latest('id')
+
+    def test_builds_page_needs_a_login(self):
+        r = self.anon.get('/builds')
+        self.assertEqual(r.status_code, 302)
+        self.assertIn('/accounts/login/', r['Location'])
+
+    def test_builds_page_lists_files_states_and_password_builds(self):
+        ok = self.run_with_file(has_password=True)
+        GithubRun.objects.create(uuid=str(uuid.uuid4()), status='failure', platform='linux', filename='x', label='Broken')
+        GithubRun.objects.create(uuid=str(uuid.uuid4()), status='in_progress', platform='macos', filename='y', label='Busy')
+        page = self.c.get('/builds').content.decode()
+        self.assertIn('Acme Support', page)
+        self.assertIn(f'/download?uuid={ok.uuid}&amp;filename=acme_client.exe', page)
+        self.assertIn('password inside', page)
+        self.assertIn('read the password inside it', page)
+        self.assertEqual(page.count('name="action" value="share"'), 1)   # only the finished build
+        self.assertIn('Broken', page)
+        self.assertIn('Still building.', page)
+        self.assertIn('Recent builds', self.c.get('/').content.decode())
+
+    def test_share_link_downloads_without_a_login(self):
+        run = self.run_with_file()
+        link = self.share(run)
+        self.assertRegex(link.token, r'^[A-Za-z0-9_-]{43}$')
+        self.assertAlmostEqual((link.expires_at - timezone.now()).total_seconds(), 7 * 86400, delta=60)
+        page = self.anon.get(f'/share/{link.token}')
+        self.assertEqual(page.status_code, 200)
+        body = page.content.decode()
+        self.assertIn('Acme Support', body)
+        self.assertIn(f'/share/{link.token}/acme_client.exe', body)
+        self.assertNotIn('/download?', body)
+        self.assertNotIn('/builds', body)
+        self.assertEqual(page['Cache-Control'], 'no-store, private')
+        self.assertEqual(page['Referrer-Policy'], 'no-referrer')
+        self.assertIn('noindex', page['X-Robots-Tag'])
+        self.assertNotIn('sessionid', page.cookies)
+        f = self.anon.get(f'/share/{link.token}/acme_client.exe')
+        self.assertEqual(f.status_code, 200)
+        self.assertEqual(b''.join(f.streaming_content), EXE)
+        self.assertIn('attachment', f['Content-Disposition'])
+        self.anon.head(f'/share/{link.token}/acme_client.exe')
+        link.refresh_from_db()
+        self.assertEqual(link.downloads, 1)   # HEAD does not count
+        self.assertIsNotNone(link.last_download_at)
+        # the logged-in list shows the full link and the count
+        page = self.c.get('/builds').content.decode()
+        self.assertIn(f'http://testserver/share/{link.token}', page)
+        self.assertIn('downloaded 1 time', page)
+
+    def test_share_base_gives_public_links(self):
+        run = self.run_with_file()
+        link = self.share(run)
+        with override_settings(RDGEN_SHARE_BASE='https://console.example.com/share'):
+            page = self.c.get('/builds').content.decode()
+        self.assertIn(f'value="https://console.example.com/share/{link.token}"', page)
+
+    def test_link_never_outlives_the_build(self):
+        run = self.run_with_file()
+        GithubRun.objects.filter(pk=run.pk).update(created_at=timezone.now() - timedelta(days=28))
+        link = self.share(run, days='30')
+        self.assertAlmostEqual((link.expires_at - timezone.now()).total_seconds(), 2 * 86400, delta=60)
+        link = self.share(run, days='999')   # not a choice: 7 days, still capped
+        self.assertAlmostEqual((link.expires_at - timezone.now()).total_seconds(), 2 * 86400, delta=60)
+
+    def test_dead_links_all_look_the_same(self):
+        run = self.run_with_file()
+        expired = self.share(run)
+        ShareLink.objects.filter(pk=expired.pk).update(expires_at=timezone.now() - timedelta(seconds=1))
+        deleted = self.share(run)
+        r = self.c.post('/builds', {'action': 'delete_link', 'link': str(deleted.id)})
+        self.assertEqual(r.status_code, 302)
+        live = self.share(run)
+        for path in (f'/share/{expired.token}', f'/share/{expired.token}/acme_client.exe',
+                     f'/share/{deleted.token}', f'/share/{"A" * 43}',
+                     f'/share/{live.token}/acme_client.msi', f'/share/{live.token}/..%2Facme_client.exe'):
+            r = self.anon.get(path)
+            self.assertEqual(r.status_code, 404, path)
+        self.assertEqual(self.anon.get(f'/share/{live.token}').status_code, 200)
+        self.assertEqual(self.anon.post(f'/share/{live.token}').status_code, 405)
+        # the files are gone (pruned by hand): the page says so, the download is a 404
+        (Path(self.tmp.name) / run.uuid / 'acme_client.exe').unlink()
+        self.assertIn('no longer available', self.anon.get(f'/share/{live.token}').content.decode())
+        self.assertEqual(self.anon.get(f'/share/{live.token}/acme_client.exe').status_code, 404)
+
+    def test_only_finished_builds_can_be_shared(self):
+        failed = self.run_with_file(status='failure')
+        r = self.c.post('/builds', {'action': 'share', 'uuid': failed.uuid, 'days': '7'})
+        self.assertEqual(r.status_code, 404)
+        self.assertEqual(self.c.post('/builds', {'action': 'share', 'uuid': 'nope'}).status_code, 404)
+        self.assertEqual(self.c.post('/builds', {'action': 'delete_link', 'link': 'x'}).status_code, 404)
+        self.assertFalse(ShareLink.objects.exists())
+
+    def test_creating_a_link_needs_the_csrf_token(self):
+        run = self.run_with_file()
+        c = Client(enforce_csrf_checks=True)
+        c.force_login(get_user_model().objects.get(username='tester'))
+        self.assertEqual(c.post('/builds', {'action': 'share', 'uuid': run.uuid}).status_code, 403)
+        page = c.get('/builds').content.decode()
+        token = re.search(r'name="csrfmiddlewaretoken" value="([^"]+)"', page).group(1)
+        r = c.post('/builds', {'action': 'share', 'uuid': run.uuid, 'csrfmiddlewaretoken': token})
+        self.assertEqual(r.status_code, 302)
+
+    def test_anonymous_users_still_cannot_reach_the_rest(self):
+        run = self.run_with_file()
+        self.share(run)
+        for path in ('/', f'/download?uuid={run.uuid}&filename=acme_client.exe', f'/check_for_file?uuid={run.uuid}'):
+            r = self.anon.get(path)
+            self.assertEqual(r.status_code, 302, path)
+            self.assertIn('/accounts/login/', r['Location'])
+
+    def test_prune_drops_expired_links(self):
+        run = self.run_with_file()
+        old, live = self.share(run), self.share(run)
+        ShareLink.objects.filter(pk=old.pk).update(expires_at=timezone.now() - timedelta(minutes=1))
+        prune_local()
+        self.assertEqual(list(ShareLink.objects.values_list('pk', flat=True)), [live.pk])
+        # a pruned build takes its links along
+        GithubRun.objects.filter(pk=run.pk).update(created_at=timezone.now() - timedelta(days=31))
+        prune_local()
+        self.assertFalse(ShareLink.objects.exists())
