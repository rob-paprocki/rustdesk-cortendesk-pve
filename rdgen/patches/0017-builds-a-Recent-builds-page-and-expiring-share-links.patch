diff --git a/rdgenerator/models.py b/rdgenerator/models.py
index 70bb79d..4937a01 100644
--- a/rdgenerator/models.py
+++ b/rdgenerator/models.py
@@ -47,3 +47,22 @@ class GithubRun(models.Model):
     @property
     def is_terminal(self):
         return self.status in TERMINAL_STATUSES
+
+
+class ShareLink(models.Model):
+    """A private, expiring download link for one finished build (/share/<token>, no login).
+
+    Anyone holding the token can fetch the build's files until it expires or is deleted, so the token is long
+    (32 random bytes) and the link never outlives the build itself (RDGEN_RETENTION_DAYS).
+    """
+    build = models.ForeignKey(GithubRun, on_delete=models.CASCADE, related_name='share_links')
+    token = models.CharField(max_length=64, unique=True)
+    created_at = models.DateTimeField(default=timezone.now)
+    expires_at = models.DateTimeField(db_index=True)
+    created_by = models.CharField(max_length=150, blank=True, default='')
+    downloads = models.PositiveIntegerField(default=0)
+    last_download_at = models.DateTimeField(null=True, blank=True)
+
+    @property
+    def is_active(self):
+        return self.expires_at > timezone.now() and self.build.status == 'success'
