+<body>
+<main>
+    <div class="top">
+        <h1>Recent builds</h1>
+        <a href="{% url 'generator' %}">&larr; Back to the builder</a>
+    </div>
+    <p class="lead">
+        Builds from the last {{ retention_days }} days, newest first. After that, rdgen deletes a build and its files.
+        A <b>share link</b> lets someone without a login download a build's files until the link expires, for example
+        a client with a password inside that shouldn't go on a public download page.
+        {% if not share_base %}Share links point at this page's address, so they only work where this page does (usually your LAN).{% endif %}
+    </p>
+
+    {% for row in rows %}
+    <section class="build" id="b-{{ row.run.uuid }}">
+        <div class="head">
+            <span class="name">{{ row.name }}</span>
+            <span class="badge {{ row.state }}">{% if row.state == 'ready' %}ready{% elif row.state == 'failed' %}failed{% else %}building{% endif %}</span>
+            {% if row.run.has_password %}<span class="badge pw" title="A password is built into this client">password inside</span>{% endif %}
+            <span class="meta">{{ row.platform }}{% if row.run.version %} &middot; {{ row.run.version }}{% endif %} &middot; <time datetime="{{ row.run.created_at|date:'c' }}">{{ row.run.created_at|date:'Y-m-d H:i' }} UTC</time></span>
