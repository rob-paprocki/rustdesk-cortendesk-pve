+            {% endfor %}
+            </ul>
+            {% if publish_on and row.run.publish != 'no' %}
+                <p class="note">
+                {% if row.run.publish_state == 'done' %}In {{ publish_target }}'s Client Downloads ({{ row.run.publish }}).
+                {% elif row.run.publish_state == 'failed' %}Adding it to {{ publish_target }}'s Client Downloads failed.
+                {% elif row.run.publish_state == 'skipped' %}Not added to {{ publish_target }}'s Client Downloads.
+                {% else %}Being added to {{ publish_target }}'s Client Downloads ({{ row.run.publish }}).{% endif %}
+                </p>
+            {% endif %}
+
+            <div class="share">
+                {% for link in row.links %}
+                    <div class="link{% if link.new %} new{% endif %}">
+                        <input type="text" readonly value="{{ link.url }}" aria-label="Share link" {% if link.new %}autofocus{% endif %}>
+                        <button type="button" class="quiet" data-copy>Copy</button>
+                        <form method="post" action="{% url 'builds' %}">
+                            {% csrf_token %}
+                            <input type="hidden" name="action" value="delete_link">
+                            <input type="hidden" name="link" value="{{ link.id }}">
+                            <button type="submit" class="quiet" title="The link stops working at once">Delete link</button>
+                        </form>
+                    </div>
+                    <div class="linkmeta">
+                        Works until <time datetime="{{ link.expires_at|date:'c' }}">{{ link.expires_at|date:'Y-m-d H:i' }} UTC</time>
+                        &middot; downloaded {{ link.downloads }} time{{ link.downloads|pluralize }}{% if link.last_download_at %}, last <time datetime="{{ link.last_download_at|date:'c' }}">{{ link.last_download_at|date:'Y-m-d H:i' }} UTC</time>{% endif %}
+                    </div>
+                {% endfor %}
+                {% if row.can_share %}
+                    <form method="post" action="{% url 'builds' %}">
+                        {% csrf_token %}
+                        <input type="hidden" name="action" value="share">
+                        <input type="hidden" name="uuid" value="{{ row.run.uuid }}">
+                        <button type="submit">{% if row.links %}New share link{% else %}Create share link{% endif %}</button>
+                        valid for
