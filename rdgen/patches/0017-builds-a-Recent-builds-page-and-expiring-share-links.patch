+        .link input { flex: 1 1 320px; min-width: 0; background: #1a1a1a; color: #fff; border: 1px solid #444; border-radius: 4px; padding: 6px 8px; font-family: ui-monospace, Menlo, Consolas, monospace; font-size: .82em; }
