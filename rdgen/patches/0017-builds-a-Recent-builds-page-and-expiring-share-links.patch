+        h1 { font-size: 1.3em; margin: 0 0 4px; word-break: break-word; }
+        .meta { color: var(--muted); font-size: .9em; margin: 0 0 18px; }
+        a.file { display: block; text-decoration: none; background: var(--accent); color: #fff; border-radius: 8px; padding: 12px 14px; margin: 10px 0 2px; font-weight: 600; word-break: break-all; }
+        a.file:hover { filter: brightness(1.08); }
+        .sum { color: var(--muted); font-size: .75em; word-break: break-all; margin-bottom: 10px; }
+        .foot { color: var(--muted); font-size: .82em; margin-top: 18px; }
+    </style>
+</head>
+<body>
+<main>
+{% if gone %}
+    <h1>This link isn't available</h1>
+    <p class="meta">It may have expired or been deleted. Ask the person who sent it for a new one.</p>
+{% else %}
+    <h1>{{ name }}</h1>
+    <p class="meta">{{ platform }}{% if version %} &middot; RustDesk {{ version }}{% endif %}</p>
+    {% for f in files %}
+        <a class="file" href="{{ f.url }}">Download {{ f.name }}</a>
+        <div class="sum">{{ f.size|filesizeformat }} &middot; SHA-256 {{ f.sha256 }}</div>
+    {% empty %}
+        <p class="meta">The files are no longer available.</p>
+    {% endfor %}
+    <p class="foot">This link works until <time datetime="{{ expires_at|date:'c' }}">{{ expires_at|date:'Y-m-d H:i' }} UTC</time>.</p>
+{% endif %}
+</main>
+<script>
+    document.querySelectorAll('time[datetime]').forEach(function (t) {
+        var d = new Date(t.getAttribute('datetime'));
+        if (!isNaN(d)) t.textContent = d.toLocaleString([], {dateStyle: 'medium', timeStyle: 'short'});
+    });
+</script>
+</body>
+</html>
