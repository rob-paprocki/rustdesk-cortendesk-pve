--- a/rdgenerator/tests/test_ui.py
+++ b/rdgenerator/tests/test_ui.py
@@ -157,12 +157,22 @@ class LinuxAppNameTests(StubTestCase):
         self.assertEqual(GithubRun.objects.latest('id').label, 'Rescue Client (Rob Paprocki)')
 
     def test_other_platforms_keep_the_name(self):
-        s = self.secrets(platform='macos', appname='Rescue Client (Rob Paprocki)')
-        # upstream (073447b) builds with the name itself: spaces and : | \ / are dropped, the custom
-        # app-name keeps the name as typed
+        s = self.secrets(platform='android', appname='Rescue Client (Rob Paprocki)')
+        # upstream (073447b) builds with the name itself: spaces and : | \ / are dropped; custom.txt shows it as typed
         self.assertEqual(s['appname'], 'RescueClient(RobPaprocki)')
         self.assertEqual(json.loads(base64.b64decode(s['custom']))['app-name'], 'Rescue Client (Rob Paprocki)')
 
+    def test_macos_build_runs_under_its_bundle_name(self):
+        # the bundle is <appname>.app; RustDesk on macOS looks for /Applications/<app-name>.app and pastes the name
+        # into /bin/sh: one shell-safe name, spaces as hyphens as before 073447b (a rebuild replaces the installed app)
+        for typed, name in (('Acme Support (Mac)', 'Acme-Support-Mac'), ('Acme Support', 'Acme-Support'),
+                            ('Acme_Remote.v2', 'Acme_Remote.v2'), ('Acme+Co, Ltd', 'Acme-Co-Ltd')):
+            s = self.secrets(platform='macos', appname=typed)
+            custom = json.loads(base64.b64decode(s['custom']))
+            self.assertEqual((s['appname'], custom['app-name']), (name, name), typed)
+        from rdgenerator.models import GithubRun
+        self.assertEqual(GithubRun.objects.latest('id').label, 'Acme+Co, Ltd')
+
     def test_default_and_already_safe_names_unchanged(self):
         self.assertEqual(self.secrets(platform='linux')['appname'], 'rustdesk')
         self.assertEqual(self.secrets(platform='linux', appname='acme-remote')['appname'], 'acme-remote')
diff --git a/rdgenerator/validation.py b/rdgenerator/validation.py
index 1057daf..416011e 100644
--- a/rdgenerator/validation.py
+++ b/rdgenerator/validation.py
@@ -72,6 +72,20 @@ def linux_reserved_names():
         return frozenset(line.strip() for line in fh if line.strip() and not line.startswith('#'))
 
 
+def mac_app_name(name):
+    """The app name a macOS build gets: letters, digits and . _ -, other characters become hyphens.
+
+    RustDesk on macOS runs under custom.txt's app-name, looks for itself at
+    /Applications/<name>.app/Contents/MacOS/<name> (is_installed, its service,
+    its updater), pastes the name unquoted into /bin/sh (daemon plist, install
+    script) and updates only [A-Za-z0-9._-] names; the workflow names the bundle
+    after the build name. Spaces become hyphens as before upstream 073447b, so a
+    rebuilt client replaces the installed one: "Acme Support (Mac)" becomes
+    "Acme-Support-Mac".
+    """
+    return re.sub(r'[^A-Za-z0-9._-]+', '-', name or '').strip('-') or 'rustdesk'
+
+
 def linux_app_name_problem(name):
     """Why a Linux build cannot use this app name, or ''. A blank name means the default (rustdesk)."""
     if not (name or '').strip():
