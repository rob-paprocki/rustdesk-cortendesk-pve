+    def test_macos_signing_and_xcode_27_on_a_mac_of_your_own(self):
+        with open(os.path.join(WORKFLOWS, 'generator-macos.yml'), encoding='utf-8') as fh:
+            text = fh.read()
+
+        def step(name):
+            return text.split(f'- name: {name}', 1)[1].split('\n      - name:', 1)[0]
+        names = re.findall(r'^\s*- name: (.+?)\s*$', text, re.M)
+        self.assertEqual(names[names.index('Prepare a self-hosted Mac') + 1], 'Match the deployment target to this Xcode')
+        # a LaunchDaemon runner signs only with Apple's G2 intermediate in the System keychain: checked before building
+        prep = step('Prepare a self-hosted Mac')
+        self.assertIn('SHA-256 hash: F16CD3C54C7F83CEA4BF1A3E6A0819C8AAA8E4A1528FD144715F350643D2DF3A', prep)
+        self.assertIn('sudo security add-certificates -k /Library/Keychains/System.keychain', prep)
+        # the keychain is recorded before anything can fail, so the cleanup always finds it
+        sign = step('Sign the app with the Developer ID')
+        self.assertLess(sign.index('echo "RDGEN_KEYCHAIN=$kc"'), sign.index('security import'))
+        self.assertEqual(sign.count('RDGEN_KEYCHAIN='), 1)
+        keychain = step('Remove the signing keychain')
+        self.assertIn('security delete-keychain "$RDGEN_KEYCHAIN"', keychain)
+        self.assertIn('security list-keychains -d user -s ${keep[@]+"${keep[@]}"}', keychain)
+        # Xcode 27 gets the deployment target it supports; older Xcode keeps RustDesk's
+        body = step('Match the deployment target to this Xcode').split('run: |\n', 1)[1]
+        script = []
+        for line in body.splitlines():   # the run block ends at the first line indented less (the next step)
+            if line.strip() and not line.startswith(' ' * 10):
+                break
+            script.append(line[10:])
+        script = '\n'.join(script)
+        for version, expected in (('16.4', ''), ('27.2', 'FLUTTER_XCODE_MACOSX_DEPLOYMENT_TARGET=12.0\n')):
+            with tempfile.TemporaryDirectory() as tmp:
+                fake = os.path.join(tmp, 'xcodebuild')
+                with open(fake, 'w', encoding='utf-8') as fh:
+                    fh.write(f'#!/bin/sh\necho "Xcode {version}"\necho "Build version 0"\n')
+                os.chmod(fake, 0o755)
+                env_file = os.path.join(tmp, 'github_env')
+                open(env_file, 'w', encoding='utf-8').close()
+                r = subprocess.run(['bash', '--noprofile', '--norc', '-eo', 'pipefail', '-c', script], cwd=tmp,
+                                   env=dict(os.environ, PATH=tmp + os.pathsep + os.environ.get('PATH', ''),
+                                            GITHUB_ENV=env_file), capture_output=True, text=True)
+                self.assertEqual(r.returncode, 0, r.stderr)
+                with open(env_file, encoding='utf-8') as fh:
+                    self.assertEqual(fh.read(), expected, version)
+
