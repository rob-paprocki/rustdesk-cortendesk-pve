diff --git a/rdgenerator/templates/_api_server.html b/rdgenerator/templates/_api_server.html
new file mode 100644
index 0000000..41a843b
--- /dev/null
+++ b/rdgenerator/templates/_api_server.html
@@ -0,0 +1,61 @@
+<div id="rd-api-http" class="rd-api-warn" hidden>
+    This API server starts with <code>http://</code>. Clients check in, sign in and load their address book here.
+    Behind Cloudflare or another proxy that redirects <code>http</code> to <code>https</code>, none of that arrives:
+    a client can't follow the redirect, so it never shows up under Devices or reports its status. Use
+    <code>https://</code>. A LAN address the clients reach directly, without a proxy, can stay <code>http://</code>.
+</div>
+<style>
+    .rd-api-warn { margin:-4px 0 8px; padding:6px 8px; border-radius:4px; background:#2a1515; color:#ffb4ac;
+                   font-size:.85em; line-height:1.4; }
+    .rd-api-warn code { background:#222; padding:0 3px; border-radius:3px; }
+</style>
+<script>
+(function () {
+    var input = document.getElementById('{{ form.apiServer.id_for_label }}');
+    var warn = document.getElementById('rd-api-http');
+    if (!input || !warn) return;
+    function check() {
+        var m = /^http:\/\/([^\/:?#]+)/i.exec(input.value.trim());
+        // IP addresses and LAN-only names are usually reached directly, with no redirecting proxy in between
+        var lan = m && (/^\d{1,3}(\.\d{1,3}){3}$/.test(m[1]) ||
+                        /^(localhost|[^.]+|.+\.(lan|local|home\.arpa|internal|localdomain))$/i.test(m[1]));
+        warn.hidden = !m || lan;
+    }
+    input.addEventListener('input', check);
+    input.addEventListener('change', check);
+    check();
+})();
+</script>
+<style>
+    .rd-pw-warn { margin:-4px 0 8px; padding:6px 8px; border-radius:4px; background:#2a2410; color:#ffd58a;
+                  font-size:.85em; line-height:1.4; }
+</style>
+<script>
+document.addEventListener('DOMContentLoaded', function () {
+    var pw = document.getElementById('{{ form.permanentPassword.id_for_label }}');
+    var mode = document.getElementById('{{ form.passApproveMode.id_for_label }}');
+    var note = document.getElementById('rd-pw-note');
+    if (!pw || !mode || !note) return;
+    function direction() {
+        var r = document.querySelector('input[name="{{ form.direction.html_name }}"]:checked');
+        return r ? r.value : '';
+    }
+    function check() {
+        var text = '';
+        if (pw.value && direction() === 'outgoing') {
+            text = 'An Outgoing Only client cannot be connected to, so this password is never used.';
+        } else if (pw.value && mode.value === 'click') {
+            text = 'With approve mode "via click" the password is ignored: someone has to click Accept every time.';
+        } else if (!pw.value && direction() !== 'outgoing' && mode.value !== 'click') {
+            text = 'Without a permanent password, connecting to this client always needs its one-time password or an Accept click.';
+        }
+        note.textContent = text;
+        note.hidden = !text;
+    }
+    [pw, mode].forEach(function (el) { el.addEventListener('input', check); el.addEventListener('change', check); });
+    document.querySelectorAll('input[name="{{ form.direction.html_name }}"]').forEach(function (el) {
+        el.addEventListener('change', check);
+    });
+    check();
+});
+</script>
diff --git a/rdgenerator/templates/_build_cost.html b/rdgenerator/templates/_build_cost.html
new file mode 100644
index 0000000..9265a84
--- /dev/null
+++ b/rdgenerator/templates/_build_cost.html
@@ -0,0 +1,29 @@
+<div id="rd-cost-note" class="rd-hint" aria-live="polite"></div>
+<script>
+(function () {
+    // what a build costs in GitHub Actions minutes in a private repo (measured on real builds; the Free plan
+    // includes 2,000 minutes a month, and GitHub counts Windows minutes 2x and Mac minutes 10x)
+    var notes = {
+        'macos': 'GitHub Actions cost: a Mac build runs two Mac machines (Intel and Apple Silicon) for 30-40 minutes, '
+               + 'and GitHub counts Mac minutes ten times. One build uses roughly 600-700 of the 2,000 minutes a month '
+               + 'the Free plan includes, so build Macs only when you need to, and set an Actions budget on GitHub.',
+        'windows': 'GitHub Actions cost: about 100 minutes per build (Windows minutes count double).',
+        'windows-x86': 'GitHub Actions cost: about 100 minutes per build (Windows minutes count double).',
+        'linux': 'GitHub Actions cost: about 100 minutes per build (an x86_64 and an ARM Linux machine).'
+    };
+    var select = document.getElementById('id_platform');
+    var note = document.getElementById('rd-cost-note');
+    if (!select || !note) return;
+    function show() {
+        var text = notes[select.value] || '';
+        note.textContent = text;
+        note.style.color = select.value === 'macos' ? '#ffd58a' : '';
+        note.hidden = !text;
+    }
+    select.addEventListener('change', show);
+    document.querySelectorAll('.platform-icon').forEach(function (i) {
+        i.addEventListener('click', function () { setTimeout(show, 0); });
+    });
+    show();
+})();
+</script>
