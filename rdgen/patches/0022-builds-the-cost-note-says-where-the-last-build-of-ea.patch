+# the small jobs every build has (encrypted settings, the Flutter/Rust bridge, cleanup), apart from the build itself
+HELPER_JOBS = ('setup', 'generate-bridge', 'cleanup', 'deploy')
+MAC_JOB_ARCH = (('x86_64-apple-darwin', 'x86_64'), ('aarch64-apple-darwin', 'aarch64'))
+
+
+def last_runners(limit=50):
+    """Where the last completed build of each kind ran, from the jobs the poller recorded (GithubRun.runners):
+    {key: {'own': [runner names of yours], 'hosted': ran on GitHub's machines}} with the keys windows,
+    windows-x86, linux, android, macos-x86_64, macos-aarch64 (the build jobs) and helpers (the small jobs)."""
+    out = {}
+    for build in GithubRun.objects.filter(completed_at__isnull=False).order_by('-completed_at')[:limit]:
+        groups = {}
+        for job in build.runners or []:
+            name = str(job.get('job', ''))
+            if name.startswith(HELPER_JOBS):
+                key = 'helpers'
+            elif build.platform == 'macos':
+                key = next((f'macos-{arch}' for part, arch in MAC_JOB_ARCH if part in name), '')
+            else:
+                key = build.platform
+            if key:
+                groups.setdefault(key, []).append(job)
+        for key, jobs in groups.items():
+            if key not in out:
+                out[key] = {'own': sorted({str(j.get('runner', '')) for j in jobs if not j.get('hosted')}),
+                            'hosted': any(j.get('hosted') for j in jobs)}
+    return out
+
