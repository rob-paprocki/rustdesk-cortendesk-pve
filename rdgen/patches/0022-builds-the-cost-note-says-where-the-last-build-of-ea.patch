@@ -163,6 +163,27 @@ def delete_run(gh, run_id):
     gh.request('DELETE', gh.repo_path(f'/actions/runs/{int(run_id)}'), ok=(204, 404))
 
 
+# GitHub's own machines sit in this runner group (and are named "GitHub Actions <n>"); a runner of yours is in its
+# own group, Default unless you made one
+GITHUB_RUNNER_GROUP = 'GitHub Actions'
+
+
+def list_job_runners(gh, run_id):
+    """[{'job', 'runner', 'hosted'}] for the jobs of the run's latest attempt that got a runner (skipped ones never do)."""
+    data = gh.json('GET', gh.repo_path(f'/actions/runs/{int(run_id)}/jobs'), params={'filter': 'latest', 'per_page': 100})
+    jobs = data.get('jobs', [])
+    if not isinstance(jobs, list):
+        raise GitHubError('job list is malformed')
+    out = []
+    for job in jobs:
+        runner = job.get('runner_name') if isinstance(job, dict) else None
+        if not isinstance(runner, str) or not runner:
+            continue
+        hosted = job.get('runner_group_name') == GITHUB_RUNNER_GROUP or runner.startswith(GITHUB_RUNNER_GROUP + ' ')
+        out.append({'job': str(job.get('name', ''))[:120], 'runner': runner[:100], 'hosted': hosted})
+    return out
+
+
 def list_artifacts(gh, run_id):
     data = gh.json('GET', gh.repo_path(f'/actions/runs/{int(run_id)}/artifacts'), params={'per_page': 100})
