+def site_defaults():
+    """Form defaults for this site (RDGEN_DEFAULT_*), e.g. the local hbbs.
+
+    The key is read from RDGEN_DEFAULT_KEY or from the hbbs public key file
+    (RDGEN_DEFAULT_KEY_FILE, e.g. /var/lib/rustdesk-server/id_ed25519.pub).
+    Invalid values are ignored.
+    """
+    values = {
+        'serverIP': _settings.RDGEN_DEFAULTS.get('server', ''),
+        'apiServer': _settings.RDGEN_DEFAULTS.get('api_server', ''),
+        'key': _settings.RDGEN_DEFAULTS.get('key', ''),
+    }
+    key_file = _settings.RDGEN_DEFAULTS.get('key_file', '')
+    if not values['key'] and key_file:
+        try:
+            with open(key_file, encoding='ascii') as fh:
+                values['key'] = fh.read(200).strip()
+        except (OSError, UnicodeDecodeError):
+            values['key'] = ''
+    bad = validate_build_fields(values)
+    return {k: v for k, v in values.items() if v and k not in bad}
