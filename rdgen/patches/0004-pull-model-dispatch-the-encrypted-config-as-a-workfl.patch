diff --git a/rdgenerator/github.py b/rdgenerator/github.py
new file mode 100644
index 0000000..acf114e
--- /dev/null
+++ b/rdgenerator/github.py
@@ -0,0 +1,117 @@
+"""Minimal GitHub REST client for the pull model.
+
+The token (settings.GHBEARER) is only ever placed in the Authorization
+header of requests to settings.GITHUB_API_URL. It is never logged and never
+included in exception messages. Artifact downloads are redirected (302) to
+a short-lived blob URL on another host; requests drops the Authorization
+header on that cross-host redirect, so the token never reaches the blob
+store.
+"""
+import logging
+import re
+
+import requests
+from django.conf import settings
+
+log = logging.getLogger(__name__)
+
+OWNER_RE = re.compile(r'[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})')
+REPO_RE = re.compile(r'[A-Za-z0-9._-]{1,100}')
+
+WORKFLOWS = {
+    'windows': 'generator-windows.yml',
+    'windows-x86': 'generator-windows-x86.yml',
+    'linux': 'generator-linux.yml',
+    'android': 'generator-android.yml',
+    'macos': 'generator-macos.yml',
+}
+
+# Protocol between this server and the workflows in the build repository.
+# Bump when the inputs or the cfg zip layout change; the workflows reject
+# any other value, and GitHub rejects unknown inputs with HTTP 422.
+PULL_PROTOCOL = '1'
+
+
+class GitHubError(Exception):
+    def __init__(self, message, status=None):
+        super().__init__(message)
+        self.status = status
+
+
+def configured():
+    return bool(settings.GHBEARER and settings.GHUSER and settings.REPONAME)
+
+
+class GitHub:
+    def __init__(self, token=None, owner=None, repo=None, api=None, timeout=30):
+        self.token = token if token is not None else settings.GHBEARER
+        self.owner = owner if owner is not None else settings.GHUSER
+        self.repo = repo if repo is not None else settings.REPONAME
+        self.api = (api or settings.GITHUB_API_URL).rstrip('/')
+        self.timeout = timeout
+        if not self.token:
+            raise GitHubError('GitHub token (GHBEARER) is not configured')
+        if not OWNER_RE.fullmatch(self.owner or '') or not REPO_RE.fullmatch(self.repo or ''):
+            raise GitHubError('GHUSER/REPONAME are missing or invalid')
+        self.session = requests.Session()
+        self.session.headers.update({
+            'Accept': 'application/vnd.github+json',
+            'Authorization': f'Bearer {self.token}',
+            'X-GitHub-Api-Version': settings.GITHUB_API_VERSION,
+            'User-Agent': 'rdgen-pull',
+        })
+
+    def repo_path(self, suffix=''):
+        return f'/repos/{self.owner}/{self.repo}{suffix}'
+
+    def request(self, method, path, ok=(200, 201, 202, 204), **kwargs):
+        kwargs.setdefault('timeout', self.timeout)
+        url = self.api + path
+        try:
+            resp = self.session.request(method, url, **kwargs)
+        except requests.RequestException as exc:
+            # str(exc) carries the URL at most, never headers.
+            raise GitHubError(f'{method} {path}: {type(exc).__name__}') from None
+        if resp.status_code not in ok:
+            detail = ''
+            try:
+                body = resp.json()
+                detail = str(body.get('message', ''))[:300]
+            except ValueError:
+                pass
+            raise GitHubError(f'{method} {path}: HTTP {resp.status_code} {detail}'.strip(),
+                              status=resp.status_code)
+        return resp
+
+    def json(self, method, path, **kwargs):
+        resp = self.request(method, path, **kwargs)
+        if resp.status_code == 204 or not resp.content:
+            return {}
+        try:
+            data = resp.json()
+        except ValueError:
+            raise GitHubError(f'{method} {path}: response is not JSON') from None
+        if not isinstance(data, dict):
+            raise GitHubError(f'{method} {path}: unexpected JSON')
+        return data
+
+    # --- dispatch -------------------------------------------------------
+    def dispatch(self, platform, inputs, ref=None):
+        """Start generator-<platform>.yml. Returns (run_id or None, html_url)."""
+        workflow = WORKFLOWS.get(platform)
+        if not workflow:
+            raise GitHubError(f'unknown platform {platform!r}')
+        body = {
+            'ref': ref or settings.GHBRANCH,
+            'inputs': inputs,
+            # Returns the run id (GitHub changelog 2026-02-19); older API
+            # versions answer 204 and the poller finds the run by name.
+            'return_run_details': True,
+        }
+        data = self.json('POST', self.repo_path(f'/actions/workflows/{workflow}/dispatches'),
+                         json=body, ok=(200, 204))
+        run_id = data.get('workflow_run_id')
+        if run_id is not None and not isinstance(run_id, int):
+            run_id = None
+        html_url = data.get('html_url') if isinstance(data.get('html_url'), str) else ''
+        return run_id, html_url
