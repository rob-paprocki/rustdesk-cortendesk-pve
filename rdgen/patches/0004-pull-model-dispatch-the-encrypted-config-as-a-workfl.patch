diff --git a/rdgenerator/buildcfg.py b/rdgenerator/buildcfg.py
new file mode 100644
index 0000000..75a5fe8
--- /dev/null
+++ b/rdgenerator/buildcfg.py
@@ -0,0 +1,135 @@
+"""Pack a build configuration into the `cfg` workflow_dispatch input.
+
+cfg = base64( AES-256 zip( secrets.json + assets/{icon,logo,privacy}.png ) )
+
+GitHub caps a dispatch at 25 inputs and 65,535 characters in total, so the
+PNGs are re-encoded (which also strips metadata and any trailing payload)
+and shrunk step by step until the payload fits. If even the smallest
+level does not fit, the build is refused with a clear message instead of
+silently dropping the images.
+"""
+import base64
+import io
+import json
+import warnings
+
+import pyzipper
+from PIL import Image
+
+# GitHub's documented limit is 65,535 characters for all inputs together.
+# Keep a margin for JSON punctuation/escaping differences on their side.
+INPUTS_MAX_CHARS = 65535
+INPUTS_BUDGET = 65000
+
+MAX_PIXELS = 4096 * 4096
+ASSET_NAMES = ('icon.png', 'logo.png', 'privacy.png')
+
+# (icon max side, logo max side, privacy max side, palette-quantize)
+LEVELS = (
+    (256, 512, 1024, False),
+    (256, 512, 1024, True),
+    (256, 384, 768, True),
+    (192, 256, 512, True),
+    (128, 200, 384, True),
+)
+
+
+class ConfigTooLarge(Exception):
+    pass
+
+
+class BadImage(Exception):
+    pass
+
+
+def load_png(source, name):
+    """Open an uploaded file or a data:image/png;base64 URI as a Pillow image."""
+    if source is None or source == '':
+        return None
+    if isinstance(source, str):
+        prefix = 'data:image/png;base64,'
+        if not source.startswith(prefix):
+            raise BadImage(f'{name}: expected a data:image/png;base64 URI')
+        try:
+            raw = base64.b64decode(source[len(prefix):], validate=True)
+        except ValueError:
+            raise BadImage(f'{name}: invalid base64') from None
+        fh = io.BytesIO(raw)
+    else:
+        source.seek(0)
+        fh = io.BytesIO(source.read())
+        source.seek(0)
+    try:
+        with warnings.catch_warnings():
+            warnings.simplefilter('error', Image.DecompressionBombWarning)
+            img = Image.open(fh)
+            if img.format != 'PNG':
+                raise BadImage(f'{name}: only PNG images are allowed')
+            if img.width * img.height > MAX_PIXELS:
+                raise BadImage(f'{name}: image is larger than {MAX_PIXELS} pixels')
+            img.load()
+    except BadImage:
+        raise
+    except (Image.DecompressionBombWarning, Image.DecompressionBombError):
+        raise BadImage(f'{name}: image is too large') from None
+    except Exception:
+        raise BadImage(f'{name}: not a valid PNG image') from None
+    if img.mode not in ('RGBA', 'RGB', 'LA', 'L', 'P'):
+        img = img.convert('RGBA')
+    elif img.mode == 'P':
+        img = img.convert('RGBA')
+    return img
+
+
+def encode_png(img, max_side, quantize):
+    img = img.copy()
+    if max(img.size) > max_side:
+        img.thumbnail((max_side, max_side), Image.Resampling.LANCZOS)
+    if quantize:
+        img = img.convert('RGBA').quantize(colors=256, method=Image.Quantize.FASTOCTREE,
+                                           dither=Image.Dither.NONE)
+    out = io.BytesIO()
+    img.save(out, format='PNG', optimize=True)
+    return out.getvalue()
+
+
+def build_zip(secrets_dict, assets, password):
+    buf = io.BytesIO()
+    with pyzipper.AESZipFile(buf, 'w', compression=pyzipper.ZIP_LZMA,
+                             encryption=pyzipper.WZ_AES) as zf:
+        zf.setpassword(password.encode('utf-8'))
+        zf.setencryption(pyzipper.WZ_AES, nbits=256)
+        zf.writestr('secrets.json', json.dumps(secrets_dict, separators=(',', ':')))
+        for name, data in assets.items():
+            # PNG is already deflated; LZMA would only add overhead.
+            zf.writestr(f'assets/{name}', data, compress_type=pyzipper.ZIP_STORED)
+    return buf.getvalue()
+
+
+def inputs_size(inputs):
+    return len(json.dumps(inputs, separators=(',', ':')))
+
+
+def pack(secrets_dict, images, password, make_inputs):
+    """Return (inputs, level_used).
+
+    images: {'icon.png': PIL.Image|None, ...}
+    make_inputs: callable(cfg_b64) -> dict of all dispatch inputs
+    """
+    present = {k: v for k, v in images.items() if v is not None}
+    last_size = None
+    for level, (icon_side, logo_side, privacy_side, quantize) in enumerate(LEVELS):
+        sides = {'icon.png': icon_side, 'logo.png': logo_side, 'privacy.png': privacy_side}
+        assets = {name: encode_png(img, sides[name], quantize) for name, img in present.items()}
+        cfg = base64.b64encode(build_zip(secrets_dict, assets, password)).decode('ascii')
+        inputs = make_inputs(cfg)
+        last_size = inputs_size(inputs)
+        if last_size <= INPUTS_BUDGET:
+            return inputs, level
+        if not present:
+            break
+    raise ConfigTooLarge(
+        f'The build configuration is {last_size:,} characters after shrinking the images, '
+        f'but GitHub accepts at most {INPUTS_MAX_CHARS:,} characters of workflow inputs. '
+        'Use simpler PNGs (flat colours, no photos), drop the privacy image, '
+        'or shorten the default/override settings.')
