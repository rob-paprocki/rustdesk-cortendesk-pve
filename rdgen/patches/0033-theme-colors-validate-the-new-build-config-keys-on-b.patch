Subject: [PATCH 33/33] theme colors: validate the new build config keys on
 both sides

Upstream's theme color chooser adds themeColor, themeSurfaceLight,
themeSurfaceDark and themeMeColor to the config. validation.py and the
runner's validate.py now accept only canonical #RRGGBB (or blank), the
form/API tests of upstream's removed tests.py move into the tests package,
and forms.py imports re again (HEX_COLOR_RE).
---
 .github/actions/decrypt-secrets/validate.py |  8 +-
 rdgenerator/forms.py                        |  2 +
 rdgenerator/tests/test_theme.py             | 84 +++++++++++++++++++++
 rdgenerator/tests/test_workflows.py         |  8 +-
 4 files changed, 98 insertions(+), 4 deletions(-)
 create mode 100644 rdgenerator/tests/test_theme.py

diff --git a/.github/actions/decrypt-secrets/validate.py b/.github/actions/decrypt-secrets/validate.py
index f7ff83c..ec1fe7c 100644
--- a/.github/actions/decrypt-secrets/validate.py
+++ b/.github/actions/decrypt-secrets/validate.py
@@ -34,13 +34,19 @@ RULES = {
     'androidappid': r'[A-Za-z][A-Za-z0-9_]{0,40}(?:\.[A-Za-z][A-Za-z0-9_]{0,40}){1,6}',
     'filename': r'[A-Za-z0-9_-]{1,64}',
     'update_public_key': r'(?:[A-Za-z0-9+/]{43}=)?',
+    # Dart 0xAARRGGBB literals (themeColors.py); rdgen sends canonical #RRGGBB or blank.
+    'themeColor': r'(?:#[0-9A-F]{6})?',
+    'themeSurfaceLight': r'(?:#[0-9A-F]{6})?',
+    'themeSurfaceDark': r'(?:#[0-9A-F]{6})?',
+    'themeMeColor': r'(?:#[0-9A-F]{6})?',
 }
 _COMPILED = {k: re.compile(v) for k, v in RULES.items()}
 
 # Not secret, and masking them would blank out common words ("true") or
 # the build id in every log line.
 NOT_SECRET = {'uuid', 'rdgen', 'delayFix', 'xOffline', 'removeNewVersionNotif',
-              'iconlink_url', 'logolink_url', 'privacylink_url'}
+              'iconlink_url', 'logolink_url', 'privacylink_url',
+              'themeColor', 'themeSurfaceLight', 'themeSurfaceDark', 'themeMeColor'}
 
 
 def validate_secrets(data):
