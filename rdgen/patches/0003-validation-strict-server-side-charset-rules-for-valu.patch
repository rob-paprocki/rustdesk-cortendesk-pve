index 0000000..e81fc9f
--- /dev/null
+++ b/rdgenerator/validation.py
@@ -0,0 +1,89 @@
+"""Server-side validation of every value that ends up in a build script.
+
+The generator workflows interpolate these values into bash/pwsh/sed/perl
+commands (`${{ env.appname }}`, `${{ env.urlLink }}`, ...). Only the
+characters listed here are accepted; the decrypt step in the workflow
+re-checks the same rules (.github/actions/decrypt-secrets/validate.py), so
+a value that slips past one layer is still stopped by the other.
+"""
+import re
+
+_LABEL = r'[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?'
+HOST = rf'(?:{_LABEL}(?:\.{_LABEL})*|\[[0-9A-Fa-f:.]{{2,45}}\])'
+_PORT = r'(?::[0-9]{1,5})?'
+_PATH = r'(?:/[A-Za-z0-9._~/-]*)?'
+
+NAME_CHARS = 'letters, digits, space and . _ ( ) + , -'
+
+RULES = {
+    'appname': (re.compile(r'[A-Za-z0-9][A-Za-z0-9 ._()+,-]{0,63}'),
+                f'1-64 characters: {NAME_CHARS}; must start with a letter or digit'),
+    'compname': (re.compile(r'[A-Za-z0-9 ._()+,-]{1,64}'),
+                 f'1-64 characters: {NAME_CHARS}'),
+    'serverIP': (re.compile(HOST),
+                 'a host name or IP address only (no scheme, no port, no path)'),
+    'serverPort': (re.compile(r'[0-9]{1,5}'), 'a port number'),
+    'key': (re.compile(r'[A-Za-z0-9+/]{43}='),
+            'the 44-character public key from id_ed25519.pub'),
+    'apiServer': (re.compile(rf'(?:https?://)?{HOST}{_PORT}{_PATH}'),
+                  'http(s)://host[:port][/path]'),
+    'urlLink': (re.compile(rf'https?://{HOST}{_PORT}{_PATH}'),
+                'http(s)://host[:port][/path] (no query string)'),
+    'downloadLink': (re.compile(rf'https?://{HOST}{_PORT}{_PATH}'),
+                     'http(s)://host[:port][/path] (no query string)'),
+    'androidappid': (re.compile(r'[A-Za-z][A-Za-z0-9_]{0,40}(?:\.[A-Za-z][A-Za-z0-9_]{0,40}){1,6}'),
+                     'a Java package name such as com.example.remote'),
+}
+
+MANUAL_KEY = re.compile(r'[A-Za-z0-9][A-Za-z0-9_.-]{0,63}')
+MAX_MANUAL_CHARS = 8000
+MAX_PASSWORD_CHARS = 128
+MAX_DATA_URI_CHARS = 6 * 1024 * 1024
+
+
+def sanitize_filename(value):
+    """Upstream's rule, minus the \\s hole that let tabs/newlines through."""
+    value = (value or '').strip()
+    if not value or not value.isascii():
+        return 'rustdesk'
+    value = re.sub(r'[^A-Za-z0-9_-]', '_', value)[:64]
+    return value or 'rustdesk'
+
+
+def validate_build_fields(data):
+    """Return {field: message} for every invalid field in `data`."""
+    errors = {}
+    for field, (rx, allowed) in RULES.items():
+        value = data.get(field) or ''
+        if not isinstance(value, str):
+            errors[field] = 'Must be a string.'
+        elif value and not rx.fullmatch(value):
+            errors[field] = f'Unsupported value. Allowed: {allowed}.'
+    port = data.get('serverPort') or ''
+    if isinstance(port, str) and port.isdigit() and not 1 <= int(port) <= 65532:
+        # relay/websocket ports are derived as port+1..port+3
+        errors['serverPort'] = 'Port must be between 1 and 65532.'
+    password = data.get('permanentPassword') or ''
+    if isinstance(password, str) and len(password) > MAX_PASSWORD_CHARS:
+        errors['permanentPassword'] = f'At most {MAX_PASSWORD_CHARS} characters.'
+    for field in ('defaultManual', 'overrideManual'):
+        text = data.get(field) or ''
+        if not isinstance(text, str):
+            errors[field] = 'Must be a string.'
+            continue
+        if len(text) > MAX_MANUAL_CHARS:
+            errors[field] = f'At most {MAX_MANUAL_CHARS} characters.'
+            continue
+        for line in text.splitlines():
+            if '=' in line:
+                key = line.split('=', 1)[0].strip()
+                if not MANUAL_KEY.fullmatch(key):
+                    errors[field] = f'Invalid option name {key[:40]!r}.'
+                    break
+    for field in ('iconbase64', 'logobase64', 'privacybase64'):
+        value = data.get(field) or ''
+        if not isinstance(value, str):
+            errors[field] = 'Must be a data:image/png;base64 string.'
+        elif value and (not value.startswith('data:image/png;base64,') or len(value) > MAX_DATA_URI_CHARS):
+            errors[field] = 'Must be a data:image/png;base64 URI of at most 4 MB.'
+    return errors
