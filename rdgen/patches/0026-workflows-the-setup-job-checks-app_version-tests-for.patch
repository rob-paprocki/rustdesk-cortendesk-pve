 .github/workflows/fetch-encrypted-secrets.yml |  3 +++
 rdgenerator/tests/ghstub.py                   | 15 ++++++++++++++-
 rdgenerator/tests/test_pull.py                | 12 ++++++++++++
 rdgenerator/tests/test_workflows.py           | 18 ++++++++++++++++--
 4 files changed, 45 insertions(+), 3 deletions(-)

diff --git a/.github/workflows/fetch-encrypted-secrets.yml b/.github/workflows/fetch-encrypted-secrets.yml
index 8ef3eef..992229d 100644
--- a/.github/workflows/fetch-encrypted-secrets.yml
+++ b/.github/workflows/fetch-encrypted-secrets.yml
@@ -45,6 +45,9 @@ jobs:
               fail("rdgen protocol mismatch: update the rdgen server or this repository")
           if not re.fullmatch(r"master|[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}", inputs.get("version", "")):
               fail("version is not master or x.y.z")
+          # app_version reaches sed in "Set custom app version" (every build job needs this job)
+          if not re.fullmatch(r"(?:[0-9]{1,4}(?:\.[0-9]{1,4}){2,3})?", inputs.get("app_version") or ""):
+              fail("app_version is not x.y.z or x.y.z.w")
           cfg = inputs.get("cfg", "")
           if not cfg or len(cfg) > 65535:
               fail("cfg input missing or too large")
diff --git a/rdgenerator/tests/ghstub.py b/rdgenerator/tests/ghstub.py
index f380b92..b99a876 100644
--- a/rdgenerator/tests/ghstub.py
+++ b/rdgenerator/tests/ghstub.py
@@ -14,12 +14,24 @@ import json
 import re
 import threading
 import zipfile
+from pathlib import Path
 from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
 from urllib.parse import parse_qs, urlparse
 
 WORKFLOW_INPUTS = {'version', 'cfg', 'build_uuid', 'proto'}
 # optional inputs a workflow declares on top (GitHub rejects anything undeclared)
 OPTIONAL_INPUTS = {'generator-macos.yml': {'mac_arch'}, 'generator-linux.yml': {'linux_arch', 'linux_formats'}}
+WORKFLOWS_DIR = Path(__file__).resolve().parents[2] / '.github' / 'workflows'
+
+
+def declared_inputs(workflow):
+    """The workflow_dispatch inputs this tree's workflow declares (what GitHub accepts), or None."""
+    try:
+        text = (WORKFLOWS_DIR / workflow).read_text(encoding='utf-8')
+    except OSError:
+        return None
+    m = re.search(r'^  workflow_dispatch:\n    inputs:\n((?:      .*\n|[ \t]*\n)+)', text, re.M)
+    return set(re.findall(r'^      ([A-Za-z0-9_-]+):\s*$', m.group(1), re.M)) if m else None
 INPUTS_MAX = 65535
 
 
@@ -202,7 +214,8 @@ class GitHubStub:
                 inputs = (body or {}).get('inputs') or {}
                 if (body or {}).get('ref') != self.branch:
                     return 422, {'message': 'No ref found'}, None
-                extra = set(inputs) - WORKFLOW_INPUTS - OPTIONAL_INPUTS.get(m.group(1), set())
+                allowed = declared_inputs(m.group(1)) or (WORKFLOW_INPUTS | OPTIONAL_INPUTS.get(m.group(1), set()))
+                extra = set(inputs) - allowed
                 if extra:
                     return 422, {'message': 'Unexpected inputs provided: ' + ','.join(sorted(extra))}, None
                 if WORKFLOW_INPUTS - set(inputs):
diff --git a/rdgenerator/tests/test_pull.py b/rdgenerator/tests/test_pull.py
