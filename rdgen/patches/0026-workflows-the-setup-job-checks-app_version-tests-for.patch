+    def test_app_version_checked_before_any_build_job(self):
+        # a dispatch input, outside the encrypted config: the setup job (which every build job needs) checks it,
+        # because "Set custom app version" pastes it into sed, whose e flag runs commands
+        u = str(uuid.uuid4())
+        for good in ('1.5.0', '1.5.0.12', ''):
