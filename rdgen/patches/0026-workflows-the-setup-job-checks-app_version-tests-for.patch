--- a/rdgenerator/tests/test_pull.py
+++ b/rdgenerator/tests/test_pull.py
@@ -120,6 +120,18 @@ class DispatchTests(StubTestCase):
         # ciphertext only: the plaintext password is nowhere in the request
         self.assertNotIn('hunter2', json.dumps(req['body']))
 
+    def test_app_version_goes_out_only_when_set(self):
+        r = self.generate(app_version='1.5.0.3')
+        self.assertEqual(r.status_code, 200, r.content)
+        self.assertEqual(self.dispatched_inputs()['app_version'], '1.5.0.3')
+        r = self.generate()
+        self.assertEqual(r.status_code, 200, r.content)
+        self.assertNotIn('app_version', self.dispatched_inputs())
+        for bad in ('1.5', '1.5.0;id', '1.5.0|e id'):
+            r = self.generate(app_version=bad)
+            self.assertEqual(r.status_code, 400, bad)
+            self.assertIn('app_version', r.json()['details'])
+
     def test_dispatched_config_passes_the_runner_check(self):
         # The runner's decrypt step refuses unknown and missing keys (validate.py), so every key the server
         # puts into secrets.json must be known there. Upstream's update_public_key (2026-10-17) was not: every
