+"""A tiny stand-in for api.github.com, used by the tests and for manual runs.
+
+It implements just the endpoints rdgen and rdgen-github-bootstrap call,
+checks the bearer token, records every request, and serves artifact zips
+through a 302 to a second "blob" port, like GitHub does. The blob server
+records whether an Authorization header reached it (it must not).
+
+Manual use:
+    python -m rdgenerator.tests.ghstub --token T --owner me --repo rdgen-build
+"""
+import base64
+import io
+import json
+import re
+import threading
+import zipfile
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from urllib.parse import parse_qs, urlparse
+
+WORKFLOW_INPUTS = {'version', 'cfg', 'build_uuid', 'proto'}
+INPUTS_MAX = 65535
+
+
+def make_zip(files):
+    buf = io.BytesIO()
+    with zipfile.ZipFile(buf, 'w', compression=zipfile.ZIP_STORED) as zf:
+        for name, data in files.items():
+            zf.writestr(name, data)
+    return buf.getvalue()
+
+
+class GitHubStub:
+    def __init__(self, token='ghp_stub_token_0123456789', owner='me', repo='rdgen-build', branch='master'):
+        self.token, self.owner, self.repo, self.branch = token, owner, repo, branch
+        self.lock = threading.Lock()
+        self.requests = []
+        self.blob_requests = []
+        self.runs = {}
+        self.artifacts = {}
+        self.next_run = 1000
+        self.next_artifact = 5000
+        # Called with the run dict right after a dispatch; returns a list of
+        # (artifact_name, {filename: bytes}) that the run will upload.
+        self.artifacts_for = lambda run: []
+        self.polls_to_complete = 2
+        self.conclusion = 'success'
+        self.return_run_details = True
+        # bootstrap bits
+        self.repo_exists = False
+        self.repo_private = True
+        self.secrets = {}
+        self.actions_enabled = False
+        self.pubkey = None
+        self.privkey = None
+        # bare git repo standing in for the GitHub repo; /actions/workflows
+        # lists .github/workflows of its default branch
+        self.workflow_source = None
+        # like GitHub: the first branch pushed to an empty repository becomes the default, and the repo endpoint
+        # reports the old default for this many more reads after that
+        self.default_lag = 0
+        self._lag_left = 0
+        # a second, Actions-only token (rdgen's runtime token); the main token then answers this status for
+        # Actions reads, like a fine-grained install token without "Actions: read"
+        self.runtime_token = None
+        self.install_actions_status = None
+        # GitHub sometimes keeps a branch's workflows unregistered until a later push makes it read them again
+        self.stale_registration = False
+        self._stale_head = None
+
+    # ---------------------------------------------------------------
+    def start(self):
+        stub = self
+
+        class Api(BaseHTTPRequestHandler):
+            def log_message(self, *a):
+                pass
+
+            def _reply(self, code, body=None, headers=None):
+                data = b'' if body is None else json.dumps(body).encode()
+                self.send_response(code)
+                for k, v in (headers or {}).items():
+                    self.send_header(k, v)
+                if body is not None:
+                    self.send_header('Content-Type', 'application/json')
+                self.send_header('Content-Length', str(len(data)))
+                self.end_headers()
+                self.wfile.write(data)
+
+            def _handle(self, method):
+                url = urlparse(self.path)
+                length = int(self.headers.get('Content-Length') or 0)
+                raw = self.rfile.read(length) if length else b''
+                try:
+                    body = json.loads(raw) if raw else None
+                except ValueError:
+                    body = None
+                auth = self.headers.get('Authorization', '')
+                token = auth[len('Bearer '):] if auth.startswith('Bearer ') else ''
+                rec = {'method': method, 'path': url.path, 'query': parse_qs(url.query),
+                       'auth_ok': bool(token) and token in (stub.token, stub.runtime_token),
+                       'runtime': bool(stub.runtime_token) and token == stub.runtime_token,
+                       'api_version': self.headers.get('X-GitHub-Api-Version'),
+                       'body': body, 'raw_len': len(raw)}
+                with stub.lock:
+                    stub.requests.append(rec)
+                if not rec['auth_ok']:
+                    return self._reply(401, {'message': 'Bad credentials'})
+                code, payload, headers = stub.route(method, url.path, parse_qs(url.query), body, rec['runtime'])
+                return self._reply(code, payload, headers)
+
+            def do_GET(self):
+                self._handle('GET')
+
+            def do_POST(self):
+                self._handle('POST')
+
+            def do_PUT(self):
+                self._handle('PUT')
+
+            def do_DELETE(self):
+                self._handle('DELETE')
+
+        class Blob(BaseHTTPRequestHandler):
+            def log_message(self, *a):
+                pass
+
+            def do_GET(self):
+                url = urlparse(self.path)
+                m = re.fullmatch(r'/blob/(\d+)', url.path)
+                with stub.lock:
+                    stub.blob_requests.append({'path': url.path, 'auth_present': 'Authorization' in self.headers})
+                    art = stub.artifacts.get(int(m.group(1))) if m else None
+                if not art or art['deleted']:
+                    self.send_response(404)
+                    self.end_headers()
+                    return
+                data = art['zip']
+                self.send_response(200)
+                self.send_header('Content-Type', 'application/zip')
+                self.send_header('Content-Length', str(len(data)))
+                self.end_headers()
+                self.wfile.write(data)
+
+        self.api_server = ThreadingHTTPServer(('127.0.0.1', 0), Api)
+        self.blob_server = ThreadingHTTPServer(('127.0.0.1', 0), Blob)
+        for srv in (self.api_server, self.blob_server):
+            threading.Thread(target=srv.serve_forever, daemon=True).start()
+        self.api_url = f'http://127.0.0.1:{self.api_server.server_address[1]}'
+        self.blob_url = f'http://127.0.0.1:{self.blob_server.server_address[1]}'
+        return self
+
+    def stop(self):
+        for srv in (self.api_server, self.blob_server):
+            srv.shutdown()
+            srv.server_close()
+
+    # ---------------------------------------------------------------
+    def add_artifact(self, run_id, name, files):
+        aid = self.next_artifact
+        self.next_artifact += 1
+        data = files if isinstance(files, bytes) else make_zip(files)
+        self.artifacts[aid] = {'id': aid, 'name': name, 'run_id': run_id, 'zip': data,
+                               'size_in_bytes': len(data), 'deleted': False, 'expired': False}
+        return aid
+
+    def _run_json(self, run):
+        return {'id': run['id'], 'status': run['status'], 'conclusion': run['conclusion'],
+                'display_title': run['display_title'], 'event': 'workflow_dispatch',
+                'path': f".github/workflows/{run['workflow']}",
+                'html_url': f"https://github.com/{self.owner}/{self.repo}/actions/runs/{run['id']}",
+                'created_at': '2026-09-30T00:00:00Z'}
+
+    def _head(self, branch):
+        if not self.workflow_source:
+            return ''
+        import subprocess
+        return subprocess.run(['git', '--git-dir', self.workflow_source, 'rev-parse', '-q', '--verify',
+                               f'refs/heads/{branch}'], capture_output=True, text=True).stdout.strip()
+
+    def _default_branch(self):
+        if self.workflow_source:
+            import subprocess
+            heads = subprocess.run(['git', '--git-dir', self.workflow_source, 'for-each-ref', '--format=%(refname:short)',
+                                    'refs/heads/'], capture_output=True, text=True).stdout.split()
+            if heads and self.branch not in heads:
+                self.branch, self._lag_left, old = heads[0], self.default_lag, self.branch
+                if self._lag_left:
+                    self._stale = old
+        if self._lag_left:
+            self._lag_left -= 1
+            return self._stale
+        return self.branch
+
+    def route(self, method, path, query, body, runtime=False):
+        repo = f'/repos/{self.owner}/{self.repo}'
+        with self.lock:
+            m = re.fullmatch(repo + r'/actions/workflows/([\w.-]+)/dispatches', path)
+            if m and method == 'POST':
+                inputs = (body or {}).get('inputs') or {}
+                if (body or {}).get('ref') != self.branch:
+                    return 422, {'message': 'No ref found'}, None
+                if set(inputs) - WORKFLOW_INPUTS:
+                    return 422, {'message': 'Unexpected inputs provided: ' + ','.join(sorted(set(inputs) - WORKFLOW_INPUTS))}, None
+                if WORKFLOW_INPUTS - set(inputs):
+                    return 422, {'message': 'Required input missing'}, None
+                if len(json.dumps(inputs, separators=(',', ':'))) > INPUTS_MAX:
+                    return 422, {'message': 'inputs are too large'}, None
+                rid = self.next_run
+                self.next_run += 1
+                run = {'id': rid, 'workflow': m.group(1), 'inputs': inputs, 'status': 'queued', 'conclusion': None,
+                       'polls': 0, 'deleted': False, 'cancelled': False,
+                       'display_title': f"Custom Client Generator {inputs.get('build_uuid', '')}"}
+                self.runs[rid] = run
+                run['planned'] = list(self.artifacts_for(run))
+                if not self.return_run_details or not body.get('return_run_details'):
+                    return 204, None, None
+                return 200, {'workflow_run_id': rid, 'run_url': f'{self.api_url}{repo}/actions/runs/{rid}',
+                             'html_url': f'https://github.com/{self.owner}/{self.repo}/actions/runs/{rid}'}, None
+            m = re.fullmatch(repo + r'/actions/runs/(\d+)', path)
+            if m:
+                run = self.runs.get(int(m.group(1)))
+                if not run or run['deleted']:
+                    return 404, {'message': 'Not Found'}, None
+                if method == 'GET':
+                    run['polls'] += 1
+                    if run['status'] != 'completed':
+                        if run['polls'] >= self.polls_to_complete:
+                            run['status'], run['conclusion'] = 'completed', self.conclusion
+                        else:
+                            run['status'] = 'in_progress'
+                        if run['planned'] and run['status'] in ('in_progress', 'completed'):
+                            for name, files in run['planned']:
+                                self.add_artifact(run['id'], name, files)
+                            run['planned'] = []
+                    return 200, self._run_json(run), None
+                if method == 'DELETE':
+                    if run['status'] != 'completed':
+                        return 403, {'message': 'Cannot delete a workflow run that is not completed'}, None
+                    run['deleted'] = True
+                    for art in self.artifacts.values():
+                        if art['run_id'] == run['id']:
+                            art['deleted'] = True
+                    return 204, None, None
+            m = re.fullmatch(repo + r'/actions/runs/(\d+)/cancel', path)
+            if m and method == 'POST':
+                run = self.runs.get(int(m.group(1)))
+                if run:
+                    run['status'], run['conclusion'], run['cancelled'] = 'completed', 'cancelled', True
+                return 202, {}, None
+            m = re.fullmatch(repo + r'/actions/runs/(\d+)/artifacts', path)
+            if m and method == 'GET':
+                rid = int(m.group(1))
+                arts = [{'id': a['id'], 'name': a['name'], 'size_in_bytes': a['size_in_bytes'], 'expired': a['expired'],
+                         'archive_download_url': f"{self.api_url}{repo}/actions/artifacts/{a['id']}/zip"}
+                        for a in self.artifacts.values() if a['run_id'] == rid and not a['deleted']]
+                return 200, {'total_count': len(arts), 'artifacts': arts}, None
+            m = re.fullmatch(repo + r'/actions/artifacts/(\d+)/zip', path)
+            if m and method == 'GET':
+                art = self.artifacts.get(int(m.group(1)))
+                if not art or art['deleted']:
+                    return 404, {'message': 'Not Found'}, None
+                return 302, None, {'Location': f"{self.blob_url}/blob/{art['id']}?sig=short-lived"}
+            m = re.fullmatch(repo + r'/actions/artifacts/(\d+)', path)
+            if m and method == 'DELETE':
+                art = self.artifacts.get(int(m.group(1)))
+                if not art or art['deleted']:
+                    return 404, {'message': 'Not Found'}, None
+                art['deleted'] = True
+                return 204, None, None
+            m = re.fullmatch(repo + r'/actions/workflows/([\w.-]+)/runs', path)
+            if m and method == 'GET':
+                runs = [self._run_json(r) for r in self.runs.values() if r['workflow'] == m.group(1) and not r['deleted']]
+                runs.reverse()
+                return 200, {'total_count': len(runs), 'workflow_runs': runs}, None
+            # ---- bootstrap endpoints ----
+            if path == '/user' and method == 'GET':
+                return 200, {'login': self.owner}, None
+            if path == repo and method == 'GET':
+                if not self.repo_exists:
+                    return 404, {'message': 'Not Found'}, None
+                return 200, {'full_name': f'{self.owner}/{self.repo}', 'private': self.repo_private,
+                             'default_branch': self._default_branch(), 'fork': False}, None
+            if path == '/user/repos' and method == 'POST':
+                if (body or {}).get('name') != self.repo:
+                    return 422, {'message': 'unexpected repo name'}, None
+                self.repo_exists, self.repo_private = True, bool(body.get('private'))
+                return 201, {'full_name': f'{self.owner}/{self.repo}', 'private': self.repo_private}, None
+            if path == repo + '/actions/secrets/public-key' and method == 'GET':
+                if self.pubkey is None:
+                    from nacl.public import PrivateKey
+                    self.privkey = PrivateKey.generate()
+                    self.pubkey = base64.b64encode(bytes(self.privkey.public_key)).decode()
+                return 200, {'key_id': 'kid-1', 'key': self.pubkey}, None
+            m = re.fullmatch(repo + r'/actions/secrets/([A-Z0-9_]+)', path)
+            if m and method == 'PUT':
+                if (body or {}).get('key_id') != 'kid-1':
+                    return 422, {'message': 'bad key_id'}, None
+                self.secrets[m.group(1)] = body['encrypted_value']
+                return 201, None, None
+            if path == repo + '/actions/permissions':
+                if method == 'GET':
+                    return 200, {'enabled': self.actions_enabled, 'allowed_actions': 'all'}, None
+                if method == 'PUT':
+                    self.actions_enabled = bool((body or {}).get('enabled'))
+                    return 204, None, None
+            if path == repo + '/contents/.github/workflows' and method == 'GET':
+                ref = (query.get('ref') or [self.branch])[0]
+                import subprocess
+                out = subprocess.run(['git', '--git-dir', self.workflow_source or '/nonexistent', 'ls-tree', '--name-only',
+                                      f'refs/heads/{ref}', '.github/workflows/'], capture_output=True, text=True)
+                if out.returncode != 0 or not out.stdout.strip():
+                    return 404, {'message': 'Not Found'}, None
+                return 200, [{'name': n.rsplit('/', 1)[-1], 'type': 'file'} for n in out.stdout.split()], None
+            if path == repo + '/actions/workflows' and method == 'GET':
+                if self.runtime_token and not runtime and self.install_actions_status:
+                    return self.install_actions_status, {'message': 'Resource not accessible by personal access token'}, None
+                names = []
+                head = self._head(self.branch)
+                if self.stale_registration and self._stale_head is None:
+                    self._stale_head = head
+                if self.stale_registration and head != self._stale_head:
+                    self.stale_registration = False   # read again after a new push, and registered from then on
+                if self.workflow_source and not self.stale_registration:
+                    import subprocess
+                    out = subprocess.run(['git', '--git-dir', self.workflow_source, 'ls-tree', '--name-only',
+                                          f'refs/heads/{self.branch}', '.github/workflows/'],
+                                         capture_output=True, text=True).stdout.split()
+                    names = [n for n in out if n.endswith('.yml')]
+                wfs = [{'id': i + 1, 'path': n, 'state': 'active'} for i, n in enumerate(names)]
+                return 200, {'total_count': len(wfs), 'workflows': wfs}, None
+        return 404, {'message': 'Not Found (stub)'}, None
+
+    def decrypt_secret(self, name):
+        from nacl.public import SealedBox
+        return SealedBox(self.privkey).decrypt(base64.b64decode(self.secrets[name])).decode()
+
+
+if __name__ == '__main__':
+    import argparse
+    import time
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--token', default='ghp_stub_token_0123456789')
+    ap.add_argument('--owner', default='me')
+    ap.add_argument('--repo', default='rdgen-build')
+    ap.add_argument('--port-file', help='write the API URL to this file')
+    ap.add_argument('--demo-filename', help='each run uploads <name>.exe/.msi as rdgen-<uuid>-build-0')
+    ns = ap.parse_args()
+    stub = GitHubStub(ns.token, ns.owner, ns.repo)
+    if ns.demo_filename:
+        fn = ns.demo_filename
+        stub.artifacts_for = lambda run: [
+            (f"rdgen-{run['inputs']['build_uuid']}-build-0", {f'{fn}.exe': b'MZ' + b'\0' * 65536, f'{fn}.msi': b'MSI' * 4096}),
+            ('encrypted-secrets-zip', {'secrets.zip': b'ciphertext'})]
+    stub.start()
+    print(stub.api_url, flush=True)
+    if ns.port_file:
+        with open(ns.port_file, 'w') as fh:
+            fh.write(stub.api_url)
+    while True:
+        time.sleep(3600)
