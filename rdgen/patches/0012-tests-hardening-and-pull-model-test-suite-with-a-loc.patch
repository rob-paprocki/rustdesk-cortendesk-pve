+"""Pull model against a local GitHub stub: dispatch payload, poller, prune."""
+import base64
+import io
+import json
+import os
+import tempfile
+import zipfile
+from datetime import timedelta
+
+import pyzipper
+from django.conf import settings
+from django.test import Client, TestCase, override_settings
+from django.utils import timezone
+from PIL import Image
+
+from rdgenerator import poller
+from rdgenerator.github import GitHub
+from rdgenerator.models import GithubRun
+from rdgenerator.tests.ghstub import GitHubStub
+
+API_TOKEN = 'tok_' + 'b' * 40
+
+
+def png_uri(size, color=(0, 120, 255, 255), noise=False):
+    img = Image.effect_noise(size, 64).convert('RGBA') if noise else Image.new('RGBA', size, color)
+    buf = io.BytesIO()
+    img.save(buf, 'PNG')
+    return 'data:image/png;base64,' + base64.b64encode(buf.getvalue()).decode()
+
+
+def decrypt_cfg(cfg):
+    with pyzipper.AESZipFile(io.BytesIO(base64.b64decode(cfg))) as zf:
+        zf.setpassword(settings.ZIP_PASSWORD.encode())
+        return {name: zf.read(name) for name in zf.namelist()}
+
+
+class StubTestCase(TestCase):
+    def setUp(self):
+        self.stub = GitHubStub().start()
+        self.tmp = tempfile.TemporaryDirectory()
+        self.override = override_settings(
+            GHUSER=self.stub.owner, REPONAME=self.stub.repo, GHBEARER=self.stub.token,
+            GITHUB_API_URL=self.stub.api_url, ARTIFACT_ROOT=self.tmp.name, RDGEN_API_TOKEN=API_TOKEN)
+        self.override.enable()
+        self.c = Client()
+        self.h = {'HTTP_AUTHORIZATION': f'Bearer {API_TOKEN}'}
+
+    def tearDown(self):
+        self.override.disable()
+        self.stub.stop()
+        self.tmp.cleanup()
+
+    def generate(self, **body):
+        body.setdefault('exename', 'acme client')
+        body.setdefault('platform', 'windows')
+        return self.c.post('/api/generate', json.dumps(body), content_type='application/json', **self.h)
+
+
+class DispatchTests(StubTestCase):
+    def test_dispatch_payload(self):
+        r = self.generate(serverIP='rd.example.com', key='OeVuKk5nlHiXp+APNn0Y3pC1Iwpwn44JGqrQCsWqmBw=',
+                          permanentPassword='hunter2-long', iconbase64=png_uri((512, 512)),
+                          logobase64=png_uri((900, 300)))
+        self.assertEqual(r.status_code, 200, r.content)
+        u = r.json()['uuid']
+        req = [x for x in self.stub.requests if x['path'].endswith('/dispatches')][-1]
+        self.assertTrue(req['auth_ok'])
+        self.assertEqual(req['path'], '/repos/me/rdgen-build/actions/workflows/generator-windows.yml/dispatches')
+        body = req['body']
+        self.assertEqual(body['ref'], 'master')
+        self.assertIs(body['return_run_details'], True)
+        inputs = body['inputs']
+        self.assertEqual(set(inputs), {'version', 'cfg', 'build_uuid', 'proto'})
+        self.assertEqual(inputs['build_uuid'], u)
+        self.assertEqual(inputs['proto'], '1')
+        self.assertLessEqual(len(json.dumps(inputs, separators=(',', ':'))), 65535)
+        members = decrypt_cfg(inputs['cfg'])
+        self.assertEqual(set(members), {'secrets.json', 'assets/icon.png', 'assets/logo.png'})
+        secrets_json = json.loads(members['secrets.json'])
+        self.assertEqual(secrets_json['uuid'], u)
+        self.assertEqual(secrets_json['server'], 'rd.example.com')
+        self.assertEqual(secrets_json['iconlink_url'], 'embedded')
+        self.assertEqual(secrets_json['privacylink_url'], 'false')
+        self.assertNotIn('genurl', secrets_json)
+        self.assertEqual(Image.open(io.BytesIO(members['assets/icon.png'])).size, (256, 256))
+        self.assertLessEqual(max(Image.open(io.BytesIO(members['assets/logo.png'])).size), 512)
+        custom = json.loads(base64.b64decode(secrets_json['custom']))
+        self.assertEqual(custom['password'], 'hunter2-long')
+        run = GithubRun.objects.get(uuid=u)
+        self.assertEqual((run.status, run.github_run_id, run.platform, run.filename), ('queued', 1000, 'windows', 'acme_client'))
+        # ciphertext only: the plaintext password is nowhere in the request
+        self.assertNotIn('hunter2', json.dumps(req['body']))
+
+    def test_oversize_images_rejected_clearly(self):
+        r = self.generate(iconbase64=png_uri((1024, 1024), noise=True), privacybase64=png_uri((800, 600), noise=True))
+        self.assertEqual(r.status_code, 413)
+        self.assertIn('65,535', r.json()['error'])
+        self.assertFalse([x for x in self.stub.requests if x['path'].endswith('/dispatches')])
+
+    def test_non_square_icon_rejected(self):
+        r = self.generate(iconbase64=png_uri((300, 200)))
+        self.assertEqual(r.status_code, 400)
+
+    def test_github_rejection_reported(self):
+        with override_settings(GHBRANCH='does-not-exist'):
+            r = self.generate()
+        self.assertEqual(r.status_code, 502)
+        self.assertIn('HTTP 422', r.json()['error'])
+        self.assertEqual(GithubRun.objects.get().status, 'failure')
+
+    def test_not_configured(self):
+        with override_settings(GHBEARER=''):
+            r = self.generate()
+        self.assertEqual(r.status_code, 503)
+
+
+class PollerTests(StubTestCase):
+    def evil_zip(self):
+        buf = io.BytesIO()
+        with zipfile.ZipFile(buf, 'w') as zf:
+            zf.writestr('../../../../tmp/rdgen-test-pwned-acme_client.exe', b'evil')
+            zf.writestr('nested/dir/acme_client-x86_64.deb', b'deb')
+            zf.writestr('notes.txt', b'x')
+            link = zipfile.ZipInfo('acme_client-link.exe')
+            link.external_attr = 0o120777 << 16
+            zf.writestr(link, '/etc/passwd')
+        return buf.getvalue()
+
+    def artifacts(self, run):
+        u = run['inputs']['build_uuid']
+        return [(f'rdgen-{u}-build-for-windows-flutter-0', {'acme_client.exe': b'MZ' + b'\0' * 1000,
+                                                            'acme_client.msi': b'MSI' * 100}),
+                ('encrypted-secrets-zip', {'secrets.zip': b'ciphertext'}),
+                (f'rdgen-{u}-odd-1', self.evil_zip())]
+
+    def poll_until_terminal(self, u, passes=6):
+        for _ in range(passes):
+            poller.poll_once()
+            build = GithubRun.objects.get(uuid=u)
+            if build.is_terminal:
+                return build
+        return build
+
+    def test_success_flow_downloads_and_deletes(self):
+        self.stub.artifacts_for = self.artifacts
+        self.stub.polls_to_complete = 3
+        u = self.generate().json()['uuid']
+        build = self.poll_until_terminal(u)
+        self.assertEqual(build.status, 'success')
+        self.assertTrue(build.run_deleted)
+        names = [f['name'] for f in build.files]
+        self.assertEqual(names, ['acme_client-x86_64.deb', 'acme_client.exe', 'acme_client.msi'])
+        self.assertEqual(sorted(os.listdir(os.path.join(self.tmp.name, u))), names)
+        self.assertFalse(os.path.exists('/tmp/rdgen-test-pwned-acme_client.exe'))
+        self.assertFalse(any(os.path.islink(os.path.join(self.tmp.name, u, n)) for n in names))
+        # nothing left on GitHub, and the token never reached the blob host
+        self.assertFalse([a for a in self.stub.artifacts.values() if not a['deleted']])
+        self.assertTrue(all(r['deleted'] for r in self.stub.runs.values()))
+        self.assertTrue(self.stub.blob_requests)
+        self.assertFalse(any(b['auth_present'] for b in self.stub.blob_requests))
+        self.assertTrue(all(x['auth_ok'] for x in self.stub.requests))
+        # the API reports and serves the files
+        st = self.c.get(f'/api/status?uuid={u}', **self.h).json()
+        self.assertTrue(st['ready'])
+        exe = [f for f in st['files'] if f['name'] == 'acme_client.exe'][0]
+        r = self.c.get(exe['url'], **self.h)
+        self.assertEqual(b''.join(r.streaming_content), b'MZ' + b'\0' * 1000)
+
+    def test_failed_run_keeps_partial_files_and_run_until_prune(self):
+        self.stub.artifacts_for = lambda run: [(f"rdgen-{run['inputs']['build_uuid']}-x-0", {'acme_client.exe': b'MZ'})]
+        self.stub.conclusion = 'failure'
+        u = self.generate().json()['uuid']
+        build = self.poll_until_terminal(u)
+        self.assertEqual(build.status, 'failure')
+        self.assertFalse(build.run_deleted)
+        self.assertEqual([f['name'] for f in build.files], ['acme_client.exe'])
+        self.assertFalse(list(self.stub.runs.values())[0]['deleted'])
+        # within the keep window nothing happens; afterwards the run goes
+        poller.prune_remote(GitHub())
+        self.assertFalse(list(self.stub.runs.values())[0]['deleted'])
+        GithubRun.objects.filter(uuid=u).update(completed_at=timezone.now() - timedelta(hours=49))
+        poller.prune_remote(GitHub())
+        self.assertTrue(list(self.stub.runs.values())[0]['deleted'])
+        self.assertTrue(GithubRun.objects.get(uuid=u).run_deleted)
+
+    def test_success_without_artifacts_is_failure(self):
+        u = self.generate().json()['uuid']
+        build = self.poll_until_terminal(u)
+        self.assertEqual(build.status, 'failure')
+        self.assertIn('no usable rdgen-', build.last_error)
+
+    def test_run_found_by_name_when_dispatch_returns_204(self):
+        self.stub.return_run_details = False
+        self.stub.artifacts_for = lambda run: [(f"rdgen-{run['inputs']['build_uuid']}-x-0", {'acme_client.exe': b'MZ'})]
+        u = self.generate().json()['uuid']
+        self.assertIsNone(GithubRun.objects.get(uuid=u).github_run_id)
+        build = self.poll_until_terminal(u)
+        self.assertEqual(build.github_run_id, 1000)
+        self.assertEqual(build.status, 'success')
+
+    def test_timeout_cancels_run(self):
+        self.stub.polls_to_complete = 99
+        u = self.generate().json()['uuid']
+        GithubRun.objects.filter(uuid=u).update(created_at=timezone.now() - timedelta(hours=7))
+        poller.poll_once()
+        build = GithubRun.objects.get(uuid=u)
+        self.assertEqual(build.status, 'timed_out')
+        self.assertTrue(list(self.stub.runs.values())[0]['cancelled'])
+
+    def test_oversized_artifact_rejected(self):
+        self.stub.artifacts_for = lambda run: [(f"rdgen-{run['inputs']['build_uuid']}-x-0", {'acme_client.exe': b'M' * 5000})]
+        u = self.generate().json()['uuid']
+        with override_settings(RDGEN_MAX_ARTIFACT_BYTES=1000):
+            build = self.poll_until_terminal(u)
+        self.assertEqual(build.status, 'failure')
+        self.assertIn('rejected', build.last_error)
+        self.assertEqual(build.files, [])
+
+    def test_bad_token_backs_off(self):
+        u = self.generate().json()['uuid']
+        with override_settings(GHBEARER='wrong-token'):
+            with self.assertRaises(Exception):
+                poller.poll_once()
+        self.assertEqual(GithubRun.objects.get(uuid=u).poll_failures, 1)
+        self.assertNotIn('wrong-token', GithubRun.objects.get(uuid=u).last_error)
+
+    def test_prune_local(self):
+        old = GithubRun.objects.create(uuid='00000000-0000-4000-8000-000000000001', status='success',
+                                       created_at=timezone.now() - timedelta(days=31), filename='a')
+        os.makedirs(os.path.join(self.tmp.name, old.uuid))
+        orphan = os.path.join(self.tmp.name, '00000000-0000-4000-8000-000000000002')
+        os.makedirs(orphan)
+        keep = os.path.join(self.tmp.name, 'not-a-uuid')
+        os.makedirs(keep)
+        self.assertEqual(poller.prune_local(), 1)
+        self.assertFalse(GithubRun.objects.filter(uuid=old.uuid).exists())
+        self.assertFalse(os.path.exists(os.path.join(self.tmp.name, old.uuid)))
+        self.assertFalse(os.path.exists(orphan))
+        self.assertTrue(os.path.exists(keep))
