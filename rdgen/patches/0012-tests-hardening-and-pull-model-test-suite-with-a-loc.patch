+import os
+import subprocess
+import sys
+import tempfile
+import uuid
+
+from django.conf import settings
+from django.contrib.auth import get_user_model
+from django.test import Client, TestCase, override_settings
+
+from rdgenerator.models import GithubRun
+from rdgenerator.validation import sanitize_filename, validate_build_fields
+
+API_TOKEN = 'tok_' + 'a' * 40
+
+
+def run_settings(env_overrides):
+    """Import settings in a clean interpreter; return (rc, stderr)."""
+    env = {k: v for k, v in os.environ.items() if k not in ('SECRET_KEY', 'ZIP_PASSWORD', 'RDGEN_ENV_FILE')}
+    env.update(env_overrides)
+    env['DJANGO_SETTINGS_MODULE'] = 'rdgen.settings'
+    code = 'import django; django.setup(); from django.conf import settings; print(settings.SECRET_KEY[:4])'
+    r = subprocess.run([sys.executable, '-c', code], cwd=settings.BASE_DIR, env=env, capture_output=True, text=True)
+    return r.returncode, r.stderr
+
+
+class SettingsTests(TestCase):
+    def test_refuses_to_start_without_secret_key(self):
+        rc, err = run_settings({'ZIP_PASSWORD': 'z' * 40})
+        self.assertNotEqual(rc, 0)
+        self.assertIn('SECRET_KEY is not set', err)
+
+    def test_refuses_published_default_secret_key(self):
+        rc, err = run_settings({'SECRET_KEY': 'django-insecure-!(t-!f#6g#sr%yfded9(xha)g+=!6craeez^cp+*&bz_7vdk61',
+                                'ZIP_PASSWORD': 'z' * 40})
+        self.assertNotEqual(rc, 0)
+        self.assertIn('published default', err)
+
+    def test_refuses_short_zip_password(self):
+        rc, err = run_settings({'SECRET_KEY': 's' * 60, 'ZIP_PASSWORD': 'insecure'})
+        self.assertNotEqual(rc, 0)
+
+    def test_env_file_values_stay_out_of_os_environ(self):
+        with tempfile.NamedTemporaryFile('w', suffix='.env', delete=False) as fh:
+            fh.write('SECRET_KEY="%s"\nexport ZIP_PASSWORD=%s\n# comment\n' % ('s' * 60, 'z' * 40))
+        try:
+            env = {'RDGEN_ENV_FILE': fh.name}
+            code = ('import os, django; django.setup(); from django.conf import settings; '
+                    'print(len(settings.ZIP_PASSWORD), "ZIP_PASSWORD" in os.environ)')
+            r = subprocess.run([sys.executable, '-c', code], cwd=settings.BASE_DIR,
+                               env={**{k: v for k, v in os.environ.items() if k not in ('SECRET_KEY', 'ZIP_PASSWORD')},
+                                    **env, 'DJANGO_SETTINGS_MODULE': 'rdgen.settings'},
+                               capture_output=True, text=True)
+            self.assertEqual(r.stdout.split(), ['40', 'False'], r.stderr)
+        finally:
+            os.unlink(fh.name)
+
+    def test_csrf_middleware_and_login_required_enabled(self):
+        self.assertIn('django.middleware.csrf.CsrfViewMiddleware', settings.MIDDLEWARE)
+        self.assertIn('django.contrib.auth.middleware.LoginRequiredMiddleware', settings.MIDDLEWARE)
+        self.assertIsNotNone(settings.DATA_UPLOAD_MAX_MEMORY_SIZE)
+
+
+@override_settings(RDGEN_API_TOKEN=API_TOKEN)
+class AccessTests(TestCase):
+    def setUp(self):
+        self.user = get_user_model().objects.create_superuser('admin', password='A-long-test-password-1')
+        self.anon = Client(enforce_csrf_checks=True)
+
+    def login(self):
+        c = Client(enforce_csrf_checks=True)
+        c.force_login(self.user)
+        return c
+
+    def test_pages_require_login(self):
+        for path in ('/', '/generator', '/check_for_file?uuid=x', '/download?uuid=x&filename=a'):
+            r = self.anon.get(path)
+            self.assertEqual(r.status_code, 302, path)
+            self.assertTrue(r['Location'].startswith('/accounts/login/'), path)
+
+    def test_login_page_is_public_and_has_csrf(self):
+        r = self.anon.get('/accounts/login/')
+        self.assertEqual(r.status_code, 200)
+        self.assertContains(r, 'csrfmiddlewaretoken')
+
+    def test_login_post_without_csrf_rejected(self):
+        r = self.anon.post('/accounts/login/', {'username': 'admin', 'password': 'A-long-test-password-1'})
