+    def test_macos_developer_id_signing_and_notarization(self):
+        with open(os.path.join(ROOT, '.github', 'workflows', 'generator-macos.yml'), encoding='utf-8') as fh:
+            text = fh.read()
+        names = re.findall(r'^\s*- name: (.+?)\s*$', text, re.M)
+        i = names.index('Create DMG')
+        self.assertEqual(names[i - 1], 'Sign the app with the Developer ID')
+        self.assertEqual(names[i + 1], 'Sign and notarize the DMG')
+        self.assertIn('codesign --force --options runtime --timestamp --deep --strict', text)
+        self.assertIn('xattr -cr "$app"', text)
+        # upstream's rcodesign pass signed every file in Contents/MacOS, custom_.txt included, and failed on it
+        self.assertNotIn('Sign macOS app bundle', names)
+        self.assertIn('Ad-hoc Sign macOS app bundle (Fallback)', names)
+        self.assertIn('rcodesign notary-submit --api-key-path', text)
+        # rcodesign's unified key holds the base64 DER, not the PEM text of the .p8 ("invalid unified api key")
+        self.assertIn("sed '/^-----/d'", text)
