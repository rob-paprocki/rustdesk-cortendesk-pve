+        # secrets reach the scripts as environment variables, never interpolated into the script text
+        for step in ('Sign the app with the Developer ID', 'Sign and notarize the DMG'):
+            body = text.split('- name: ' + step, 1)[1].split('\n      - name:', 1)[0]
+            run = body.split('run: |', 1)[1]
