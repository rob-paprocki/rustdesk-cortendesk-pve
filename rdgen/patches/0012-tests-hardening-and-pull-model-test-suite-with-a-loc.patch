+class RunnerStepsTests(SimpleTestCase):
+    """Run the setup job's decode script and decrypt.py as a runner would."""
+
+    def run_steps(self, sec, event_uuid=None, proto='1', with_icon=True):
+        tmp = tempfile.mkdtemp(prefix='rdgen-runner-')
+        self.addCleanup(shutil.rmtree, tmp, True)
+        images = {'icon.png': Image.new('RGBA', (300, 300), (0, 128, 255, 255)) if with_icon else None,
+                  'logo.png': None, 'privacy.png': None}
+        inputs, _ = buildcfg.pack(sec, images, settings.ZIP_PASSWORD, lambda cfg: {
+            'version': '1.4.9', 'cfg': cfg, 'build_uuid': event_uuid or sec['uuid'], 'proto': proto})
+        event = os.path.join(tmp, 'event.json')
+        with open(event, 'w') as fh:
+            json.dump({'inputs': inputs}, fh)
+        os.makedirs(os.path.join(tmp, 'rt'))
+        open(os.path.join(tmp, 'genv'), 'w').close()
+        env = dict(os.environ, GITHUB_EVENT_PATH=event, BUILD_UUID=event_uuid or sec['uuid'],
+                   RUNNER_TEMP=os.path.join(tmp, 'rt'), GITHUB_ENV=os.path.join(tmp, 'genv'),
+                   GITHUB_ACTION_PATH=ACTION, RDGEN_ZIP_PASSWORD=settings.ZIP_PASSWORD, RDGEN_ZIP_PATH='secrets.zip')
+        with open(os.path.join(WORKFLOWS, 'fetch-encrypted-secrets.yml'), encoding='utf-8') as fh:
+            block = re.search(r"python3 - <<'PY'\n(.*?)\n\s+PY\n", fh.read(), re.S).group(1)
+        decode = '\n'.join(line[10:] if line.startswith(' ' * 10) else line for line in block.splitlines())
+        r1 = subprocess.run([sys.executable, '-c', decode], cwd=tmp, env=env, capture_output=True, text=True)
+        if r1.returncode:
+            return r1, None, tmp
+        r2 = subprocess.run([sys.executable, os.path.join(ACTION, 'decrypt.py')], cwd=tmp, env=env,
+                            capture_output=True, text=True)
+        return r1, r2, tmp
+
