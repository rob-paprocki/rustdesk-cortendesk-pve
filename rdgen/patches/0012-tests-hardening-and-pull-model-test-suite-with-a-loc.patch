+"""rdgen-github-bootstrap init against the GitHub stub and local bare repositories."""
+import contextlib
+import importlib.machinery
+import importlib.util
+import io
+import json
+import os
+import subprocess
+import tempfile
+from pathlib import Path
+from unittest import mock
+
+from django.test import SimpleTestCase
+
+from rdgenerator.tests.ghstub import GitHubStub
+
+ROOT = Path(__file__).resolve().parents[2]
+TOKEN = 'ghp_stub_token_0123456789'
+RUNTIME = 'github_pat_runtime_stub_0123456789'
+
+
+def load_bootstrap():
+    loader = importlib.machinery.SourceFileLoader('rdgen_github_bootstrap', str(ROOT / 'tools' / 'rdgen-github-bootstrap'))
+    spec = importlib.util.spec_from_loader(loader.name, loader)
+    module = importlib.util.module_from_spec(spec)
+    loader.exec_module(module)
+    return module
+
+
+boot = load_bootstrap()
+IDENT = {'GIT_AUTHOR_NAME': 't', 'GIT_AUTHOR_EMAIL': 't@localhost', 'GIT_COMMITTER_NAME': 't',
+         'GIT_COMMITTER_EMAIL': 't@localhost', 'GIT_CONFIG_NOSYSTEM': '1', 'GIT_CONFIG_GLOBAL': os.devnull}
+
+
+def git(*args, cwd=None):
+    return subprocess.run(['git', *args], cwd=cwd, check=True, capture_output=True, text=True,
+                          env=dict(os.environ, **IDENT)).stdout.strip()
+
+
+class InitTests(SimpleTestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        base = Path(self.tmp.name)
+        self.tree, self.remote, self.seed = base / 'tree', base / 'remote.git', base / 'seed'
+        git('init', '-q', '-b', 'rdgen-build', str(self.tree))
+        (self.tree / 'tools').mkdir()
+        (self.tree / 'tools' / 'rdgen-github-bootstrap').write_text('# stand-in\n')
+        wf = self.tree / '.github' / 'workflows'
+        wf.mkdir(parents=True)
+        for name in boot.GENERATORS:
+            (wf / name).write_text('on: workflow_dispatch\n')
+        git('add', '-A', cwd=self.tree)
+        git('commit', '-qm', 'tree', cwd=self.tree)
+        self.head = git('rev-parse', 'HEAD', cwd=self.tree)
+        git('init', '-q', '--bare', str(self.remote))
+        self.env_file = base / 'rdgen.env'
+        self.env_file.write_text('ZIP_PASSWORD=' + 'a' * 48 + '\nGHBRANCH=master\n')
+        self.token_file = base / 'token'
+        self.token_file.write_text(TOKEN + '\n')
+        self.token_file.chmod(0o600)
+        self.state = base / 'state.json'
+        self.stub = GitHubStub(branch='main')
+        self.stub.repo_exists = True
+        self.stub.workflow_source = str(self.remote)
+        self.stub.start()
+        sleep = mock.patch.object(boot.time, 'sleep', lambda s: None)
+        sleep.start()
+        self.addCleanup(sleep.stop)
+
+    def tearDown(self):
+        self.stub.stop()
+        self.tmp.cleanup()
+
+    def seed_remote(self, files, commits=1):
+        git('init', '-q', '-b', 'main', str(self.seed))
+        for i in range(commits):
+            for name, body in files.items():
+                path = self.seed / name
+                path.parent.mkdir(parents=True, exist_ok=True)
+                path.write_text(body + str(i))
+            git('add', '-A', cwd=self.seed)
+            git('commit', '-qm', 'Initial commit' if i == 0 else f'edit {i}', cwd=self.seed)
+        git('push', '-q', str(self.remote), 'main', cwd=self.seed)
+        return git('rev-parse', 'HEAD', cwd=self.seed)
+
+    def init(self, *options, stdin=''):
+        argv = ['--env-file', str(self.env_file), '--owner', self.stub.owner, '--repo', self.stub.repo,
+                '--api', self.stub.api_url, '--git-url', f'file://{self.remote}', '--state', str(self.state),
+                '--token-file', str(self.token_file), *options, 'init', '--tree', str(self.tree)]
+        err, out = io.StringIO(), io.StringIO()
+        with contextlib.redirect_stderr(err), contextlib.redirect_stdout(out), \
+                mock.patch.object(boot.sys, 'stdin', io.StringIO(stdin)):
+            code = boot.main(argv)
+        return code, err.getvalue()
+
+    def remote_head(self, branch):
+        return subprocess.run(['git', '--git-dir', str(self.remote), 'rev-parse', '-q', '--verify',
+                               f'refs/heads/{branch}'], capture_output=True, text=True).stdout.strip()
+
+    def test_empty_repo_uses_the_reported_default_branch(self):
+        code, err = self.init()
+        self.assertEqual(code, 0, err)
+        self.assertEqual(self.remote_head('main'), self.head)
+        self.assertEqual(self.remote_head('master'), '')
+        self.assertEqual(json.loads(self.state.read_text())['branch'], 'main')
+        self.assertIn('set GHBRANCH=main', err)
+        self.assertEqual(self.stub.decrypt_secret('ZIP_PASSWORD'), 'a' * 48)
+
+    def test_readme_only_first_commit_is_replaced(self):
+        self.seed_remote({'README.md': '# rdgen-build\n', 'LICENSE': 'MIT\n'})
+        code, err = self.init()
+        self.assertEqual(code, 0, err)
+        self.assertIn('replacing the first commit GitHub created on main', err)
+        self.assertEqual(self.remote_head('main'), self.head)
+
+    def test_edited_readme_is_not_replaced(self):
+        before = self.seed_remote({'README.md': '# rdgen-build\n'}, commits=2)
+        code, err = self.init()
+        self.assertEqual(code, 3, err)
+        self.assertIn('not an rdgen build tree', err)
+        self.assertEqual(self.remote_head('main'), before)
+
+    def test_other_content_is_not_replaced(self):
+        before = self.seed_remote({'README.md': '# x\n', 'src/app.py': 'print(1)\n'})
+        code, err = self.init()
+        self.assertEqual(code, 3, err)
+        self.assertEqual(self.remote_head('main'), before)
+
+    def test_first_push_to_another_branch_waits_for_the_default_switch(self):
+        self.stub.default_lag = 2
+        code, err = self.init('--branch', 'master')
+        self.assertEqual(code, 0, err)
+        self.assertEqual(self.remote_head('master'), self.head)
+        self.assertEqual(json.loads(self.state.read_text())['branch'], 'master')
+
+    def test_push_to_a_branch_that_is_not_the_default_fails_clearly(self):
+        self.seed_remote({'README.md': '# x\n', 'src/app.py': 'print(1)\n'})
+        code, err = self.init('--branch', 'master')
+        self.assertEqual(code, 3, err)
+        self.assertIn("the default branch of me/rdgen-build is 'main', but the tree was pushed to 'master'", err)
+        self.assertFalse(self.state.exists())
+
+    def test_workflows_checked_with_the_runtime_token(self):
+        # a fine-grained install token without Actions: read gets 404 here; the runtime token can list them
+        self.stub.runtime_token, self.stub.install_actions_status = RUNTIME, 404
+        code, err = self.init('--runtime-token-stdin', stdin=RUNTIME + '\n')
+        self.assertEqual(code, 0, err)
+        lists = [r for r in self.stub.requests if r['path'].endswith('/actions/workflows')]
+        self.assertTrue(lists and all(r['runtime'] for r in lists))
+
+    def test_without_a_runtime_token_an_unreadable_list_is_skipped(self):
+        self.stub.runtime_token, self.stub.install_actions_status = RUNTIME, 404
+        code, err = self.init()
+        self.assertEqual(code, 0, err)
+        self.assertIn('workflow check is skipped', err)
+
+    def test_unregistered_workflows_get_an_empty_commit(self):
+        self.stub.runtime_token, self.stub.stale_registration = RUNTIME, True
+        code, err = self.init('--runtime-token-stdin', stdin=RUNTIME + '\n')
+        self.assertEqual(code, 0, err)
+        self.assertIn('pushing an empty commit', err)
+        tip = self.remote_head('main')
+        self.assertEqual(git('--git-dir', str(self.remote), 'rev-parse', tip + '^'), self.head)
+        self.assertEqual(git('--git-dir', str(self.remote), 'rev-parse', tip + '^{tree}'),
+                         git('rev-parse', 'HEAD^{tree}', cwd=self.tree))
+        self.assertEqual(json.loads(self.state.read_text())['pushed'], self.head)
+        # the next init replaces the empty commit with the tree again
+        code, err = self.init('--runtime-token-stdin', stdin=RUNTIME + '\n')
+        self.assertEqual(code, 0, err)
+        self.assertEqual(self.remote_head('main'), self.head)
+
+    def test_missing_workflow_files_reported(self):
+        git('rm', '-q', '.github/workflows/generator-macos.yml', cwd=self.tree)
+        git('commit', '-qm', 'drop one', cwd=self.tree)
+        self.stub.runtime_token = RUNTIME
+        code, err = self.init('--runtime-token-stdin', stdin=RUNTIME + '\n')
+        self.assertEqual(code, 4, err)
+        self.assertIn('lacks generator-macos.yml', err)
