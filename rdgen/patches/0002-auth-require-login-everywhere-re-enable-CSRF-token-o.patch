@@ -0,0 +1,45 @@
+import secrets
+import sys
+
+from django.contrib.auth import get_user_model, password_validation
+from django.core.exceptions import ValidationError
+from django.core.management.base import BaseCommand, CommandError
+
+
+class Command(BaseCommand):
+    help = ("Create or update the rdgen web login. The password is read from "
+            "stdin (never from argv) or generated with --generate.")
+
+    def add_arguments(self, parser):
+        parser.add_argument('--username', required=True)
+        group = parser.add_mutually_exclusive_group(required=True)
+        group.add_argument('--password-stdin', action='store_true',
+                           help='read the password from the first line of stdin')
+        group.add_argument('--generate', action='store_true',
+                           help='generate a random password and print it to stdout')
+
+    def handle(self, *args, **opts):
+        username = opts['username'].strip()
+        if not username or len(username) > 150:
+            raise CommandError('invalid username')
+        if opts['generate']:
+            password = secrets.token_urlsafe(18)
+        else:
+            password = sys.stdin.readline().rstrip('\r\n')
+            if not password:
+                raise CommandError('no password on stdin')
+        User = get_user_model()
+        user = User.objects.filter(username=username).first()
+        if user is None:
+            user = User(username=username, is_staff=True, is_superuser=True)
+        try:
+            password_validation.validate_password(password, user)
+        except ValidationError as exc:
+            raise CommandError('; '.join(exc.messages))
+        user.set_password(password)
+        user.is_active = True
+        user.save()
+        if opts['generate']:
+            self.stdout.write(password)
+        else:
+            self.stdout.write(f'password set for {username}')
