+++ b/rdgenerator/middleware.py
@@ -0,0 +1,23 @@
+import hmac
+
+from django.conf import settings
+
+
+class ApiTokenMiddleware:
+    """Accept `Authorization: Bearer <RDGEN_API_TOKEN>` on /api/*.
+
+    Only marks the request; the API views decide (see api_auth_required).
+    """
+
+    def __init__(self, get_response):
+        self.get_response = get_response
+
+    def __call__(self, request):
+        request.rdgen_api_token_ok = False
+        token = settings.RDGEN_API_TOKEN
+        header = request.META.get('HTTP_AUTHORIZATION', '')
+        if token and request.path_info.startswith('/api/') and header[:7].lower() == 'bearer ':
+            supplied = header[7:].strip().encode('utf-8', 'replace')
+            if hmac.compare_digest(supplied, token.encode('utf-8')):
+                request.rdgen_api_token_ok = True
+        return self.get_response(request)
