+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>rdgen - sign in</title>
+    <style>
+        body { font-family: system-ui, sans-serif; background: #1e1e1e; color: #e0e0e0; display: flex; min-height: 100vh; align-items: center; justify-content: center; margin: 0; }
+        form { background: #2d2d2d; padding: 28px 32px; border-radius: 8px; width: 300px; box-shadow: 0 4px 16px rgba(0,0,0,.4); }
+        h1 { font-size: 1.2em; margin: 0 0 18px; }
+        label { display: block; margin: 12px 0 4px; font-size: .9em; }
+        input[type=text], input[type=password] { width: 100%; box-sizing: border-box; padding: 8px; border-radius: 4px; border: 1px solid #555; background: #1e1e1e; color: #e0e0e0; }
+        button { margin-top: 18px; width: 100%; padding: 10px; border: 0; border-radius: 4px; background: #0095EA; color: #fff; font-weight: bold; cursor: pointer; }
+        .errorlist { color: #ff8080; padding-left: 18px; font-size: .9em; }
+    </style>
+</head>
+<body>
+    <form method="post" action="{% url 'login' %}">
+        {% csrf_token %}
+        <h1>RustDesk client generator</h1>
+        {{ form.non_field_errors }}
+        <label for="{{ form.username.id_for_label }}">Username</label>
+        {{ form.username }}
+        <label for="{{ form.password.id_for_label }}">Password</label>
+        {{ form.password }}
+        <input type="hidden" name="next" value="{{ next }}">
+        <button type="submit">Sign in</button>
+    </form>
+</body>
+</html>
