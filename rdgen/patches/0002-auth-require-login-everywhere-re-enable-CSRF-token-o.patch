+def api_auth_required(view):
+    """Allow a valid RDGEN_API_TOKEN bearer token or a logged-in session.
+
+    Unauthenticated calls get 401 JSON instead of a login redirect.
+    Session-authenticated calls must pass the normal CSRF check (the
+    X-CSRFToken header); bearer-token calls skip it, because a browser
+    never attaches that header cross-site on its own.
+    """
+    @wraps(view)
+    def wrapper(request, *args, **kwargs):
+        if getattr(request, 'rdgen_api_token_ok', False):
+            return view(request, *args, **kwargs)
+        if request.user.is_authenticated:
+            rejected = CsrfViewMiddleware(lambda r: None).process_view(request, None, (), {})
+            if rejected is not None:
+                return JsonResponse({"success": False, "error": "CSRF check failed"}, status=403)
+            return view(request, *args, **kwargs)
+        return JsonResponse(
+            {"success": False, "error": "Authentication required"},
+            status=401,
+            headers={'WWW-Authenticate': 'Bearer realm="rdgen"'},
+        )
+    return login_not_required(csrf_exempt(wrapper))
+
+
