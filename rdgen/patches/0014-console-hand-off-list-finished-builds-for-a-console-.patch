+def publish_choice(value):
+    """The effective publish choice: always 'no' while the hand-off is off."""
+    if not _settings.RDGEN_PUBLISH_DEFAULT:
+        return 'no'
+    return value if value in ('no', 'hidden', 'published') else _settings.RDGEN_PUBLISH_DEFAULT
+
+
+# Settings whose value is a credential. custom.txt is only base64-encoded inside the client, so whoever downloads
+# the client can read them, like the preset permanent password.
+SECRET_SETTINGS = ('password', 'default-connect-password', 'proxy-password', 'preset-address-book-password')
+
+
+def embeds_secret(data):
+    """True if the client would carry a password: the permanent one, or one set in the Other boxes."""
+    if data.get('permanentPassword'):
+        return True
+    for field in ('defaultManual', 'overrideManual'):
+        text = data.get(field) or ''
+        for line in (text.splitlines() if isinstance(text, str) else ()):
+            key, sep, value = line.partition('=')
+            key, value = key.strip(), value.strip()
+            if sep and value and (key in SECRET_SETTINGS or (key == 'proxy-url' and '@' in value)):
+                return True
+    return False
+
+
+def publish_problem(cleaned):
+    if publish_choice(cleaned.get('publish')) == 'published' and embeds_secret(cleaned):
+        return ('A client with a password built in (the permanent password, or a password option under Other) '
+                'cannot go on the public downloads page: anyone could download it and read the password. Choose '
+                '"hidden" (you can still publish it yourself) or remove the password.')
+    return ''
diff --git a/rdgenerator/management/commands/rdgen_publish.py b/rdgenerator/management/commands/rdgen_publish.py
new file mode 100644
index 0000000..3d30766
--- /dev/null
+++ b/rdgenerator/management/commands/rdgen_publish.py
@@ -0,0 +1,71 @@
+"""Hand finished builds to a console's client downloads list.
+
+rdgen never writes into the console itself. A job outside rdgen (in the
+RustDesk LXC: /usr/local/bin/rdgen-publish, run by root) does this:
+
+    manage.py rdgen_publish pending        JSON: builds waiting for the hand-off
+    (reads ARTIFACT_ROOT/<uuid>/<name> as the rdgen user, imports the files)
+    manage.py rdgen_publish mark <uuid> done|failed|skipped [--note TEXT]
+    manage.py rdgen_publish mark <uuid> pending   (try that build again)
+
+Only successful builds whose publish choice is hidden or published are
+listed, and only files that pass the same name checks as the downloads.
+"""
+import json
+
+from django.conf import settings
+from django.core.management.base import BaseCommand, CommandError
+
+from rdgenerator.models import GithubRun, PUBLISH_STATES
+from rdgenerator.poller import allowed_output_name, flag_publish, valid_uuid
+
+
+def pending_builds():
+    builds = []
+    if not settings.RDGEN_PUBLISH_DEFAULT:
+        return builds
+    query = (GithubRun.objects.filter(status='success', publish__in=('hidden', 'published'), publish_state='')
+             .order_by('completed_at', 'id'))
+    for run in query:
+        files = [{'name': f.get('name', ''), 'size': int(f.get('size', 0)), 'sha256': f.get('sha256', '')}
+                 for f in run.files or [] if allowed_output_name(f.get('name', ''), run.filename)]
+        builds.append({
+            'uuid': run.uuid,
+            'platform': run.platform,
+            'version': run.version,
+            'filename': run.filename,
+            'label': run.label or run.filename,
+            # a client with a password built in is never published automatically
+            'publish': 'hidden' if run.has_password else run.publish,
+            'has_password': run.has_password,
+            'completed_at': run.completed_at.isoformat() if run.completed_at else '',
+            'files': files,
+        })
+    return builds
+
+
+class Command(BaseCommand):
+    help = 'List finished builds for the client-downloads hand-off, or record its result.'
+
+    def add_arguments(self, parser):
+        sub = parser.add_subparsers(dest='action', required=True)
+        sub.add_parser('pending')
+        mark = sub.add_parser('mark')
+        mark.add_argument('uuid')
+        mark.add_argument('state', choices=['done', 'failed', 'skipped', 'pending'])
+        mark.add_argument('--note', default='')
+
+    def handle(self, *args, **opts):
+        if opts['action'] == 'pending':
+            self.stdout.write(json.dumps(pending_builds()))
+            return
+        if not valid_uuid(opts['uuid']):
+            raise CommandError('not a build uuid')
+        state = '' if opts['state'] == 'pending' else opts['state']
+        assert state in PUBLISH_STATES
+        updated = GithubRun.objects.filter(uuid=opts['uuid']).update(
+            publish_state=state, publish_note=opts['note'][:2000])
+        if not updated:
+            raise CommandError('no such build')
+        if not state:
+            flag_publish()   # the job only runs while the flag exists
