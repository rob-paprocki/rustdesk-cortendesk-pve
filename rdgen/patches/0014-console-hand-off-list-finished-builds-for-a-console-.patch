diff --git a/rdgenerator/tests/test_publish.py b/rdgenerator/tests/test_publish.py
new file mode 100644
index 0000000..0fcd342
--- /dev/null
+++ b/rdgenerator/tests/test_publish.py
@@ -0,0 +1,130 @@
+"""Hand-off of finished builds to a console's client downloads (rdgen_publish)."""
+import io
+import json
+import os
+from pathlib import Path
+
+from django.core.management import call_command
+from django.core.management.base import CommandError
+from django.test import override_settings
+
+from rdgenerator.models import GithubRun
+from rdgenerator.tests.test_pull import PollerTests, StubTestCase
+
+
+def publish_cmd(*args):
+    out = io.StringIO()
+    call_command('rdgen_publish', *args, stdout=out)
+    return out.getvalue()
+
+
+class PublishTests(StubTestCase):
+    poll_until_terminal = PollerTests.poll_until_terminal
+
+    def setUp(self):
+        super().setUp()
+        self.data = override_settings(DATA_DIR=Path(self.tmp.name), RDGEN_PUBLISH_DEFAULT='hidden',
+                                      RDGEN_PUBLISH_TARGET='CortenDesk')
+        self.data.enable()
+        self.flag = Path(self.tmp.name) / 'publish.pending'
+        self.stub.artifacts_for = lambda run: [
+            (f"rdgen-{run['inputs']['build_uuid']}-build-0", {'acme_client.exe': b'MZ' + b'\0' * 100,
+                                                              'acme_client.msi': b'MSI' * 10})]
+
+    def tearDown(self):
+        self.data.disable()
+        super().tearDown()
+
+    def build(self, **body):
+        r = self.generate(**body)
+        self.assertEqual(r.status_code, 200, r.content)
+        return self.poll_until_terminal(r.json()['uuid'])
+
+    def test_default_choice_is_recorded_and_flagged(self):
+        build = self.build(appname='Acme Support')
+        self.assertEqual((build.status, build.publish, build.label, build.has_password),
+                         ('success', 'hidden', 'Acme Support', False))
+        self.assertTrue(self.flag.exists())
+        pending = json.loads(publish_cmd('pending'))
+        self.assertEqual(len(pending), 1)
+        entry = pending[0]
+        self.assertEqual((entry['uuid'], entry['publish'], entry['label'], entry['platform']),
+                         (build.uuid, 'hidden', 'Acme Support', 'windows'))
+        self.assertEqual([f['name'] for f in entry['files']], ['acme_client.exe', 'acme_client.msi'])
+        self.assertEqual(entry['files'][0]['size'], 102)
+        self.assertEqual(len(entry['files'][0]['sha256']), 64)
+
+    def test_mark_done_then_retry(self):
+        build = self.build(publish='published')
+        publish_cmd('mark', build.uuid, 'done', '--note', 'Added to CortenDesk (published).')
+        self.assertEqual(json.loads(publish_cmd('pending')), [])
+        build.refresh_from_db()
+        self.assertEqual((build.publish_state, build.publish_note), ('done', 'Added to CortenDesk (published).'))
+        self.c.force_login(self._user())
+        page = self.c.get(f'/check_for_file?uuid={build.uuid}')
+        self.assertContains(page, 'Added to CortenDesk (published).')
+        publish_cmd('mark', build.uuid, 'pending')
+        self.assertEqual([b['uuid'] for b in json.loads(publish_cmd('pending'))], [build.uuid])
+
+    def test_mark_rejects_bad_uuid(self):
+        with self.assertRaises(CommandError):
+            publish_cmd('mark', '../../etc', 'done')
+
+    def test_no_choice_means_no_flag(self):
+        build = self.build(publish='no')
+        self.assertEqual(build.status, 'success')
+        self.assertFalse(self.flag.exists())
+        self.assertEqual(json.loads(publish_cmd('pending')), [])
+
+    def test_password_client_cannot_be_published(self):
+        r = self.generate(publish='published', permanentPassword='s3cret-pass')
+        self.assertEqual(r.status_code, 400)
+        self.assertIn('password built in', r.json()['error'])
+        self.assertFalse(GithubRun.objects.exists())
+
+    def test_password_in_other_settings_cannot_be_published(self):
+        for line in ('default-connect-password=hunter2', 'proxy-password = x', 'preset-address-book-password=pw',
+                     'proxy-url=socks5://user:pw@proxy.lan:1080'):
+            r = self.generate(publish='published', overrideManual='enable-audio=N\n' + line)
+            self.assertEqual(r.status_code, 400, line)
+        r = self.generate(publish='published', defaultManual='proxy-url=socks5://proxy.lan:1080\nproxy-password=')
+        self.assertEqual(r.status_code, 200)
+        self.assertFalse(GithubRun.objects.get(uuid=r.json()['uuid']).has_password)
+        r = self.generate(publish='hidden', defaultManual='default-connect-password=hunter2')
+        self.assertTrue(GithubRun.objects.get(uuid=r.json()['uuid']).has_password)
+
+    def test_mark_pending_sets_the_flag(self):
+        build = self.build(publish='hidden')
+        publish_cmd('mark', build.uuid, 'done')
+        self.flag.unlink()
+        publish_cmd('mark', build.uuid, 'pending')
+        self.assertTrue(self.flag.exists())
+
+    def test_password_client_is_listed_hidden(self):
+        build = self.build(publish='hidden', permanentPassword='s3cret-pass')
+        self.assertTrue(build.has_password)
+        GithubRun.objects.filter(pk=build.pk).update(publish='published')   # e.g. an old row
+        self.assertEqual(json.loads(publish_cmd('pending'))[0]['publish'], 'hidden')
+
+    def test_invalid_choice_rejected(self):
+        r = self.generate(publish='everyone')
+        self.assertEqual(r.status_code, 400)
+        self.assertIn('publish', r.json()['details'])
+
+    def test_form_offers_the_choice_only_when_enabled(self):
+        self.c.force_login(self._user())
+        page = self.c.get('/')
+        self.assertContains(page, "Add the finished files to CortenDesk")
+        with override_settings(RDGEN_PUBLISH_DEFAULT=''):
+            self.assertNotContains(self.c.get('/'), 'name="publish"')
+
+    def test_disabled_hand_off_ignores_the_choice(self):
+        with override_settings(RDGEN_PUBLISH_DEFAULT=''):
+            build = self.build(publish='published')
+            self.assertEqual(build.publish, 'no')
+            self.assertEqual(json.loads(publish_cmd('pending')), [])
+        self.assertFalse(self.flag.exists())
+
+    def _user(self):
+        from django.contrib.auth import get_user_model
+        return get_user_model().objects.create_user('tester', password='x' * 16)
