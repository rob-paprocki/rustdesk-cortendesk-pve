+def flag_publish():
+    """Tell the hand-off job (rdgen_publish) that a finished build is waiting.
+
+    The job runs outside rdgen and only starts Django when this file exists.
+    """
+    path = Path(settings.DATA_DIR) / 'publish.pending'
+    try:
+        path.touch()
+    except OSError as exc:
+        log.warning('could not create %s: %s', path, exc)
+
+
 def poll_once(gh=None):
     """One pass over all active builds. Returns the number of builds seen."""
     active = list(GithubRun.objects.exclude(status__in=TERMINAL_STATUSES))
