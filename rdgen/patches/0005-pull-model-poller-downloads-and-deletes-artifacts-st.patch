diff --git a/rdgenerator/management/commands/rdgen_poll.py b/rdgenerator/management/commands/rdgen_poll.py
new file mode 100644
index 0000000..562e1c8
--- /dev/null
+++ b/rdgenerator/management/commands/rdgen_poll.py
@@ -0,0 +1,52 @@
+import logging
+import signal
+import threading
+import time
+
+from django.conf import settings
+from django.core.management.base import BaseCommand
+
+from rdgenerator import github, poller
+
+log = logging.getLogger('rdgenerator.poller')
+
+
+class Command(BaseCommand):
+    help = ("Poll GitHub for pull-model builds: download rdgen-<uuid>-* artifacts, "
+            "delete artifacts and finished runs, and prune old builds.")
+
+    def add_arguments(self, parser):
+        parser.add_argument('--once', action='store_true', help='one polling pass, then exit')
+
+    def handle(self, *args, **opts):
+        stop = threading.Event()
+        for sig in (signal.SIGTERM, signal.SIGINT):
+            signal.signal(sig, lambda *_: stop.set())
+        interval = settings.RDGEN_POLL_INTERVAL
+        last_prune = 0.0
+        warned_unconfigured = 0.0
+        while not stop.is_set():
+            if not github.configured():
+                if time.monotonic() - warned_unconfigured > 600 or opts['once']:
+                    log.error('GitHub is not configured (GHUSER/REPONAME/GHBEARER); idling')
+                    warned_unconfigured = time.monotonic()
+                if opts['once']:
+                    return
+                stop.wait(60)
+                continue
+            delay = interval
+            try:
+                poller.poll_once()
+                if opts['once'] or time.monotonic() - last_prune > 3600:
+                    poller.prune()
+                    last_prune = time.monotonic()
+            except github.GitHubError as exc:
+                # 401/403/429: token revoked, missing permission or rate
+                # limit. Back off instead of hammering the API.
+                log.error('GitHub API error, backing off 5 minutes: %s', exc)
+                delay = 300
+            except Exception:
+                log.exception('poll pass failed')
+            if opts['once']:
+                return
+            stop.wait(delay)
diff --git a/rdgenerator/management/commands/rdgen_prune.py b/rdgenerator/management/commands/rdgen_prune.py
