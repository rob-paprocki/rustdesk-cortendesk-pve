index 0000000..37c85ef
--- /dev/null
+++ b/rdgenerator/management/commands/rdgen_prune.py
@@ -0,0 +1,21 @@
+from django.core.management.base import BaseCommand
+
+from rdgenerator import github, poller
+
+
+class Command(BaseCommand):
+    help = ("Delete local builds older than RDGEN_RETENTION_DAYS and finished runs on "
+            "GitHub (failed runs after RDGEN_FAILED_RUN_KEEP_HOURS).")
+
+    def handle(self, *args, **opts):
+        removed = poller.prune_local()
+        self.stdout.write(f'pruned {removed} local build(s)')
+        if not github.configured():
+            self.stderr.write('GitHub is not configured: skipped deleting runs on GitHub')
+            return
+        try:
+            deleted = poller.prune_remote(github.GitHub())
+        except github.GitHubError as exc:
+            self.stderr.write(f'GitHub API error: {exc}')
+            return
+        self.stdout.write(f'deleted {deleted} finished run(s) on GitHub')
diff --git a/rdgenerator/poller.py b/rdgenerator/poller.py
new file mode 100644
index 0000000..48ca33f
--- /dev/null
+++ b/rdgenerator/poller.py
@@ -0,0 +1,367 @@
+"""Pull-model poller: fetch build artifacts from GitHub, then delete them.
+
+Run by `manage.py rdgen_poll` (a supervised service). Per active build:
+
+1. GET /actions/runs/{id} (the run id comes from the dispatch response; if
+   GitHub did not return one, the run is found by its run-name, which
+   carries the build uuid).
+2. List the run's artifacts. Every artifact named rdgen-<uuid>-* is
+   downloaded as soon as it appears, even while the run is still going:
+   the API answers with a 302 to a blob URL that is valid for about a
+   minute, and requests drops the Authorization header on that cross-host
+   redirect. The zip is streamed to disk with a size cap. Only plain
+   files whose names match the build's allowlist are extracted (flattened,
+   no symlinks, no path components). Then the artifact is deleted.
+3. When the run has completed, every artifact left on it is deleted
+   (encrypted-secrets-zip, bridge files, ...). A successful run is deleted
+   too, which also removes its logs and event payload. A failed run is kept
+   for RDGEN_FAILED_RUN_KEEP_HOURS so its logs can be read, then deleted
+   by prune().
+"""
+import hashlib
+import logging
+import os
+import re
+import shutil
+import stat
+import uuid as uuid_mod
+import zipfile
+from datetime import timedelta
+from pathlib import Path, PurePosixPath
+
+from django.conf import settings
+from django.utils import timezone
+
+from .github import GitHub, GitHubError, WORKFLOWS
+from .models import GithubRun, TERMINAL_STATUSES
+
+log = logging.getLogger(__name__)
+
+OUTPUT_EXTENSIONS = ('.exe', '.msi', '.deb', '.rpm', '.pkg.tar.zst', '.AppImage',
+                     '.flatpak', '.apk', '.dmg')
+SAFE_NAME = re.compile(r'[A-Za-z0-9][A-Za-z0-9._+-]{0,200}')
+ACTIVE_GITHUB_STATES = {'queued', 'in_progress', 'waiting', 'requested', 'pending'}
+
+
+class ArtifactRejected(Exception):
+    pass
+
+
+def artifact_root():
+    root = Path(settings.ARTIFACT_ROOT)
+    root.mkdir(parents=True, exist_ok=True)
+    return root
+
+
+def valid_uuid(value):
+    try:
+        return str(uuid_mod.UUID(str(value))) == str(value)
+    except (ValueError, TypeError, AttributeError):
+        return False
+
+
+def allowed_output_name(name, filename):
+    """True for a flat file name this build is allowed to produce."""
+    if not name or not SAFE_NAME.fullmatch(name) or '..' in name:
+        return False
+    if not filename or not (name == filename or name.startswith(filename + '.') or name.startswith(filename + '-')):
+        return False
+    return any(name.endswith(ext) for ext in OUTPUT_EXTENSIONS)
+
+
+def build_dir(build):
+    if not valid_uuid(build.uuid):
+        raise ArtifactRejected('build has an invalid uuid')
+    return artifact_root() / build.uuid
+
+
+def _download_zip(gh, artifact_id, dest):
+    limit = settings.RDGEN_MAX_ARTIFACT_BYTES
+    resp = gh.request('GET', gh.repo_path(f'/actions/artifacts/{artifact_id}/zip'),
+                      ok=(200,), stream=True, timeout=(30, 900), allow_redirects=True)
+    total = 0
+    try:
+        with open(dest, 'wb') as fh:
+            for chunk in resp.iter_content(chunk_size=1024 * 1024):
+                total += len(chunk)
+                if total > limit:
+                    raise ArtifactRejected(f'artifact {artifact_id} is larger than {limit} bytes')
+                fh.write(chunk)
+    finally:
+        resp.close()
+    return total
+
+
+def _extract(zip_path, build, staging):
+    """Extract allowlisted members to `staging`; return manifest entries."""
+    limit = settings.RDGEN_MAX_ARTIFACT_BYTES
+    entries, seen, total = [], set(), 0
+    try:
+        with zipfile.ZipFile(zip_path) as zf:
+            for info in zf.infolist():
+                if info.is_dir():
+                    continue
+                mode = (info.external_attr >> 16) & 0o170000
+                if mode and mode != stat.S_IFREG:
+                    log.warning('build %s: skipping non-regular zip member', build.uuid)
+                    continue
+                name = PurePosixPath(info.filename.replace('\\', '/')).name
+                if not allowed_output_name(name, build.filename):
+                    log.info('build %s: ignoring unexpected file %r', build.uuid, name[:80])
+                    continue
+                if name in seen:
+                    raise ArtifactRejected(f'duplicate output {name}')
+                total += info.file_size
+                if total > limit:
+                    raise ArtifactRejected('artifact expands beyond the size limit')
+                digest = hashlib.sha256()
+                size = 0
+                target = staging / name
+                with zf.open(info) as src, open(target, 'wb') as dst:
+                    while True:
+                        chunk = src.read(1024 * 1024)
+                        if not chunk:
+                            break
+                        size += len(chunk)
+                        if size > info.file_size:
+                            raise ArtifactRejected('zip member larger than declared')
+                        digest.update(chunk)
+                        dst.write(chunk)
+                os.chmod(target, 0o640)
+                seen.add(name)
+                entries.append({'name': name, 'size': size, 'sha256': digest.hexdigest()})
+    except (zipfile.BadZipFile, EOFError):
+        raise ArtifactRejected('artifact is not a valid zip archive') from None
+    return entries
+
+
+def fetch_artifact(gh, build, artifact):
+    aid = artifact['id']
+    root = artifact_root()
+    token = uuid_mod.uuid4().hex[:8]
+    zip_path = root / f'.dl-{build.uuid}-{aid}-{token}.zip'
+    staging = root / f'.stage-{build.uuid}-{aid}-{token}'
+    staging.mkdir(mode=0o750)
+    try:
+        _download_zip(gh, aid, zip_path)
+        entries = _extract(zip_path, build, staging)
+        dest = build_dir(build)
+        dest.mkdir(mode=0o750, exist_ok=True)
+        for entry in entries:
+            os.replace(staging / entry['name'], dest / entry['name'])
+        return entries
+    finally:
+        zip_path.unlink(missing_ok=True)
+        shutil.rmtree(staging, ignore_errors=True)
+
+
+def delete_artifact(gh, artifact_id):
+    gh.request('DELETE', gh.repo_path(f'/actions/artifacts/{int(artifact_id)}'), ok=(204, 404))
+
+
+def delete_run(gh, run_id):
+    gh.request('DELETE', gh.repo_path(f'/actions/runs/{int(run_id)}'), ok=(204, 404))
+
+
+def list_artifacts(gh, run_id):
+    data = gh.json('GET', gh.repo_path(f'/actions/runs/{int(run_id)}/artifacts'), params={'per_page': 100})
+    items = data.get('artifacts', [])
+    if not isinstance(items, list):
+        raise GitHubError('artifact list is malformed')
+    return [a for a in items if isinstance(a, dict) and isinstance(a.get('id'), int)]
+
+
+def find_run(gh, build):
+    """Find the run for a dispatch that did not return a run id."""
+    workflow = WORKFLOWS.get(build.platform)
+    if not workflow:
+        return None
+    data = gh.json('GET', gh.repo_path(f'/actions/workflows/{workflow}/runs'),
+                   params={'event': 'workflow_dispatch', 'per_page': 30})
+    for run in data.get('workflow_runs', []) or []:
+        if isinstance(run, dict) and build.uuid in str(run.get('display_title', '')):
+            return run
+    return None
+
+
+def _merge_files(existing, new):
+    by_name = {f['name']: f for f in existing if isinstance(f, dict) and 'name' in f}
+    for f in new:
+        by_name[f['name']] = f
+    return sorted(by_name.values(), key=lambda f: f['name'])
+
+
+def sync_build(gh, build, now=None):
+    now = now or timezone.now()
+    if not build.github_run_id:
+        run = find_run(gh, build)
+        if run is None:
+            if now - build.created_at > timedelta(minutes=15):
+                build.status = 'failure'
+                build.last_error = 'The workflow run for this build was never found on GitHub.'
+                build.completed_at = now
+                build.save()
+            return
+        build.github_run_id = run['id']
+        build.html_url = str(run.get('html_url', ''))[:300]
+        build.save(update_fields=['github_run_id', 'html_url', 'updated_at'])
+
+    try:
+        run = gh.json('GET', gh.repo_path(f'/actions/runs/{int(build.github_run_id)}'))
+    except GitHubError as exc:
+        if exc.status == 404:
+            build.status = 'failure'
+            build.last_error = 'The workflow run disappeared from GitHub.'
+            build.completed_at = now
+            build.save()
+            return
+        raise
+    gh_status = run.get('status')
+    conclusion = run.get('conclusion')
+
+    # Eager download: artifacts can be fetched while other jobs still run.
+    prefix = f'rdgen-{build.uuid}-'
+    artifacts = list_artifacts(gh, build.github_run_id)
+    for art in artifacts:
+        name = art.get('name')
+        if not isinstance(name, str) or not name.startswith(prefix):
+            continue
+        if art['id'] in build.fetched_artifacts:
+            delete_artifact(gh, art['id'])  # earlier delete failed; retry
+            continue
+        if art.get('expired'):
+            continue
+        previous = build.status
+        build.status = 'downloading'
+        build.save(update_fields=['status', 'updated_at'])
+        try:
+            entries = fetch_artifact(gh, build, art)
+        except ArtifactRejected as exc:
+            build.status = previous
+            build.last_error = f'Artifact {name} rejected: {exc}'
+            build.fetched_artifacts = build.fetched_artifacts + [art['id']]
+            build.save()
+            delete_artifact(gh, art['id'])
+            continue
+        build.files = _merge_files(build.files, entries)
+        build.fetched_artifacts = build.fetched_artifacts + [art['id']]
+        build.status = previous
+        build.save()
+        delete_artifact(gh, art['id'])
+        log.info('build %s: stored %s', build.uuid, ', '.join(e['name'] for e in entries) or 'nothing')
+
+    if gh_status != 'completed':
+        if now - build.created_at > timedelta(hours=settings.RDGEN_BUILD_TIMEOUT_HOURS):
+            try:
+                gh.request('POST', gh.repo_path(f'/actions/runs/{int(build.github_run_id)}/cancel'),
+                           ok=(202, 409))
+            except GitHubError as exc:
+                log.warning('build %s: cancel failed: %s', build.uuid, exc)
+            build.status = 'timed_out'
+            build.last_error = f'Build exceeded {settings.RDGEN_BUILD_TIMEOUT_HOURS} hours and was cancelled.'
+            build.completed_at = now
+            build.save()
+            return
+        build.status = 'in_progress' if gh_status == 'in_progress' else 'queued'
+        build.save(update_fields=['status', 'updated_at'])
+        return
+
+    # Completed: remove whatever is left on the run.
+    for art in list_artifacts(gh, build.github_run_id):
+        delete_artifact(gh, art['id'])
+    build.completed_at = now
+    if conclusion == 'success' and build.files:
+        build.status = 'success'
+    elif conclusion == 'success':
+        build.status = 'failure'
+        reason = f'The run succeeded but no usable {prefix}* artifact was stored.'
+        # keep an earlier, more specific reason (e.g. "Artifact ... rejected")
+        build.last_error = f'{build.last_error} {reason}'.strip() if build.last_error else reason
+    else:
+        build.status = conclusion if conclusion in TERMINAL_STATUSES else 'failure'
+    build.save()
+    if build.status == 'success':
+        # Removes the logs and the event payload (which held the ciphertext).
+        # A failure here is retried by prune().
+        try:
+            delete_run(gh, build.github_run_id)
+            build.run_deleted = True
+            build.save(update_fields=['run_deleted', 'updated_at'])
+        except GitHubError as exc:
+            log.warning('build %s: could not delete run yet: %s', build.uuid, exc)
+
+
+def poll_once(gh=None):
+    """One pass over all active builds. Returns the number of builds seen."""
+    active = list(GithubRun.objects.exclude(status__in=TERMINAL_STATUSES))
+    if not active:
+        return 0
+    gh = gh or GitHub()
+    for build in active:
+        try:
+            sync_build(gh, build)
+            if build.poll_failures:
+                build.poll_failures = 0
+                build.save(update_fields=['poll_failures', 'updated_at'])
+        except (GitHubError, OSError) as exc:
+            build.poll_failures += 1
+            build.last_error = str(exc)[:1000]
+            build.save(update_fields=['poll_failures', 'last_error', 'updated_at'])
+            log.warning('build %s: poll failed (%d): %s', build.uuid, build.poll_failures, exc)
+            if isinstance(exc, GitHubError) and exc.status in (401, 403, 429):
+                raise
+    return len(active)
+
+
+def prune_local(now=None):
+    """Delete builds older than RDGEN_RETENTION_DAYS and stale temp files."""
+    now = now or timezone.now()
+    root = artifact_root()
+    removed = 0
+    cutoff = now - timedelta(days=settings.RDGEN_RETENTION_DAYS)
+    for build in GithubRun.objects.filter(created_at__lt=cutoff):
+        if build.is_terminal or now - build.created_at > timedelta(days=settings.RDGEN_RETENTION_DAYS + 1):
+            if valid_uuid(build.uuid):
+                shutil.rmtree(root / build.uuid, ignore_errors=True)
+            build.delete()
+            removed += 1
+    known = set(GithubRun.objects.values_list('uuid', flat=True))
+    for entry in root.iterdir():
+        if entry.name.startswith(('.dl-', '.stage-')):
+            if now.timestamp() - entry.stat().st_mtime > 86400:
+                if entry.is_dir():
+                    shutil.rmtree(entry, ignore_errors=True)
+                else:
+                    entry.unlink(missing_ok=True)
+        elif valid_uuid(entry.name) and entry.name not in known and entry.is_dir():
+            shutil.rmtree(entry, ignore_errors=True)
+    return removed
+
+
+def prune_remote(gh, now=None):
+    """Delete finished runs on GitHub: successful ones at once (retry of a
+    failed delete), failed ones after RDGEN_FAILED_RUN_KEEP_HOURS."""
+    now = now or timezone.now()
+    keep = now - timedelta(hours=settings.RDGEN_FAILED_RUN_KEEP_HOURS)
+    base = GithubRun.objects.filter(status__in=TERMINAL_STATUSES, run_deleted=False,
+                                    github_run_id__isnull=False)
+    deleted = 0
+    for build in (base.filter(completed_at__lt=keep) | base.filter(status='success')):
+        try:
+            for art in list_artifacts(gh, build.github_run_id):
+                delete_artifact(gh, art['id'])
+            delete_run(gh, build.github_run_id)
+        except GitHubError as exc:
+            if exc.status not in (404,):
+                log.warning('build %s: could not delete run: %s', build.uuid, exc)
+                continue
+        build.run_deleted = True
+        build.save(update_fields=['run_deleted', 'updated_at'])
+        deleted += 1
+    return deleted
+
+
+def prune(gh=None, now=None):
+    removed = prune_local(now)
+    prune_remote(gh or GitHub(), now)
+    return removed
