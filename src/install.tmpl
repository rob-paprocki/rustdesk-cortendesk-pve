# ---------------------------------------------------------------- Alpine (OpenRC)
setup_alpine() {
  msg_info "Installing dependencies"
  # php84, not Alpine's default php85: CortenDesk's lockfile and upstream image target PHP 8.4
  $STD apk add --no-cache php84 php84-fpm php84-opcache php84-pdo_sqlite php84-session php84-ctype php84-dom \
    php84-fileinfo php84-iconv php84-mbstring php84-openssl php84-tokenizer php84-xml php84-curl php84-phar \
    php84-sodium php84-zip nginx su-exec curl jq openssl ca-certificates tzdata iproute2
  id rustdesk &>/dev/null || { addgroup -S rustdesk && adduser -S -D -H -h /var/lib/rustdesk-server -s /sbin/nologin -G rustdesk rustdesk; }
  id cortendesk &>/dev/null || { addgroup -S cortendesk && adduser -S -D -H -h /var/lib/cortendesk -s /sbin/nologin -G cortendesk cortendesk; }
  msg_ok "Installed dependencies"
  install_files
  common_setup

  msg_info "Configuring services"
  for p in hbbs hbbr; do
    if [ $p = hbbs ]; then args="-c /etc/rustdesk-server/hbbs.conf" dep="need net; use dns; before rustdesk-hbbr"
    else args="-k _" dep="need net; after rustdesk-hbbs"; fi   # -k _: without it hbbr is an open relay
    cat <<EOF >/etc/init.d/rustdesk-$p
#!/sbin/openrc-run
description="RustDesk $p (marcpope/cortendesk-server)"
supervisor="supervise-daemon"
respawn_delay=5
respawn_max=0
command="/opt/rustdesk-server/$p"
command_args="$args"
command_user="rustdesk:rustdesk"
directory="/var/lib/rustdesk-server"
umask=077
rc_ulimit="-n 65535"
output_log="/var/log/rustdesk/$p.log"
error_log="/var/log/rustdesk/$p.log"
depend() { $dep; }
start_pre() {
  checkpath -d -m 0750 -o rustdesk:rustdesk /var/lib/rustdesk-server /var/log/rustdesk
  checkpath -f -m 0640 -o rustdesk:rustdesk /var/log/rustdesk/$p.log
  [ -s /var/lib/rustdesk-server/id_ed25519 ] || { eerror "missing id_ed25519"; return 1; }
}
EOF
    chmod 755 /etc/init.d/rustdesk-$p
  done
  rm -f /etc/php84/php-fpm.d/www.conf
  php_pool nginx >/etc/php84/php-fpm.d/cortendesk.conf
  php_ini >/etc/php84/conf.d/90-cortendesk.ini
  rm -f /etc/nginx/http.d/default.conf
  nginx_site >/etc/nginx/http.d/cortendesk.conf
  # scheduler every minute (as the app user) + the daily update at a random minute past 04:00
  sed -i -e '/cortendesk/d' -e '/rustdesk-update/d' /etc/crontabs/root 2>/dev/null || true
  echo "* * * * * cd /opt/cortendesk && umask 027 && su-exec cortendesk:cortendesk /usr/bin/php84 artisan schedule:run >/dev/null 2>&1" >>/etc/crontabs/root
  echo "$((RANDOM % 60)) 4 * * * /usr/local/bin/rustdesk-update >>/var/log/rustdesk-update.log 2>&1" >>/etc/crontabs/root
  for s in rustdesk-hbbs rustdesk-hbbr php-fpm84 nginx crond; do $STD rc-update add $s default; done
  $STD rc-service php-fpm84 start
  $STD rc-service nginx start
  $STD rc-service crond restart
  msg_ok "Configured services"
}

# ---------------------------------------------------------------- Debian 13 (systemd)
setup_deb_based() {
  msg_info "Installing dependencies"
  $STD apt-get install -y --no-install-recommends php8.4-fpm php8.4-cli php8.4-sqlite3 php8.4-mbstring php8.4-xml \
    php8.4-curl php8.4-zip nginx curl jq openssl ca-certificates iproute2
  id rustdesk &>/dev/null || useradd --system --user-group --home-dir /var/lib/rustdesk-server --no-create-home --shell /usr/sbin/nologin rustdesk
  id cortendesk &>/dev/null || useradd --system --user-group --home-dir /var/lib/cortendesk --no-create-home --shell /usr/sbin/nologin cortendesk
  msg_ok "Installed dependencies"
  install_files
  common_setup

  msg_info "Configuring services"
  for p in hbbs hbbr; do
    if [ $p = hbbs ]; then exec_args="-c /etc/rustdesk-server/hbbs.conf" order="Before=rustdesk-hbbr.service"
    else exec_args="-k _" order="After=rustdesk-hbbs.service"; fi
    cat <<EOF >/etc/systemd/system/rustdesk-$p.service
[Unit]
Description=RustDesk $p (marcpope/cortendesk-server)
Wants=network-online.target
After=network-online.target nss-lookup.target
$order
ConditionPathExists=/var/lib/rustdesk-server/id_ed25519

[Service]
User=rustdesk
Group=rustdesk
WorkingDirectory=/var/lib/rustdesk-server
ExecStart=/opt/rustdesk-server/$p $exec_args
UMask=0077
LimitNOFILE=65535
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
EOF
  done
  cat <<'EOF' >/etc/systemd/system/cortendesk-scheduler.service
[Unit]
Description=CortenDesk scheduler tick (schedule:run)
After=network.target php8.4-fpm.service
ConditionPathExists=/opt/cortendesk/artisan

[Service]
Type=oneshot
User=cortendesk
Group=cortendesk
UMask=0027
WorkingDirectory=/opt/cortendesk
ExecStart=/usr/bin/php8.4 /opt/cortendesk/artisan schedule:run --no-interaction
StandardOutput=null
Nice=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cortendesk /opt/cortendesk/bootstrap/cache
EOF
  cat <<'EOF' >/etc/systemd/system/cortendesk-scheduler.timer
[Unit]
Description=Run the CortenDesk scheduler every minute

[Timer]
OnCalendar=*-*-* *:*:00
AccuracySec=1s

[Install]
WantedBy=timers.target
EOF
  cat <<'EOF' >/etc/systemd/system/rustdesk-update.service
[Unit]
Description=Update RustDesk server, CortenDesk and rdgen
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/rustdesk-update
EOF
  cat <<'EOF' >/etc/systemd/system/rustdesk-update.timer
[Unit]
Description=Daily RustDesk update check

[Timer]
OnCalendar=*-*-* 04:00
RandomizedDelaySec=30m
Persistent=true

[Install]
WantedBy=timers.target
EOF
  rm -f /etc/php/8.4/fpm/pool.d/www.conf
  php_pool www-data >/etc/php/8.4/fpm/pool.d/cortendesk.conf
  php_ini >/etc/php/8.4/fpm/conf.d/90-cortendesk.ini
  rm -f /etc/nginx/sites-enabled/default
  nginx_site >/etc/nginx/sites-available/cortendesk
  ln -sfn /etc/nginx/sites-available/cortendesk /etc/nginx/sites-enabled/cortendesk
  systemctl daemon-reload
  $STD systemctl enable rustdesk-hbbs rustdesk-hbbr php8.4-fpm nginx
  $STD systemctl enable --now cortendesk-scheduler.timer rustdesk-update.timer
  $STD systemctl restart php8.4-fpm nginx
  msg_ok "Configured services"
}

# ---------------------------------------------------------------- shared
php_pool() {  # php_pool <nginx group>
  cat <<EOF
[cortendesk]
user = cortendesk
group = cortendesk
; a unix socket only nginx may use (a TCP FastCGI port would let any local process run PHP as cortendesk)
listen = /run/cortendesk-fpm.sock
listen.owner = cortendesk
listen.group = $1
listen.mode = 0660
pm = ondemand
pm.max_children = 6
pm.process_idle_timeout = 60s
pm.max_requests = 500
request_terminate_timeout = 120s
catch_workers_output = yes
decorate_workers_output = no
security.limit_extensions = .php
php_admin_value[memory_limit] = 256M
php_admin_value[upload_max_filesize] = 258M
php_admin_value[post_max_size] = 260M
php_admin_value[max_execution_time] = 60
EOF
}
php_ini() {
  cat <<'EOF'
; translated from upstream docker/php.ini
expose_php = Off
upload_max_filesize = 258M
post_max_size = 260M
opcache.enable = 1
opcache.enable_cli = 0
opcache.memory_consumption = 96
opcache.interned_strings_buffer = 16
opcache.max_accelerated_files = 20000
; code never changes in place: the updater restarts php-fpm after every swap
opcache.validate_timestamps = 0
realpath_cache_size = 4096K
realpath_cache_ttl = 600
EOF
}
nginx_site() {
  local v6=""
  [ -e /proc/net/if_inet6 ] && v6="    listen [::]:80 default_server;"   # hosts booted with ipv6.disable=1 have none
  cat <<'EOF' | sed "s|^__V6_LISTEN__$|$v6|"
# CortenDesk (translated from upstream docker/nginx.conf.template)
server {
    listen 80 default_server;
__V6_LISTEN__
    server_name _;
    root /opt/cortendesk/public;
    index index.php;
    charset utf-8;
    include /etc/nginx/rustdesk-clients.conf;   # rdgen clients' self-update links and share links
    client_max_body_size 260m;
    access_log off;

    # WebSocket bridge for the web client -> hbbs (21118) / hbbr (21119). Those ports trust X-Real-IP /
    # X-Forwarded-For from whoever connects, so always overwrite them with the real peer.
    location = /ws/id {
        proxy_pass http://127.0.0.1:21118/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
    location = /ws/relay {
        proxy_pass http://127.0.0.1:21119/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }
    # only the front controller executes
    location = /index.php {
        fastcgi_pass unix:/run/cortendesk-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        include fastcgi_params;
        fastcgi_hide_header X-Powered-By;
    }
    location ~ \.php$ { return 404; }
    location ~ /\.(?!well-known) { deny all; }
}
EOF
}

common_setup() {
  msg_info "Installing Composer ${COMPOSER_VERSION}"
  curl -fsSLo /tmp/composer.phar "https://getcomposer.org/download/${COMPOSER_VERSION}/composer.phar"
  echo "${COMPOSER_SHA256}  /tmp/composer.phar" | sha256sum -c - >/dev/null
  install -m 755 /tmp/composer.phar /usr/local/bin/composer && rm -f /tmp/composer.phar
  msg_ok "Installed Composer ${COMPOSER_VERSION}"

  local ip; ip=$(ip -4 -o addr show scope global | awk '{print $4}' | cut -d/ -f1 | head -1)
  install -d -m 0750 -o rustdesk -g rustdesk /var/lib/rustdesk-server /var/log/rustdesk
  install -d -m 0755 /etc/rustdesk-server /var/lib/rustdesk-update
  install -d -m 0700 /var/backups/rustdesk
  [ -f /etc/rustdesk-server/hbbs.conf ] || cat <<EOF >/etc/rustdesk-server/hbbs.conf
# hbbs settings (INI, read with -c). rustdesk-config updates relay-servers.
key=_
relay-servers=$ip:21117
EOF
  install -d -m 0750 -o root -g cortendesk /etc/cortendesk
  if [ ! -f /etc/cortendesk/cortendesk.env ]; then
    install -m 0640 -o root -g cortendesk /dev/null /etc/cortendesk/cortendesk.env
    cat <<EOF >/etc/cortendesk/cortendesk.env
APP_NAME=CortenDesk
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:$(openssl rand -base64 32)
APP_URL=http://$ip
APP_LOCALE=en
APP_MAINTENANCE_DRIVER=file
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
DB_CONNECTION=sqlite
DB_DATABASE=/var/lib/cortendesk/cortendesk.sqlite
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log
TRUSTED_PROXIES=127.0.0.1,::1
CORTENDESK_ID_SERVER=$ip:21116
CORTENDESK_RELAY_SERVER=$ip:21117
CORTENDESK_PUBLIC_KEY=
CORTENDESK_NATIVE_WEBCLIENT=true
CORTENDESK_RDGEN_URL=
CORTENDESK_DOWNLOADS_PATH=/var/lib/cortendesk/downloads
# largest installer the console's uploader accepts; PHP and nginx above allow a little more
CORTENDESK_DOWNLOADS_MAX_KB=262144
EOF
  fi
  [ -f /etc/rustdesk-update.env ] || cat <<'EOF' >/etc/rustdesk-update.env
# rustdesk-update settings. Notifications: run `rustdesk-notify setup` (Discord, Apprise, Apprise API).
NOTIFY_METHOD=none
# 1 = also notify on daily runs that find no updates
NOTIFY_UPTODATE=1
# 0 = skip a component in the daily update
UPDATE_SERVER=1
UPDATE_CORTENDESK=1
UPDATE_RDGEN=1
EOF
  chmod 600 /etc/rustdesk-update.env
}

umask 022
run_os_setup

msg_info "Installing RustDesk server (cortendesk-server)"
$STD /usr/local/bin/rustdesk-server-update --force
sed -i "s|^CORTENDESK_PUBLIC_KEY=.*|CORTENDESK_PUBLIC_KEY=$(cat /var/lib/rustdesk-server/id_ed25519.pub)|" /etc/cortendesk/cortendesk.env
msg_ok "Installed RustDesk server $(cat /var/lib/rustdesk-update/rustdesk-server)"

msg_info "Installing CortenDesk (composer, migrations)"
$STD /usr/local/bin/cortendesk-update --install
$STD /usr/local/bin/cortendesk-alerts install   # CortenDesk's own alerts -> rustdesk-notify (local relay)
msg_ok "Installed CortenDesk $(cat /opt/cortendesk/VERSION)"

msg_info "Creating the console admin"
IP=$(ip -4 -o addr show scope global | awk '{print $4}' | cut -d/ -f1 | head -1)
printf 'admin\n%s\n\n' "$(openssl rand -base64 24 | tr -d '/+=' | cut -c1-20)" | $STD /usr/local/bin/rustdesk-admin --stdin
printf '%s\nhttp://%s\nnone\n' "$IP" "$IP" | $STD /usr/local/bin/rustdesk-config --stdin
# (common.sh is sourced in a child shell: its names must not leak into the framework's shell)
bash -c '. /usr/local/lib/rustdesk-cortendesk/common.sh; creds_set "Server key" "$(cat /var/lib/rustdesk-server/id_ed25519.pub)"' 
msg_ok "Created the console admin (see ~/rustdesk-cortendesk.creds)"

motd_ssh
customize

# `update` runs locally: OS packages, restart PHP/nginx on the new binaries, then rustdesk-update
cat <<'EOF' >/usr/bin/update
#!/usr/bin/env bash
set -e
if [ -f /etc/alpine-release ]; then
  apk -U upgrade && rc-service --quiet php-fpm84 restart && rc-service --quiet nginx reload
else
  apt-get update && apt-get -y upgrade && systemctl restart php8.4-fpm && systemctl reload nginx
fi
exec /usr/local/bin/rustdesk-update "$@"
EOF
chmod +x /usr/bin/update
# `pct enter` / `pct exec` shells have no /usr/local/bin in PATH: link the tools into /usr/bin
for t in /usr/local/bin/rustdesk-* /usr/local/bin/rdgen-* /usr/local/bin/cortendesk-*; do ln -sfn "$t" /usr/bin/; done

cleanup_lxc
